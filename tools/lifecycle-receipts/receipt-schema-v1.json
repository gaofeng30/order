{
  "schema": "archived-lifecycle-receipt/v1",
  "field_section": "## Receipt fields",
  "retrospective_section": "## Retrospective",
  "fields": [
    {"name": "receipt_schema", "type": "string", "const": "archived-lifecycle-receipt/v1"},
    {"name": "change_name", "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    {"name": "archive_path", "type": "string", "pattern": "^openspec/changes/archive/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    {"name": "lifecycle_state", "type": "string", "const": "ARCHIVED"},
    {"name": "expected_historical_verdict", "type": "enum", "values": ["VERIFIED", "FAILED", "VERIFIED_SUPERSESSION"]},
    {"name": "failure_fingerprint", "type": "string", "pattern": "^[^\\r\\n]{1,256}$"},
    {"name": "subsequent_gates", "type": "enum", "values": ["PASS", "NOT_RUN"]},
    {"name": "superseded_by", "type": "sha_or_none"},
    {"name": "supersedes", "type": "sha_or_none"},
    {"name": "repo_base_sha", "type": "sha"},
    {"name": "runner_skill_git_blob", "type": "sha"},
    {"name": "runner_skill_sha256", "type": "sha256"},
    {"name": "runner_version", "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*$"},
    {"name": "candidate_sha", "type": "sha"},
    {"name": "integrated_sha", "type": "sha"},
    {"name": "integration_validation", "type": "enum", "values": ["PASS", "NOT_RUN"]},
    {"name": "archive_sha", "type": "sha"},
    {"name": "archive_validation", "type": "enum", "values": ["PASS", "NOT_RUN"]},
    {"name": "owned_paths_json", "type": "json_string_array", "min_items": 1},
    {"name": "profile_id", "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"},
    {"name": "profile_binding_sha256", "type": "sha256"},
    {"name": "recorded_attestation_trust", "type": "string", "const": "UNTRUSTED_FOR_MECHANICAL_PASS"},
    {"name": "recorded_attestation_json", "type": "json_object"},
    {"name": "mechanical_verification", "type": "string", "const": "REQUIRED_DERIVED"},
    {"name": "product_trees_json", "type": "json_sha_map"},
    {"name": "candidate_checkpoint_sha256", "type": "sha256"},
    {"name": "candidate_tasks_sha256", "type": "sha256"},
    {"name": "candidate_open_tasks_json", "type": "json_string_array"},
    {"name": "post_candidate_tasks_json", "type": "json_task_results"},
    {"name": "receipt_head_verification", "type": "string", "const": "REQUIRED_DERIVED"},
    {"name": "observation_counts_json", "type": "json_observation_counts"},
    {"name": "draft_screen_decisions_json", "type": "json_string_array"},
    {"name": "retrospective_json", "type": "json_string_array", "min_items": 1},
    {"name": "unverified_boundaries_json", "type": "json_string_array"}
  ]
}
