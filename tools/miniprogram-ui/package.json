    "serialize-javascript": "7.0.7"
  },
  "devDependencies": {
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-mocha": "2.0.1",
    "karma-webpack": "5.0.1",
    "miniprogram-automator": "0.12.1",
    "miniprogram-simulate": "1.6.2",
    "mocha": "11.8.0",
    "playwright": "1.62.1",
    "webpack": "5.109.2"
  }
