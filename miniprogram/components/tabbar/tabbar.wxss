:host { display: block; }
.tabbar {
  flex: 0 0 auto; display: flex; background: rgba(255, 255, 255, .98);
  border-top: 1rpx solid var(--line); padding: 12rpx 16rpx 0;
}
.tab {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; padding: 10rpx 0;
}
.tab-ico { position: relative; width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; }
.tab-label { font-size: 21rpx; font-weight: 600; }
.badge {
  position: absolute; top: -8rpx; right: -16rpx; background: #d2483a; color: #fff;
  font-size: 18rpx; min-width: 30rpx; height: 30rpx; padding: 0 8rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center; line-height: 1;
}
