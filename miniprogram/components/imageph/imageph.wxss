.imgph {
  position: relative; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.ph-img { width: 100%; height: 100%; display: block; }
.ph-char {
  font-family: var(--font-head); color: rgba(255, 255, 255, .92); font-weight: 700; line-height: 1;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .18);
}
.ph-tag {
  position: absolute; right: 14rpx; bottom: 12rpx; font-size: 18rpx; letter-spacing: 2rpx;
  color: rgba(255, 255, 255, .7); background: rgba(0, 0, 0, .18); padding: 4rpx 12rpx; border-radius: 12rpx;
}
