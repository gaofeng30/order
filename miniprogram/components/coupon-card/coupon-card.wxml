<view class="cc {{dim ? 'dim' : ''}} {{picked ? 'picked' : ''}} {{attached ? 'attached' : ''}}" bindtap="tap">
  <!-- 面额区 -->
  <view class="cc-face">
    <text class="cc-amt serif">{{face}}</text>
    <text class="cc-cond">{{cond}}</text>
  </view>
  <view class="cc-notch top" style="background:{{notch}}"></view>
  <view wx:if="{{!attached}}" class="cc-notch bottom" style="background:{{notch}}"></view>
  <view class="cc-dash"></view>

  <!-- 信息区 -->
  <view class="cc-body">
    <view class="cc-head">
      <text class="cc-name">{{name}}</text>
      <view wx:if="{{badge}}" class="pill pill--{{badgeTone}} cc-badge">{{badge}}</view>
    </view>
    <view class="cc-scope">{{scope}}</view>
    <view class="cc-period tnum">{{period}}</view>
    <view wx:if="{{tags.length}}" class="cc-tags">
      <text wx:for="{{tags}}" wx:key="*this" class="cc-tag">{{item}}</text>
    </view>
    <view wx:if="{{reason}}" class="cc-reason">{{reason}}</view>
  </view>

  <!-- 选中标记 -->
  <view wx:if="{{showPick}}" class="cc-pick {{picked ? 'on' : ''}}">
    <icon wx:if="{{picked}}" name="check" size="14" color="#ffffff" />
  </view>
</view>
