.pill {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.pill-success {
  background: rgba(4, 120, 87, 0.12);
  color: #047857;
}

.pill-accent {
  background: rgba(29, 78, 216, 0.1);
  color: #1d4ed8;
}

.pill-warning {
  background: rgba(15, 23, 42, 0.08);
  color: #475569;
}

.pill-danger {
  background: rgba(15, 23, 42, 0.1);
  color: #334155;
}

.pill-dark {
  background: #0f172a;
  color: #f8fafc;
}
