<view class="page">
  <navbar tone="light" title="营业设置" back />

  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="sec-h"><text class="t" style="font-size:30rpx">营业状态</text></view>
    <view class="biz-switch">
      <view
        wx:for="{{biz}}"
        wx:key="*this"
        class="biz-seg"
        data-b="{{item}}"
        bindtap="setBiz"
        style="{{storeStatus === item ? 'background:' + (item === '营业中' ? '#3d6b2f' : (item === '已截单' ? '#8a8f7c' : '#c98b3a')) + ';color:#fff' : 'color:var(--ink-2)'}}"
      >{{item}}</view>
    </view>

    <view class="card set-list">
      <view class="set-row" data-k="time" bindtap="pick">
        <text class="set-label">营业时间</text>
        <text class="set-val">09:00 - 17:00</text>
        <icon name="chevron" size="17" color="#8f9384" />
      </view>
      <view class="set-row" data-k="cutoff" bindtap="pick">
        <text class="set-label">截单时间</text>
        <text class="set-val">16:30</text>
        <icon name="chevron" size="17" color="#8f9384" />
      </view>
      <view class="set-row last" data-k="pickup" bindtap="pick">
        <view class="set-l"><text class="set-label">取餐地点</text><view class="set-sub">{{store.addr}}</view></view>
        <text class="set-val">县前直营店</text>
        <icon name="chevron" size="17" color="#8f9384" />
      </view>
    </view>

    <view class="card notice-card">
      <view class="notice-lbl">门店公告 <text class="faint">（展示在用户端首页）</text></view>
      <textarea class="notice-in" value="{{notice}}" bindinput="onNotice" maxlength="-1" />
    </view>
    <view style="height:24rpx"></view>
  </scroll-view>

  <view class="bottom-bar" style="padding-bottom:{{safeBottom + 20}}px">
    <view class="btn btn--blue btn--block" bindtap="save">保存设置</view>
  </view>

  <toast id="toast" />
</view>
