.biz-switch { display: flex; gap: 16rpx; background: #fff; padding: 10rpx; border-radius: 28rpx; box-shadow: var(--sh-card); }
.biz-seg { flex: 1; text-align: center; padding: 22rpx 0; border-radius: 20rpx; font-size: 28rpx; font-weight: 600; }

.set-list { padding: 4rpx 36rpx; margin-top: 32rpx; }
.set-row { display: flex; align-items: center; gap: 16rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--line-2); }
.set-row.last { border-bottom: none; }
.set-l { flex: 1; min-width: 0; }
.set-label { font-size: 29rpx; color: var(--ink); }
.set-sub { font-size: 23rpx; color: var(--ink-3); margin-top: 6rpx; }
.set-row .set-label { flex: 1; }
.set-row.last .set-label { flex: none; }
.set-val { font-size: 27rpx; color: var(--ink-2); }

.notice-card { padding: 32rpx 36rpx; margin-top: 24rpx; }
.notice-lbl { font-size: 27rpx; color: var(--ink-2); margin-bottom: 20rpx; }
.notice-in {
  width: 100%; min-height: 150rpx; border: 1rpx solid var(--line); border-radius: 24rpx; padding: 24rpx;
  font-size: 28rpx; color: var(--ink); box-sizing: border-box;
}

.bottom-bar { flex: 0 0 auto; padding: 20rpx 32rpx; border-top: 1rpx solid var(--line); }
