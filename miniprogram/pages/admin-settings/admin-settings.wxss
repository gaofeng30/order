.settings-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.status {
  height: 84rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  border-radius: 999rpx;
  background: #fafafa;
  color: #475569;
  font-size: 26rpx;
  font-weight: 600;
}

.status-active {
  border-color: #1d4ed8;
  color: #1d4ed8;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 30rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
}
