.pickup-card { padding: 32rpx 36rpx; color: #fff; margin-top: 8rpx; }
.pickup-top { display: flex; align-items: center; position: relative; z-index: 2; }
.pickup-cut { font-size: 23rpx; color: var(--ink-on-dark-2); margin-left: auto; }
.pickup-name { font-size: 34rpx; font-weight: 700; margin-top: 22rpx; position: relative; z-index: 2; }
.pickup-line { font-size: 25rpx; color: var(--ink-on-dark-2); margin-top: 12rpx; display: flex; align-items: center; gap: 12rpx; position: relative; z-index: 2; }
.pickup-line.blue { color: #9fd3ff; }

.sec-card { padding: 4rpx 36rpx; margin-top: 24rpx; }
.order-item { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--line-2); }
.order-item-info { flex: 1; }
.order-item-name { font-size: 28rpx; color: var(--ink); font-weight: 500; }
.order-item-unit { font-size: 23rpx; color: var(--ink-3); margin-top: 4rpx; }

.field { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid var(--line-2); }
.field.last { border-bottom: none; }
.field-lbl { font-size: 27rpx; color: var(--ink-2); width: 120rpx; }
.field-in { flex: 1; font-size: 28rpx; color: var(--ink); }
.ph { color: var(--ink-3); }

.flavor-card { padding: 32rpx 36rpx; margin-top: 24rpx; }
.flavor-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.flavor-title { font-size: 30rpx; font-weight: 700; }
.flavor-head .pill { margin-left: auto; }
.flavor-chips { display: flex; flex-wrap: wrap; gap: 18rpx; }

.bottom-bar {
  flex: 0 0 auto; padding: 20rpx 32rpx; background: rgba(255, 255, 255, .98);
  border-top: 1rpx solid var(--line); display: flex; align-items: center; gap: 28rpx;
}
.pay-amount { flex: 1; }
.pay-lbl { font-size: 24rpx; color: var(--ink-3); display: block; margin-bottom: 2rpx; }
.pay-btn { min-width: 300rpx; }
