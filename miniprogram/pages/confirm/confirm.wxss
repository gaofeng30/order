.confirm {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.block {
  padding: 30rpx;
}

.block-title {
  margin-bottom: 18rpx;
  font-size: 31rpx;
  font-weight: 600;
}

.pickup-time {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(4, 120, 87, 0.12);
  color: #047857;
  font-size: 22rpx;
  font-weight: 600;
}

.items,
.form-block,
.taste-block {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.taste-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.taste-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 66rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  border-radius: 999rpx;
  background: #fafafa;
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 600;
}

.taste-chip-active {
  border-color: #1d4ed8;
  background: rgba(29, 78, 216, 0.1);
  color: #1d4ed8;
}

.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
}

.item-price {
  font-size: 28rpx;
  font-weight: 600;
}

.pay-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-radius: 32rpx;
  background: #24364a;
  color: #f8fafc;
}

.amount {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}
