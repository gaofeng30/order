<view class="page">
  <navbar tone="light" title="确认订单" back />

  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 取餐方式 -->
    <view class="hero-dark mode-card">
      <view class="ring r2"></view>
      <view class="mode-tabs">
        <view class="mode-tab {{mode === 'now' ? 'on' : ''}}" data-m="now" bindtap="setMode">
          <icon name="flame" size="15" color="{{mode === 'now' ? '#0b2f63' : 'rgba(255,255,255,.7)'}}" /><text>尽快取餐</text>
        </view>
        <view class="mode-tab {{mode === 'reserve' ? 'on' : ''}}" data-m="reserve" bindtap="setMode">
          <icon name="calendarClock" size="15" color="{{mode === 'reserve' ? '#0b2f63' : 'rgba(255,255,255,.7)'}}" /><text>预约取餐</text>
        </view>
      </view>

      <view wx:if="{{mode === 'now'}}" class="mode-now">
        <icon name="clock" size="15" color="#9fd3ff" />
        <text class="now-txt">下单后立即制作，</text>
        <text class="now-hl">预计 17:10 可取</text>
        <view class="pill pill--ondark now-cut">{{store.cutoff}}</view>
      </view>

      <view wx:else class="mode-reserve">
        <view class="rsv-label">取餐日期</view>
        <view class="rsv-dates">
          <view wx:for="{{dates}}" wx:key="k" class="rsv-date {{dateIdx === index ? 'on' : ''}}" data-idx="{{index}}" bindtap="pickDate">{{item.k}}</view>
        </view>
        <view class="rsv-label rsv-label-2">取餐时段</view>
        <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="rsv-slots-scroll">
          <view class="rsv-slots">
            <view wx:for="{{slots}}" wx:key="*this" class="rsv-slot tnum {{slot === item ? 'on' : ''}}" data-t="{{item}}" bindtap="pickSlot">{{item}}</view>
          </view>
        </scroll-view>
        <view class="rsv-warn"><icon name="warn" size="13" color="#9fd3ff" /><text>预约成功后，取餐前 {{cancelMin}} 分钟外可随时取消</text></view>
      </view>
    </view>

    <!-- 取餐窗口 -->
    <view class="card sec-card">
      <view class="sec-h win-h"><text class="t" style="font-size:30rpx">取餐窗口</text><view class="pill pill--info win-pill">到店自提</view></view>
      <view class="win-row">
        <view class="win-ico"><icon name="store" size="19" color="#467a32" /></view>
        <view class="win-info">
          <view class="win-name">{{store.pickupWindow}}</view>
          <view class="win-sub">{{store.branch}} · {{store.addr}}</view>
        </view>
      </view>
    </view>

    <!-- 商品明细 -->
    <view class="card sec-card">
      <view class="sec-h" style="padding-bottom:4rpx"><text class="t" style="font-size:30rpx">商品明细</text><text class="faint" style="font-size:23rpx">共 {{count}} 件 · 口味/备注按菜品填写</text></view>
      <view wx:for="{{items}}" wx:for-item="ci" wx:key="item.id" class="ci-item">
        <imageph item="{{ci.item}}" h="92" w="92" radius="22" tag="{{false}}" />
        <view class="ci-info">
          <view class="ci-top">
            <text class="ci-name">{{ci.item.name}}</text>
            <view class="ci-edit" data-id="{{ci.item.id}}" catchtap="editItem"><icon name="edit" size="12" color="#2a5fa6" />口味/备注</view>
          </view>
          <view class="ci-unit">¥{{ci.item.price}} × {{ci.q}}</view>
          <view wx:if="{{ci.flavors.length || ci.note}}" class="ci-prefs">
            <text wx:for="{{ci.flavors}}" wx:for-item="f" wx:key="*this" class="pref-chip">{{f}}</text>
            <text wx:if="{{ci.note}}" class="pref-note">“{{ci.note}}”</text>
          </view>
          <view wx:else class="ci-empty">未填写 · 点右上添加</view>
        </view>
        <money v="{{ci.item.price * ci.q}}" size="30" />
      </view>
    </view>

    <!-- 优惠明细：等级折扣 + 优惠券（算价链 原价 → 等级折扣 → 减券 → 应付） -->
    <view class="card sec-card promo-card">
      <view class="sec-h" style="padding-bottom:8rpx">
        <text class="t" style="font-size:30rpx">优惠</text>
        <view wx:if="{{isMember}}" class="pill pill--warn">{{calc.levelName}}</view>
        <view wx:else class="pill pill--mute">非会员 · 原价</view>
      </view>
      <view class="pm-row">
        <text class="pm-k">商品小计</text>
        <text class="pm-v tnum">¥{{calc.subtotal}}</text>
      </view>
      <view wx:if="{{calc.hasLevel}}" class="pm-row">
        <text class="pm-k">等级折扣 · {{calc.levelLabel}}</text>
        <text class="pm-v cut tnum">−¥{{calc.levelCut}}</text>
      </view>
      <view wx:if="{{isMember}}" class="pm-row cp-row" bindtap="openCoupon">
        <text class="pm-k">优惠券</text>
        <text wx:if="{{calc.coupon}}" class="pm-cp">{{calc.couponName}}</text>
        <text wx:elif="{{calc.usable.length}}" class="pm-cp none">{{calc.usable.length}} 张可用</text>
        <text wx:else class="pm-cp none">暂无可用</text>
        <text wx:if="{{calc.couponCutC}}" class="pm-v cut tnum">−¥{{calc.couponCut}}</text>
        <icon name="chevron" size="15" color="#8f9384" />
      </view>
      <view wx:else class="pm-note">会员由商户在名单中登记，登记后按微信绑定手机号自动识别，可享等级折扣与专属券。</view>
    </view>

    <!-- 联系信息 -->
    <view class="card sec-card">
      <view class="sec-h" style="padding-bottom:4rpx"><text class="t" style="font-size:30rpx">联系信息</text></view>
      <view class="field">
        <text class="field-lbl">联系人</text>
        <input class="field-in" placeholder="请填写取餐人姓名" placeholder-class="ph" data-k="contact" value="{{form.contact}}" bindinput="onInput" />
      </view>
      <view class="field last">
        <text class="field-lbl">手机号</text>
        <input class="field-in" type="number" placeholder="便于到店核对" placeholder-class="ph" data-k="phone" value="{{form.phone}}" bindinput="onInput" />
      </view>
    </view>
    <view style="height:24rpx"></view>
  </scroll-view>

  <!-- 应付 + 支付 -->
  <view class="bottom-bar" style="padding-bottom:{{safeBottom + 20}}px">
    <view class="pay-amount">
      <text class="pay-lbl">{{payLabel}}</text>
      <money v="{{calc.payable}}" size="48" />
      <text wx:if="{{calc.totalCutC}}" class="pay-cut tnum">已优惠 ¥{{calc.totalCut}}</text>
    </view>
    <view class="btn btn--primary pay-btn" bindtap="pay">{{payBtn}}</view>
  </view>

  <!-- 选券弹层 -->
  <view wx:if="{{cpVisible}}">
    <view class="sheet-mask" catchtap="closeCoupon"></view>
    <view class="sheet cp-sheet">
      <view class="cp-head">
        <text class="serif cp-title">选择优惠券</text>
        <text class="cp-rule">一单只能使用一张</text>
        <view class="cp-close" catchtap="closeCoupon"><icon name="close" size="19" color="#8f9384" /></view>
      </view>
      <scroll-view class="cp-body" scroll-y enhanced show-scrollbar="{{false}}">
        <block wx:if="{{calc.usable.length}}">
          <view class="cp-sec">可用 {{calc.usable.length}} 张</view>
          <view wx:for="{{calc.usable}}" wx:key="id" class="cp-item">
            <coupon-card
              face="{{item.face}}" cond="{{item.cond}}" name="{{item.coupon.name}}"
              scope="{{item.scope}}" period="本单可减 ¥{{item.cutText}}"
              picked="{{pickId === item.id}}" show-pick="{{true}}" notch="#ffffff"
              data-id="{{item.id}}" bind:tap="pickCoupon"
            />
          </view>
        </block>

        <view class="cp-none {{pickId === 'none' ? 'on' : ''}}" bindtap="pickNone">
          <view class="cn-main">
            <text class="cn-t">不使用优惠券</text>
            <text class="cn-s">本单仅享等级折扣</text>
          </view>
          <view class="cn-box {{pickId === 'none' ? 'on' : ''}}">
            <icon wx:if="{{pickId === 'none'}}" name="check" size="14" color="#ffffff" />
          </view>
        </view>

        <block wx:if="{{calc.unusable.length}}">
          <view class="cp-sec mt">不可用 {{calc.unusable.length}} 张</view>
          <view wx:for="{{calc.unusable}}" wx:key="id" class="cp-item">
            <coupon-card
              face="{{item.face}}" cond="{{item.cond}}" name="{{item.coupon.name}}"
              scope="{{item.scope}}" period="{{item.reason}}"
              dim="{{true}}" notch="#ffffff"
            />
          </view>
        </block>
      </scroll-view>
      <view class="cp-foot" style="padding-bottom:{{safeBottom + 24}}px">
        <view class="btn btn--primary btn--block" catchtap="confirmCoupon">确定</view>
      </view>
    </view>
  </view>

  <!-- 口味/备注 编辑弹层 -->
  <customize
    visible="{{czVisible}}"
    item="{{czItem}}"
    init="{{czInit}}"
    confirm-label="保存"
    bind:close="onCzClose"
    bind:confirm="onCzConfirm"
  />
</view>
