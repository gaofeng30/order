<view class="page page--tab home">
  <view class="hero-dark home-hero">
    <view class="row-between">
      <view class="eyebrow">SELF PICKUP</view>
      <status-pill text="{{settings.status}}" type="success" />
    </view>
    <view class="title-xl">{{settings.brand}}</view>
    <view class="hero-meta">
      <text>{{settings.pickupPlace}}</text>
      <text>{{settings.businessTime}}</text>
    </view>
    <button class="btn btn-primary hero-cta" bindtap="goMenu">立即点单</button>
  </view>

  <view class="notice card">
    <view class="notice-title">今日公告</view>
    <view class="body">{{settings.notice}}</view>
  </view>

  <view class="quick-grid">
    <button class="quick-card" bindtap="goMenu">
      <text class="quick-title">堂食自提</text>
      <text class="quick-desc">3 步完成点单</text>
    </button>
    <button class="quick-card disabled-card">
      <text class="quick-title">外卖配送</text>
      <text class="quick-desc">暂未开放</text>
    </button>
  </view>

  <section-card title="今日推荐" desc="优先展示今日可购买菜品">
    <view class="list">
      <product-card
        wx:for="{{products}}"
        wx:key="id"
        product="{{item}}"
        bind:detail="openDetail"
        bind:add="addProduct"
      />
    </view>
  </section-card>
</view>
