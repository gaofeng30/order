<view class="page">
  <navbar tone="light" title="分类管理" back />

  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="cat-note">拖动调整顺序 · 停用后该分类菜品在用户端隐藏</view>
    <view class="card cat-list">
      <view wx:for="{{cats}}" wx:key="id" class="cat-row {{index === cats.length - 1 ? 'last' : ''}}">
        <icon name="sort" size="16" color="#c8ccba" />
        <view class="cat-sort serif">{{item.sort}}</view>
        <view class="cat-main">
          <view class="cat-name">{{item.name}}</view>
          <view class="cat-count">{{item.count}} 个菜品</view>
        </view>
        <pill s="{{item.on ? '营业中' : '已下架'}}" tone="{{item.on ? 'ok' : 'mute'}}" label="{{item.on ? '启用' : '停用'}}" />
        <view class="toggle {{item.on ? 'on' : ''}}" data-id="{{item.id}}" catchtap="toggle"><view class="toggle-knob"></view></view>
      </view>
    </view>

    <view class="add-cat-btn" bindtap="newCat">
      <icon name="plus" size="18" color="#2a5fa6" /><text>新增分类</text>
    </view>

    <view style="height:{{safeBottom + 30}}px"></view>
  </scroll-view>

  <!-- 新增分类弹层 -->
  <view wx:if="{{showAdd}}" class="modal-mask" catchtap="closeAdd"></view>
  <view wx:if="{{showAdd}}" class="modal-card">
    <view class="modal-title serif">新增分类</view>
    <view class="modal-sub">新分类默认启用，排在末位</view>
    <input class="modal-input" value="{{newName}}" bindinput="onAddInput" maxlength="12"
      placeholder="输入分类名称，如「节庆礼盒」" placeholder-class="modal-input-ph" confirm-type="done" />
    <view class="modal-actions">
      <view class="btn modal-btn modal-cancel" catchtap="closeAdd">取消</view>
      <view class="btn modal-btn modal-ok" catchtap="confirmAdd">确定</view>
    </view>
  </view>

  <toast id="toast" />
</view>
