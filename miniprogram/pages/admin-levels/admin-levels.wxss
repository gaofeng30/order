/* ---------- 规则说明 ---------- */
.tip-card { padding: 32rpx 36rpx 34rpx; margin-top: 20rpx; }
.tip-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx; }
.tip-title { font-size: 31rpx; font-weight: 700; letter-spacing: 1rpx; }
.tip-line { font-size: 24rpx; line-height: 1.75; color: var(--ink-on-dark-2); }
.tip-hl { color: #e0c67f; font-weight: 600; }

/* ---------- 等级卡 ---------- */
.lv { display: flex; align-items: flex-start; gap: 24rpx; padding: 30rpx 30rpx 30rpx 26rpx; margin-bottom: 22rpx; }
.lv-no {
  flex: 0 0 56rpx; width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--blue-bg); color: var(--blue-500);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; margin-top: 2rpx;
}
.lv-main { flex: 1; min-width: 0; }
.lv-head { display: flex; align-items: center; gap: 14rpx; }
.lv-name { font-size: 32rpx; font-weight: 700; color: var(--ink); letter-spacing: 1rpx; }
.lv-desc { font-size: 24rpx; color: var(--ink-3); margin-top: 10rpx; line-height: 1.5; }
.lv-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; }
.lv-cnt { font-size: 23rpx; color: var(--ink-2); }
.lv-dot { font-size: 23rpx; color: var(--ink-3); }

.lv-side { flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-end; gap: 20rpx; }
.lv-sort { display: flex; gap: 10rpx; }
.sbtn {
  width: 52rpx; height: 52rpx; border-radius: 16rpx; background: var(--bg2);
  display: flex; align-items: center; justify-content: center;
}
.sbtn icon { transform: rotate(180deg); }
.sbtn.down icon { transform: rotate(0deg); }
.sbtn.dis { opacity: .5; }
.lv-acts { display: flex; gap: 22rpx; }
.la-edit { font-size: 25rpx; color: var(--blue-500); font-weight: 600; }
.la-del { font-size: 25rpx; color: #b4483c; font-weight: 600; }

/* ---------- 新增按钮 ---------- */
.add-lv {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  height: 100rpx; border-radius: var(--r-card); border: 3rpx dashed rgba(42, 95, 166, .35);
  color: var(--blue-500); font-size: 28rpx; font-weight: 600; margin-top: 6rpx;
}

/* ---------- 弹层 ---------- */
.ed-sheet { padding: 0 0 0; }
.ed-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 36rpx 36rpx 22rpx; border-bottom: 1rpx solid var(--line-2);
}
.ed-title { font-size: 34rpx; font-weight: 700; color: var(--ink); letter-spacing: 1rpx; }
.ed-close { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.ed-body { padding: 8rpx 36rpx 20rpx; max-height: 56vh; }

.erow { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid var(--line-2); }
.erow.last { border-bottom: none; }
.erow-lbl { font-size: 27rpx; color: var(--ink-2); width: 156rpx; flex: 0 0 156rpx; }
.erow-in { flex: 1; font-size: 29rpx; color: var(--ink); }
.ph { color: var(--ink-3); }
.erow-tag { font-size: 21rpx; color: var(--gold-2); background: var(--gold-bg); padding: 6rpx 16rpx; border-radius: 12rpx; }
.ed-tip { font-size: 23rpx; color: var(--ink-3); line-height: 1.6; padding: 20rpx 0 4rpx; }

.ed-foot { display: flex; gap: 24rpx; padding: 20rpx 36rpx 0; border-top: 1rpx solid var(--line); }
.ed-cancel { flex: 1; }
.ed-save { flex: 1.6; }

/* ---------- 删除影响面 ---------- */
.dl-impact { background: var(--card-2); border-radius: var(--r-sm); padding: 26rpx 28rpx; margin-top: 18rpx; }
.di-row { display: flex; align-items: center; gap: 12rpx; padding: 6rpx 0; }
.di-txt { font-size: 26rpx; color: var(--ink-2); }
.di-hl { color: var(--ink); font-weight: 700; }
.di-cps { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 14rpx 0 4rpx; }
.di-cp { font-size: 22rpx; color: var(--gold-2); background: var(--gold-bg); padding: 6rpx 16rpx; border-radius: var(--r-pill); }
.di-note { font-size: 23rpx; color: var(--ink-3); line-height: 1.6; margin-top: 14rpx; }

.dl-label { font-size: 29rpx; font-weight: 700; color: var(--ink); margin: 32rpx 0 18rpx; }
.dl-opts { display: flex; flex-wrap: wrap; gap: 16rpx; }
.dl-warn {
  display: flex; align-items: flex-start; gap: 10rpx; margin-top: 22rpx;
  font-size: 23rpx; color: var(--gold-2); line-height: 1.55;
}
