.verify-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.intro {
  margin-top: 22rpx;
  color: rgba(248, 250, 252, 0.72);
  font-size: 28rpx;
  line-height: 1.55;
}

.scan-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 34rpx;
}

.scan-frame {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  border: 2rpx solid #24364a;
  border-radius: 32rpx;
  background: #f1f5f9;
}

.scan-line {
  position: absolute;
  top: 48%;
  left: 28rpx;
  right: 28rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #1d4ed8;
}

.form,
.success {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 30rpx;
}

.code-input {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
}
