<view class="page verify-page">
  <view class="hero-dark verify-hero">
    <view class="eyebrow">VERIFY</view>
    <view class="title-xl">窗口核销</view>
    <view class="intro">支持扫码和手动输入取餐号，减少窗口排队等待。</view>
  </view>

  <view class="scan-card soft-card">
    <view class="scan-frame">
      <view class="scan-line"></view>
    </view>
    <view class="caption">扫码核销</view>
  </view>

  <view class="card form">
    <view class="row-between">
      <view class="title-md">手动核销</view>
      <status-pill text="{{order.statusText}}" type="{{order.status === 'completed' ? 'success' : 'accent'}}" />
    </view>
    <input class="field code-input" value="{{code}}" bindinput="updateCode" placeholder="输入取餐号，如 A126" />
    <view class="caption">{{order.id}} · {{order.contact}} · ¥{{order.amount}}</view>
    <button class="btn {{order.status === 'completed' ? 'btn-disabled' : 'btn-primary'}}" bindtap="verify">
      {{order.status === 'completed' ? '已核销' : '确认核销'}}
    </button>
  </view>

  <view wx:if="{{verified}}" class="success card">
    <view class="title-md">核销完成</view>
    <view class="caption">订单状态已同步为已完成，数据看板会更新订单与营收状态。</view>
    <button class="btn btn-dark" bindtap="goDashboard">返回数据看板</button>
  </view>
</view>
