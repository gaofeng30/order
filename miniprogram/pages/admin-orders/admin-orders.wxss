.batch-toggle { font-size: 26rpx; color: var(--blue-500); font-weight: 600; }

.search-wrap { padding-top: 4rpx; padding-bottom: 16rpx; }
.search-box {
  height: 76rpx; border-radius: 999rpx; background: #fff; box-shadow: inset 0 0 0 2rpx var(--line);
  display: flex; align-items: center; gap: 16rpx; padding: 0 28rpx;
}
.search-ph { flex: 1; font-size: 26rpx; color: var(--ink-3); }

.lane-nav { padding: 0 24rpx 16rpx; border-bottom: 1rpx solid var(--line); }

.empty { text-align: center; padding: 140rpx 0; color: var(--ink-3); }
.empty-txt { font-size: 27rpx; margin-top: 24rpx; }

.aorder { padding: 28rpx; margin-top: 24rpx; display: flex; gap: 24rpx; }
.check {
  width: 44rpx; height: 44rpx; border-radius: 50%; border: 4rpx solid var(--line); background: #fff;
  display: flex; align-items: center; justify-content: center; flex: 0 0 44rpx; align-self: center;
}
.check.on { border-color: var(--green); background: var(--green); }
.aorder-body { flex: 1; min-width: 0; }
.aorder-head { display: flex; align-items: center; gap: 18rpx; }
.aorder-code { font-size: 54rpx; font-weight: 800; color: var(--blue); line-height: 1; }
.aorder-head .price { margin-left: auto; }
.aorder-meta { font-size: 23rpx; color: var(--ink-3); margin-top: 14rpx; display: flex; gap: 16rpx; }
.aorder-band {
  margin-top: 18rpx; background: var(--gold-bg); border-radius: 18rpx; padding: 14rpx 20rpx;
  font-size: 24rpx; color: var(--gold-2); display: flex; align-items: center; gap: 12rpx;
}
.aorder-summary { font-size: 23rpx; color: var(--ink-2); margin-top: 16rpx; }
.aorder-foot { display: flex; justify-content: flex-end; margin-top: 22rpx; }
.adv-btn { height: 64rpx; }

.batch-bar {
  height: 108rpx; border-radius: 999rpx; display: flex; align-items: center; padding: 0 16rpx 0 36rpx;
  background: #fff; box-shadow: var(--sh-pop);
}
.batch-info { font-size: 27rpx; color: var(--ink-2); }
.batch-n { color: var(--ink); font-weight: 700; }
.batch-go { margin-left: auto; height: 84rpx; }
