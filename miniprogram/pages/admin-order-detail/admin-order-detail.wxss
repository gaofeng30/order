.admin-order-detail {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.pickup {
  margin-top: 38rpx;
  font-size: 104rpx;
  font-weight: 600;
  letter-spacing: -0.035em;
  line-height: 1;
}

.meta {
  margin-top: 12rpx;
  color: rgba(248, 250, 252, 0.72);
}

.block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 30rpx;
}

.block-title {
  font-size: 31rpx;
  font-weight: 600;
}

.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.total,
.value {
  font-size: 28rpx;
  font-weight: 600;
}

.highlight {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(29, 78, 216, 0.1);
  color: #1d4ed8;
}
