.launch {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  gap: 28rpx;
}

.intro {
  max-width: 560rpx;
  margin-top: 22rpx;
  color: rgba(248, 250, 252, 0.72);
  font-size: 29rpx;
  line-height: 1.55;
}

.plate {
  width: 320rpx;
  height: 320rpx;
  margin: 46rpx auto 0;
  padding: 42rpx;
  border-radius: 50%;
  background: rgba(248, 250, 252, 0.09);
}

.plate-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #f8fafc;
  border: 36rpx solid #1d4ed8;
  box-shadow: inset 0 0 0 28rpx #047857, inset 0 0 0 58rpx #e2e8f0;
}

.entry {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 34rpx;
}
