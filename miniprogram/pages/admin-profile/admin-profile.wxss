.id-card { border-radius: 0 0 52rpx 52rpx; padding-left: 40rpx; padding-right: 40rpx; padding-bottom: 48rpx; color: #fff; }
.id-inner { display: flex; align-items: center; gap: 28rpx; position: relative; z-index: 2; }
.id-emblem { width: 108rpx; height: 108rpx; background: #fff; border-radius: 30rpx; padding: 8rpx; }
.id-body { flex: 1; }
.id-name { font-size: 38rpx; font-weight: 700; }
.id-sub { font-size: 24rpx; color: var(--ink-on-dark-2); margin-top: 8rpx; }

.body { margin-top: 28rpx; }
.group { padding: 4rpx 36rpx; margin-bottom: 24rpx; }
.prow { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--line-2); }
.prow.last { border-bottom: none; }
.prow-ico { width: 76rpx; height: 76rpx; border-radius: 22rpx; background: var(--bg2); flex: 0 0 76rpx; display: flex; align-items: center; justify-content: center; }
.prow-main { flex: 1; min-width: 0; }
.prow-label { font-size: 29rpx; color: var(--ink); font-weight: 500; }
.prow-sub { font-size: 23rpx; color: var(--ink-3); margin-top: 6rpx; }
.prow-val { font-size: 26rpx; color: var(--ink-2); }

.switch-id { text-align: center; font-size: 25rpx; color: var(--ink-3); padding: 44rpx 0 8rpx; }
