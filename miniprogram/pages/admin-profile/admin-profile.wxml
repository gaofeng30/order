<view class="page">
  <navbar tone="dark" overlay title="商户中心" />

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="hero-dark id-card" style="padding-top:{{navTotal}}px">
      <view class="ring r1"></view>
      <view class="ring r2"></view>
      <view class="id-inner">
        <image src="/assets/emblem.png" class="id-emblem" mode="aspectFit" />
        <view class="id-body">
          <view class="serif id-name">绥安食品</view>
          <view class="id-sub">县前直营店 · 店长 高特</view>
        </view>
        <pill s="{{storeStatus}}" ondark />
      </view>
    </view>

    <view class="pad body">
      <view class="card group">
        <view class="prow" bindtap="toSettings">
          <view class="prow-ico"><icon name="settings" size="19" color="#2a5fa6" /></view>
          <view class="prow-main"><view class="prow-label">营业设置</view><view class="prow-sub">状态 / 时间 / 截单 / 取餐点 / 公告</view></view>
          <icon name="chevron" size="17" color="#8f9384" />
        </view>
        <view class="prow" bindtap="toCategories">
          <view class="prow-ico"><icon name="tag" size="19" color="#467a32" /></view>
          <view class="prow-main"><view class="prow-label">分类管理</view><view class="prow-sub">目录结构与上架范围</view></view>
          <icon name="chevron" size="17" color="#8f9384" />
        </view>
        <view class="prow last" bindtap="toLayer">
          <view class="prow-ico"><icon name="layers" size="19" color="#a4873f" /></view>
          <view class="prow-main"><view class="prow-label">开屏图层</view><view class="prow-sub">业务选择页 / 身份选择页装饰图片</view></view>
          <icon name="chevron" size="17" color="#8f9384" />
        </view>
      </view>

      <view class="grp-head">
        <text class="serif grp-t">会员与营销</text>
        <view class="pill pill--warn">二期能力 · 不在一期合同范围</view>
      </view>
      <view class="card group">
        <view class="prow" bindtap="toLevels">
          <view class="prow-ico"><icon name="layers" size="19" color="#2a5fa6" /></view>
          <view class="prow-main"><view class="prow-label">会员等级</view><view class="prow-sub">档位、常驻折扣与排序</view></view>
          <icon name="chevron" size="17" color="#8f9384" />
        </view>
        <view class="prow" bindtap="toMembers">
          <view class="prow-ico"><icon name="user" size="19" color="#467a32" /></view>
          <view class="prow-main"><view class="prow-label">会员名单</view><view class="prow-sub">手动添加或 CSV 批量导入</view></view>
          <icon name="chevron" size="17" color="#8f9384" />
        </view>
        <view class="prow last" bindtap="toCoupons">
          <view class="prow-ico"><icon name="ticket" size="19" color="#a4873f" /></view>
          <view class="prow-main"><view class="prow-label">优惠券</view><view class="prow-sub">按等级自动生效，无需用户领取</view></view>
          <icon name="chevron" size="17" color="#8f9384" />
        </view>
      </view>

      <view class="card group">
        <view class="prow last" bindtap="shift">
          <view class="prow-ico"><icon name="refresh" size="19" color="#2a5fa6" /></view>
          <view class="prow-main"><view class="prow-label">交班对账</view><view class="prow-sub">按班次汇总营收 / 订单 / 核销</view></view>
          <view class="pill pill--warn">规划中</view>
        </view>
      </view>

      <view class="card group">
        <view class="prow" bindtap="members">
          <view class="prow-ico"><icon name="user" size="19" color="#5e6354" /></view>
          <view class="prow-main"><view class="prow-label">成员与权限</view></view>
          <icon name="chevron" size="17" color="#8f9384" />
        </view>
        <view class="prow" bindtap="service">
          <view class="prow-ico"><icon name="headset" size="19" color="#5e6354" /></view>
          <view class="prow-main"><view class="prow-label">联系客服</view><view class="prow-sub">400-021-8866</view></view>
          <icon name="chevron" size="17" color="#8f9384" />
        </view>
        <view class="prow last">
          <view class="prow-ico"><icon name="box" size="19" color="#5e6354" /></view>
          <view class="prow-main"><view class="prow-label">版本</view></view>
          <text class="prow-val">v1.0.0</text>
        </view>
      </view>

      <view class="switch-id" bindtap="reset">切换身份入口 ›</view>
      <view style="height:{{safeBottom + 30}}px"></view>
    </view>
  </scroll-view>

  <tabbar variant="admin" active="admin-profile" />
  <toast id="toast" />
</view>
