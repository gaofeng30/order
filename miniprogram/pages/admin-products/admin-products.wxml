<view class="page">
  <navbar tone="light" title="菜品管理" />

  <view class="pad top-area">
    <view class="search-box">
      <icon name="search" size="16" color="#8f9384" /><text class="search-ph">搜索菜品名称</text>
    </view>
    <!-- 上架新菜 -->
    <view class="new-banner" bindtap="newProduct">
      <view class="nb-ring"></view>
      <view class="nb-ico"><icon name="plus" size="20" color="#ffffff" /></view>
      <view class="nb-body">
        <view class="serif nb-title">上架新菜</view>
        <view class="nb-sub">添加菜品图片、价格与规格</view>
      </view>
      <icon name="arrowRight" size="18" color="rgba(255,255,255,0.85)" />
    </view>
  </view>

  <view class="cat-nav">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
      <view class="segs">
        <view wx:for="{{cats}}" wx:key="*this" class="seg {{cat === item ? 'on' : ''}}" data-c="{{item}}" bindtap="switchCat">{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:for="{{list}}" wx:key="id" class="card prod {{item.s === 'off' ? 'off' : ''}}">
      <view class="prod-pic" data-id="{{item.id}}" bindtap="edit">
        <imageph item="{{item}}" h="136" w="136" radius="24" tag="{{false}}" />
        <view wx:if="{{item.s === 'soldout'}}" class="prod-mask">售罄</view>
      </view>
      <view class="prod-info">
        <view class="prod-head">
          <text class="prod-name">{{item.name}}</text>
          <pill s="{{item.pillLabel}}" tone="{{item.pillTone}}" />
        </view>
        <view class="prod-meta">
          <money v="{{item.price}}" blue size="30" />
          <text class="prod-stock {{item.low ? 'low' : ''}}">库存 {{item.stock}}{{item.low ? ' ·告急' : ''}}</text>
          <text class="prod-sold">月售 {{item.sold}}</text>
        </view>
        <view class="prod-actions">
          <text class="pa-soldout {{item.s === 'soldout' ? 'green' : ''}}" data-id="{{item.id}}" catchtap="toggleSoldout">{{item.soldoutLabel}}</text>
          <text class="pa-edit" data-id="{{item.id}}" catchtap="edit">编辑</text>
          <view class="pa-shelf">
            <text class="pa-shelf-lbl">上架</text>
            <view class="toggle {{item.on ? 'on' : ''}}" data-id="{{item.id}}" catchtap="toggleShelf">
              <view class="toggle-knob"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view style="height:{{safeBottom + 30}}px"></view>
  </scroll-view>

  <tabbar variant="admin" active="admin-products" />
  <toast id="toast" />
</view>
