<view class="page page--tab orders">
  <view class="title-lg">我的订单</view>
  <scroll-view class="tabs" scroll-x>
    <button
      wx:for="{{tabs}}"
      wx:key="id"
      class="tab {{active === item.id ? 'tab-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="switchTab"
    >
      {{item.name}}
    </button>
  </scroll-view>

  <view wx:if="{{orders.length}}" class="list">
    <view wx:for="{{orders}}" wx:key="id" class="order-card card" data-id="{{item.id}}" bindtap="openOrder">
      <view class="row-between">
        <view class="order-id">{{item.id}}</view>
        <status-pill text="{{item.statusText}}" type="{{item.status === 'completed' ? 'success' : 'accent'}}" />
      </view>
      <view class="pickup">{{item.pickupNo}}</view>
      <view class="caption">{{item.createdAt}} · {{item.pickupPlace}}</view>
      <view class="row-between order-bottom">
        <text>{{item.items.length}} 件商品</text>
        <text>¥{{item.amount}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    当前状态下暂无订单
    <button class="btn btn-primary empty-btn" bindtap="goMenu">去点单</button>
  </view>
</view>
