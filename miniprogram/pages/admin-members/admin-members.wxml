<view class="page">
  <navbar tone="light" title="会员名单" back />

  <view class="pad top-area">
    <view class="search-box">
      <icon name="search" size="16" color="#8f9384" />
      <input class="search-in" placeholder="搜索手机号或姓名" placeholder-class="ph" value="{{kw}}" bindinput="onKw" />
      <view wx:if="{{kw}}" class="search-clr" catchtap="clearKw"><icon name="close" size="14" color="#8f9384" /></view>
    </view>

    <view class="new-banner" bindtap="toImport">
      <view class="nb-ring"></view>
      <view class="nb-ico"><icon name="box" size="20" color="#ffffff" /></view>
      <view class="nb-body">
        <view class="serif nb-title">批量导入名单</view>
        <view class="nb-sub">从微信聊天选择 CSV 文件，导入前可预览核对</view>
      </view>
      <icon name="arrowRight" size="18" color="rgba(255,255,255,0.85)" />
    </view>

    <view class="stat-row">
      <view class="stat">
        <text class="st-v tnum">{{total}}</text>
        <text class="st-k">名单人数</text>
      </view>
      <view class="stat-line"></view>
      <view class="stat">
        <text class="st-v tnum">{{boundCount}}</text>
        <text class="st-k">已绑定微信</text>
      </view>
      <view class="stat-line"></view>
      <view class="stat">
        <text class="st-v tnum">{{offCount}}</text>
        <text class="st-k">已停用</text>
      </view>
      <view class="stat-add" bindtap="toNew">
        <icon name="plus" size="18" color="#2a5fa6" />
      </view>
    </view>
  </view>

  <view class="cat-nav">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
      <view class="segs">
        <view wx:for="{{tabs}}" wx:key="id" class="seg {{tab === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="switchTab">
          {{item.name}}<text class="cnt">{{item.count}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:for="{{list}}" wx:key="id" class="card mb {{item.enabled ? '' : 'off'}}" data-id="{{item.id}}" bindtap="edit">
      <view class="mb-av serif">{{item.initial}}</view>
      <view class="mb-main">
        <view class="mb-head">
          <text class="mb-name">{{item.name}}</text>
          <view class="pill {{item.enabled ? 'pill--warn' : 'pill--mute'}}">{{item.levelName}}</view>
          <view wx:if="{{!item.enabled}}" class="pill pill--mute">已停用</view>
        </view>
        <view class="mb-phone tnum">{{item.phoneMask}}</view>
        <view class="mb-org">{{item.orgLine}}</view>
      </view>
      <view class="mb-side">
        <view class="mb-spend"><money v="{{item.spend}}" blue size="28" /></view>
        <text class="mb-orders">{{item.orders}} 单</text>
        <view class="pill {{item.bound ? 'pill--ok' : 'pill--mute'}} mb-bind">{{item.bound ? '已绑定' : '未绑定'}}</view>
      </view>
    </view>

    <view wx:if="{{!list.length}}" class="empty">
      <icon name="user" size="30" color="#c9cbbe" />
      <view class="empty-t">{{kw ? '没有匹配的会员' : '该等级下暂无会员'}}</view>
      <view class="empty-s">可批量导入 CSV，或点上方 + 手动添加</view>
    </view>

    <view style="height:{{safeBottom + 40}}px"></view>
  </scroll-view>

  <toast id="toast" />
</view>
