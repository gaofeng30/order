.img-area { margin-top: 20rpx; }
.img-head { display: flex; align-items: baseline; justify-content: space-between; padding: 0 6rpx 18rpx; }
.ia-t { font-size: 30rpx; font-weight: 700; color: var(--ink); letter-spacing: 1rpx; }
.ia-s { font-size: 22rpx; color: var(--ink-3); }

.img-list { display: flex; flex-wrap: wrap; gap: 20rpx; }
.img-cell { position: relative; width: 196rpx; height: 196rpx; border-radius: 28rpx; overflow: hidden; background: var(--bg2); }
.img-thumb { width: 100%; height: 100%; display: block; }
.img-cover {
  position: absolute; left: 0; top: 0; padding: 6rpx 16rpx;
  background: rgba(11, 47, 99, .85); color: #fff; font-size: 19rpx; border-radius: 0 0 16rpx 0;
}
.img-del {
  position: absolute; right: 8rpx; top: 8rpx; width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(15, 20, 12, .55); display: flex; align-items: center; justify-content: center;
}
.img-set {
  position: absolute; left: 0; right: 0; bottom: 0; height: 44rpx;
  background: rgba(15, 20, 12, .55); color: #fff; font-size: 20rpx;
  display: flex; align-items: center; justify-content: center;
}
.img-up {
  width: 196rpx; height: 196rpx; border-radius: 28rpx; border: 3rpx dashed var(--line);
  display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--ink-3); gap: 8rpx;
}
.img-up-t { font-size: 20rpx; }
.img-tip { font-size: 23rpx; color: var(--ink-3); line-height: 1.6; margin-top: 20rpx; padding: 0 6rpx; }

.del-row {
  margin-top: 32rpx; height: 92rpx; border-radius: var(--r-card); background: var(--card);
  box-shadow: var(--sh-soft); display: flex; align-items: center; justify-content: center;
  font-size: 27rpx; color: #b4483c; font-weight: 600;
}

.form { padding: 4rpx 36rpx; margin-top: 32rpx; }
.erow { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid var(--line-2); }
.erow-lbl { font-size: 27rpx; color: var(--ink-2); width: 156rpx; flex: 0 0 156rpx; }
.erow-in { flex: 1; font-size: 29rpx; color: var(--ink); }
.ph { color: var(--ink-3); }
.erow-tag { font-size: 21rpx; color: var(--ink-3); background: var(--bg2); padding: 4rpx 14rpx; border-radius: 12rpx; }
.cat-row { align-items: flex-start; }
.cat-chips { display: flex; gap: 16rpx; flex-wrap: wrap; flex: 1; }
.cat-chips .chip { height: 60rpx; }
.desc-row { padding: 26rpx 0; }
.desc-in {
  width: 100%; min-height: 160rpx; border: 1rpx solid var(--line); border-radius: 24rpx; padding: 24rpx;
  font-size: 28rpx; color: var(--ink); margin-top: 16rpx; box-sizing: border-box;
}

.bottom-bar { flex: 0 0 auto; padding: 20rpx 32rpx; border-top: 1rpx solid var(--line); display: flex; gap: 24rpx; }
.edit-cancel { flex: 1; }
.edit-save { flex: 1.6; }
