.img-area { display: flex; gap: 24rpx; margin-top: 16rpx; align-items: center; }
.img-up {
  width: 168rpx; height: 168rpx; border-radius: 28rpx; border: 3rpx dashed var(--line);
  display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--ink-3); gap: 8rpx;
}
.img-up-t { font-size: 20rpx; }
.img-tip { flex: 1; font-size: 24rpx; color: var(--ink-3); line-height: 1.6; }

.form { padding: 4rpx 36rpx; margin-top: 32rpx; }
.erow { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid var(--line-2); }
.erow-lbl { font-size: 27rpx; color: var(--ink-2); width: 156rpx; flex: 0 0 156rpx; }
.erow-in { flex: 1; font-size: 29rpx; color: var(--ink); }
.ph { color: var(--ink-3); }
.erow-tag { font-size: 21rpx; color: var(--ink-3); background: var(--bg2); padding: 4rpx 14rpx; border-radius: 12rpx; }
.cat-row { align-items: flex-start; }
.cat-chips { display: flex; gap: 16rpx; flex-wrap: wrap; flex: 1; }
.cat-chips .chip { height: 60rpx; }
.desc-row { padding: 26rpx 0; }
.desc-in {
  width: 100%; min-height: 160rpx; border: 1rpx solid var(--line); border-radius: 24rpx; padding: 24rpx;
  font-size: 28rpx; color: var(--ink); margin-top: 16rpx; box-sizing: border-box;
}

.bottom-bar { flex: 0 0 auto; padding: 20rpx 32rpx; border-top: 1rpx solid var(--line); display: flex; gap: 24rpx; }
.edit-cancel { flex: 1; }
.edit-save { flex: 1.6; }
