.admin-dashboard {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.head {
  align-items: flex-start;
}

.block {
  padding: 30rpx;
}

.block-title {
  margin-bottom: 18rpx;
  font-size: 31rpx;
  font-weight: 600;
}

.rank-row,
.order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 70rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.1);
  font-size: 27rpx;
}

.rank-row:last-child,
.order-row:last-child {
  border-bottom: 0;
}

.order-id {
  font-size: 25rpx;
  font-weight: 600;
}

.admin-nav {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.nav-card {
  min-height: 94rpx;
  border-radius: 26rpx;
  background: #fafafa;
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 600;
}
