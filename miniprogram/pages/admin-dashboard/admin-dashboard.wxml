<view class="page">
  <navbar tone="dark" overlay title="工作台" />

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 营业状态条 -->
    <view class="hero-dark dash-hero" style="padding-top:{{navTotal}}px">
      <view class="ring r1"></view>
      <view class="dash-store">
        <image src="/assets/emblem.png" class="dash-emblem" mode="aspectFit" />
        <view class="dash-store-info">
          <view class="serif dash-store-name">绥安食品 · 县前直营店</view>
          <view class="dash-store-hour">今日营业 09:00 - 17:00</view>
        </view>
      </view>
      <view class="biz-switch">
        <view
          wx:for="{{biz}}"
          wx:key="*this"
          class="biz-seg"
          data-b="{{item}}"
          bindtap="setBiz"
          style="{{storeStatus === item ? 'background:' + (item === '营业中' ? '#3d6b2f' : (item === '已截单' ? '#8a8f7c' : '#c98b3a')) + ';color:#fff' : 'color:rgba(255,255,255,.65)'}}"
        >{{item}}</view>
      </view>
    </view>

    <view class="pad">
      <!-- 待办 -->
      <view wx:if="{{todos.length}}" class="todos">
        <view wx:for="{{todos}}" wx:key="label" class="card todo" data-to="{{item.to}}" bindtap="toTodo">
          <view class="todo-dot" style="background:{{item.dot}}"></view>
          <view class="serif todo-n">{{item.n}}</view>
          <view class="todo-lbl">{{item.label}}</view>
        </view>
      </view>

      <!-- 今日概览 -->
      <view class="sec-h"><text class="t">经营概览</text><text class="faint" style="font-size:22rpx">截至 16:48</text></view>
      <view class="kpis">
        <view wx:for="{{kpi}}" wx:key="k" class="card kpi" data-k="{{item.k}}" bindtap="kpiTap">
          <view class="kpi-top"><text class="kpi-k">{{item.k}}</text><icon name="{{item.ic}}" size="16" color="{{item.c}}" /></view>
          <view class="serif kpi-v">{{item.v}}</view>
        </view>
      </view>

      <!-- 实时订单 -->
      <view class="sec-h"><text class="t">实时订单</text><text class="more" bindtap="toAllOrders">全部 ›</text></view>
      <view wx:for="{{live}}" wx:key="id" class="card live">
        <view class="live-code">
          <view class="serif live-code-val">{{item.code}}</view>
          <view class="live-time">{{item.time}}</view>
        </view>
        <view class="live-body">
          <view class="live-head"><pill s="{{item.status}}" /><text class="live-meta">{{item.count}} 件 · ¥{{item.total}}</text></view>
          <view class="live-summary ellipsis-1">{{item.summary}}</view>
        </view>
        <view
          wx:if="{{item.meta.isView}}"
          class="btn btn--ghost-blue btn--sm adv-btn"
          data-id="{{item.id}}"
          catchtap="viewOrder"
        >{{item.meta.label}}</view>
        <view
          wx:else
          class="btn {{item.meta.cls}} btn--sm adv-btn"
          data-id="{{item.id}}"
          catchtap="advance"
        >
          <icon wx:if="{{item.meta.scan}}" name="scan" size="15" color="#ffffff" />{{item.meta.label}}
        </view>
      </view>

      <!-- 销量排行 -->
      <view class="sec-h"><text class="t">单品销量</text><text class="faint" style="font-size:22rpx">长按可售罄/补货</text></view>
      <view class="card rank">
        <view
          wx:for="{{rank}}"
          wx:key="id"
          class="rank-row {{index === rank.length - 1 ? 'last' : ''}}"
          data-name="{{item.name}}"
          bindlongpress="rankPress"
        >
          <text class="serif rank-no {{index < 3 ? 'top' : ''}}">{{index + 1}}</text>
          <text class="rank-name">{{item.name}}</text>
          <view class="rank-bar"><view class="rank-fill" style="width:{{item.pct}}%"></view></view>
          <text class="tnum rank-sold">{{item.sold}}</text>
        </view>
      </view>
      <view style="height:{{safeBottom + 30}}px"></view>
    </view>
  </scroll-view>

  <tabbar variant="admin" active="admin-dashboard" />
  <toast id="toast" />
</view>
