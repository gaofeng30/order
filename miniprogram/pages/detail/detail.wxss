.detail {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.hero-img {
  width: 100%;
  height: 420rpx;
  border-radius: 44rpx;
  background: #fafafa;
}

.detail-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
  padding: 34rpx;
}

.price {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f1f5f9;
}

.quantity-row {
  padding-top: 10rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: 600;
}

.step-add {
  border-color: #1d4ed8;
  background: #1d4ed8;
  color: #f8fafc;
}

.qty {
  min-width: 34rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}
