.menu {
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
}

.menu-head {
  margin-bottom: 24rpx;
}

.menu-layout {
  display: flex;
  height: calc(100vh - 252rpx - env(safe-area-inset-bottom));
  min-width: 0;
  flex-direction: column;
  gap: 16rpx;
}

.category-list {
  flex: 0 0 76rpx;
  width: 100%;
  white-space: nowrap;
}

.category {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 132rpx;
  height: 68rpx;
  min-height: 68rpx;
  margin-right: 12rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fafafa;
  color: #475569;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
}

.category-active {
  background: #1d4ed8;
  color: #f8fafc;
}

.product-list {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 100%;
}

product-card {
  display: block;
  margin-bottom: 18rpx;
}

.cart-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.bar-total {
  margin-top: 4rpx;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.cart-bar .btn {
  min-width: 220rpx;
}

.cart-mask {
  position: fixed;
  inset: 0;
  z-index: 18;
  background: rgba(2, 6, 23, 0.22);
}

.cart-sheet {
  position: fixed;
  right: 20rpx;
  bottom: calc(134rpx + env(safe-area-inset-bottom));
  left: 20rpx;
  z-index: 19;
  max-height: 58vh;
  padding: 30rpx;
  border-radius: 36rpx;
  background: #fafafa;
  box-shadow: 0 22rpx 70rpx rgba(15, 23, 42, 0.16);
}

.cart-title {
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.cart-title button {
  color: #475569;
  font-size: 24rpx;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.cart-name {
  font-size: 28rpx;
  font-weight: 600;
}

.step-actions {
  gap: 12rpx;
}

.step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
}

.step-add {
  border-color: #1d4ed8;
  background: #1d4ed8;
  color: #f8fafc;
}

@media (max-width: 360px) {
  .category-list {
    flex-basis: 68rpx;
  }

  .category {
    min-width: 120rpx;
    height: 62rpx;
    min-height: 62rpx;
    padding: 0 20rpx;
    font-size: 23rpx;
  }
}
