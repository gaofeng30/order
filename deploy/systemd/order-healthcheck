#!/usr/bin/env bash
set -euo pipefail

check="${1:-}"
case "${check}" in
  live|ready) ;;
  *)
    echo "usage: order-healthcheck live|ready" >&2
    exit 2
    ;;
esac

for _ in {1..30}; do
  response=""
  if response="$(curl --fail --silent --show-error --max-time 2 "http://127.0.0.1:8080/health/${check}" 2>/dev/null)"; then
    if [[ "${response}" == '{"status":"ok"}' ]]; then
      exit 0
    fi
  fi
  sleep 1
done

echo "order-api ${check} check failed" >&2
exit 1
