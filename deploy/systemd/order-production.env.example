# Copy to /etc/order/order-production.env, replace every TODO_/REPLACE_ value,
# then set owner root:order and mode 0640. Never add secrets or cloud keys.
ORDER_ENV=production
ORDER_API_HTTP_ADDR=127.0.0.1:8080
ORDER_API_SHUTDOWN_TIMEOUT=10s
ORDER_DB_HOST=REPLACE_PROD_CDB_HOST
ORDER_DB_PORT=3306
ORDER_DB_NAME=REPLACE_PROD_DB_NAME
ORDER_DB_USER=REPLACE_PROD_DB_USER
ORDER_DB_TLS_MODE=required
ORDER_WECHAT_MINIPROGRAM_APP_ID=TODO_PROD_WECHAT_APPID
ORDER_TENCENT_REGION=TODO_TENCENT_REGION
