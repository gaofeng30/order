.cc {
  position: relative; display: flex; align-items: stretch; overflow: hidden;
  background: var(--card); border-radius: var(--r-card); box-shadow: var(--sh-card);
}
/* 与下方操作条拼接时，取消底部圆角与投影 */
.cc.attached { border-radius: var(--r-card) var(--r-card) 0 0; box-shadow: var(--sh-soft); }
.cc.dim { opacity: .55; }
.cc.picked { box-shadow: var(--sh-card), inset 0 0 0 4rpx var(--gold); }

/* 面额区 */
.cc-face {
  flex: 0 0 208rpx; width: 208rpx;
  background: linear-gradient(150deg, #c9ab63, #a4873f);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx;
  padding: 34rpx 16rpx;
}
.cc-amt { font-size: 54rpx; font-weight: 700; color: #fff; letter-spacing: -1rpx; line-height: 1; }
.cc-cond { font-size: 20rpx; color: rgba(255, 255, 255, .82); text-align: center; line-height: 1.4; }

/* 票据齿孔与虚线 */
.cc-notch {
  position: absolute; left: 190rpx; width: 36rpx; height: 36rpx; border-radius: 50%;
  background: var(--bg); z-index: 3;
}
.cc-notch.top { top: -18rpx; }
.cc-notch.bottom { bottom: -18rpx; }
.cc-dash {
  position: absolute; left: 207rpx; top: 22rpx; bottom: 22rpx; width: 2rpx;
  background: repeating-linear-gradient(to bottom, rgba(255,255,255,.55) 0 8rpx, transparent 8rpx 18rpx);
  z-index: 2;
}

/* 信息区 */
.cc-body { flex: 1; min-width: 0; padding: 26rpx 28rpx 24rpx 32rpx; }
.cc-head { display: flex; align-items: center; gap: 12rpx; }
.cc-name { font-size: 29rpx; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cc-badge { flex: 0 0 auto; height: 38rpx; font-size: 20rpx; padding: 0 14rpx; }
.cc-scope { font-size: 23rpx; color: var(--ink-2); margin-top: 12rpx; }
.cc-period { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; }
.cc-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.cc-tag { font-size: 20rpx; color: var(--blue-500); background: var(--blue-bg); padding: 5rpx 14rpx; border-radius: var(--r-pill); }
.cc-reason { font-size: 22rpx; color: #b4483c; margin-top: 14rpx; line-height: 1.5; }

/* 选中标记 */
.cc-pick {
  position: absolute; right: 26rpx; top: 50%; margin-top: -22rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  box-shadow: inset 0 0 0 3rpx var(--line); background: #fff;
  display: flex; align-items: center; justify-content: center;
}
.cc-pick.on { background: var(--gold); box-shadow: none; }
