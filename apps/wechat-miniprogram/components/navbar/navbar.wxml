<view
  class="navbar {{tone}} {{overlay ? 'overlay' : 'block'}} {{overlay && solid ? 'solid' : ''}}"
  style="padding-top:{{statusBarH}}px"
>
  <view class="nb-row" style="height:{{navH}}px">
    <view wx:if="{{back || exit}}" class="nb-back" catchtap="onBack" hover-stop-propagation="{{true}}" hover-class="tap-dim" hover-stay-time="80" aria-role="button" aria-label="返回">
      <icon name="back" size="22" color="{{tone === 'dark' ? '#ffffff' : '#22271d'}}" />
    </view>
    <view wx:if="{{leftLabel}}" class="nb-left {{tone}}">{{leftLabel}}</view>
    <view wx:if="{{title}}" class="nb-title {{tone}}">{{title}}</view>
    <view class="nb-right" style="right:{{capsuleGap}}px">
      <slot name="right"></slot>
    </view>
  </view>
</view>
