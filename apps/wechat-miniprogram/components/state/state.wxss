/* 统一的加载中 / 失败 + 重试 / 空 + 引导（G4） */
.st { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; padding: 120rpx 48rpx; text-align: center; }
.st-ico {
  width: 104rpx; height: 104rpx; border-radius: 50%; background: var(--card-2);
  display: flex; align-items: center; justify-content: center; box-shadow: inset 0 0 0 2rpx var(--line-2);
}
.st--compact { padding: 32rpx 0; }
.st--error .st-ico { background: var(--red-bg); box-shadow: none; }
.st-text { font-size: var(--fs-sm); color: var(--ink-3); line-height: 1.6; }
.st-btn { margin-top: 8rpx; }
.st-spin {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  border: 4rpx solid var(--green-bg); border-top-color: var(--green); animation: stSpin .8s linear infinite;
}
@keyframes stSpin { to { transform: rotate(360deg); } }
