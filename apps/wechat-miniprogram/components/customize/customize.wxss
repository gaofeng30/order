.cz-sheet { padding-bottom: 0; }

.cz-head {
  display: flex; align-items: flex-start; gap: 24rpx; padding: 36rpx 36rpx 28rpx; border-bottom: 2rpx solid var(--line);
}
.cz-head-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; }
.cz-name { font-size: var(--fs-lg); font-weight: 700; color: var(--ink); }
.cz-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10rpx; }

.cz-body { padding: 0 36rpx; max-height: 600rpx; }
.cz-label-row { display: flex; align-items: baseline; gap: 16rpx; margin: 32rpx 0 20rpx; }
.cz-label { font-size: var(--fs-md); font-weight: 700; color: var(--ink); }
.cz-label-sub { font-size: var(--fs-xs); color: var(--ink-3); }
.cz-chips { display: flex; flex-wrap: wrap; gap: 18rpx; }

.cz-note-row { display: flex; align-items: baseline; justify-content: space-between; margin: 36rpx 0 20rpx; }
.cz-count { font-size: var(--fs-xs); color: var(--ink-3); }
.cz-note.input-box { width: 100%; min-height: 120rpx; padding: 24rpx 28rpx; line-height: 1.5; margin-bottom: 8rpx; }
.cz-note-ph { color: var(--ink-3); }

.cz-foot { display: flex; align-items: center; gap: 28rpx; padding: 28rpx 36rpx 0; border-top: 2rpx solid var(--line-2); }
.cz-confirm { flex: 1; }
