/* 垂直居中（E9），不再压在购物车栏和底栏上；外层撑满宽度再居中，宽度上限 80%（D26） */
.toast-wrap {
  position: fixed; left: 0; right: 0; top: 45%; z-index: 999;
  display: flex; justify-content: center; pointer-events: none; animation: toastIn .25s ease;
}
.toast {
  max-width: 80%; background: rgba(20, 28, 18, .92); color: #fff; padding: 24rpx 36rpx; border-radius: 28rpx;
  font-size: var(--fs-md); display: flex; align-items: center; gap: 20rpx; box-shadow: var(--sh-pop);
}
.toast-msg { line-height: 1.4; }
@keyframes toastIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }
