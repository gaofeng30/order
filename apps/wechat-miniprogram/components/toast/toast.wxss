.toast {
  position: fixed; left: 50%; bottom: 240rpx; transform: translateX(-50%); z-index: 999;
  background: rgba(20, 28, 18, .92); color: #fff; padding: 24rpx 36rpx; border-radius: 28rpx;
  font-size: 27rpx; display: flex; align-items: center; gap: 20rpx; box-shadow: var(--sh-pop);
  max-width: 80%; animation: toastIn .25s ease;
}
.toast-msg { line-height: 1.4; }
.toast-undo { color: #9ec8ff; margin-left: 8rpx; font-weight: 700; }
@keyframes toastIn { from { opacity: 0; transform: translate(-50%, 20rpx); } to { opacity: 1; transform: translate(-50%, 0); } }
