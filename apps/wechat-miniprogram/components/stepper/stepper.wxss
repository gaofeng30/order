/* 视觉圆钮 56rpx，点击区域 88rpx（G6）；负外边距抵消多出的点击区，保持原有占位 */
.stepper { display: inline-flex; align-items: center; height: 56rpx; margin: 0 -16rpx; }
.stepper .hit { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.stepper .minus, .stepper .plus {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.stepper .minus { background: var(--green-bg); }
.stepper .plus { background: var(--green); }
.stepper .qty {
  min-width: 44rpx; text-align: center; font-size: var(--fs-md); font-weight: 700; color: var(--ink);
}
