.stepper { display: inline-flex; align-items: center; height: 60rpx; }
.stepper .minus, .stepper .plus {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; line-height: 1;
}
.stepper .minus { background: #eef0e7; color: var(--green-600); }
.stepper .plus { background: var(--green); color: #fff; }
.stepper.blue .minus { background: var(--blue-bg); color: var(--blue-500); }
.stepper.blue .plus { background: var(--blue); color: #fff; }
.stepper .qty {
  min-width: 60rpx; text-align: center; font-size: 30rpx; font-weight: 700; color: var(--ink);
}
