<view class="stepper">
  <view class="hit" catchtap="onSub" hover-stop-propagation="{{true}}" hover-class="tap-dim" hover-stay-time="80" aria-role="button" aria-label="减少一份">
    <view class="minus"><icon name="minus" size="14" color="#467a32" stroke="2.4" /></view>
  </view>
  <text class="qty tnum">{{value}}</text>
  <view class="hit" catchtap="onAdd" hover-stop-propagation="{{true}}" hover-class="tap-dim" hover-stay-time="80" aria-role="button" aria-label="增加一份">
    <view class="plus"><icon name="plus" size="14" color="#ffffff" stroke="2.4" /></view>
  </view>
</view>
