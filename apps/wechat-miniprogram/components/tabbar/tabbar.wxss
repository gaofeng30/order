:host { display: block; }
.tabbar {
  flex: 0 0 auto; display: flex; background: rgba(255, 255, 255, .98);
  border-top: 2rpx solid var(--line); padding: 8rpx 16rpx 0;
}
.tab {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; padding: 10rpx 0; min-height: 88rpx;
}
.tab-ico { position: relative; width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; }
.tab-label { font-size: var(--fs-xs); font-weight: 600; }
.badge {
  position: absolute; top: -8rpx; right: -18rpx; background: var(--red); color: #fff;
  font-size: var(--fs-xs); min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center; line-height: 1;
}
