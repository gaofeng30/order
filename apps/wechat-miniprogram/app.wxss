/* ============================================================
   绥安食品 小程序 — 全局样式 / 设计基线 tokens
   尺寸统一用 rpx（750rpx = 屏宽），实现各机型自动等比适配
   品牌色: 深蓝 #0b2f63 + 橄榄绿 #3d6b2f, 金 #b79a55 点缀
   ============================================================ */
page {
  --blue: #0b2f63;
  --blue-700: #123f7e;
  --blue-500: #2a5fa6;
  --blue-bg: #e9f0f8;
  --hero: #0b2f63;
  --hero-2: #082651;
  --hero-3: #103a78;

  --green: #3d6b2f;
  --green-600: #467a32;
  --green-500: #5b8f3f;
  --green-bg: #eaf1e0;

  --gold: #b79a55;
  --gold-2: #a4873f;
  --gold-bg: #f4edd9;

  --bg: #f4f3ec;
  --bg2: #eef2e1;
  --card: #ffffff;
  --card-2: #fbfaf4;

  --ink: #22271d;
  --ink-2: #5e6354;
  --ink-3: #8f9384;
  --ink-on-dark: #eef2e6;
  --ink-on-dark-2: #aebbcf;

  --line: rgba(24, 36, 16, .09);
  --line-2: rgba(24, 36, 16, .05);

  --r-card: 36rpx;
  --r-lg: 44rpx;
  --r-sm: 24rpx;
  --r-pill: 999rpx;

  --sh-card: 0 12rpx 44rpx rgba(20, 40, 20, .06), 0 2rpx 4rpx rgba(20, 40, 20, .04);
  --sh-pop: 0 28rpx 88rpx rgba(8, 20, 44, .20);
  --sh-soft: 0 4rpx 20rpx rgba(20, 40, 20, .05);

  --font-serif: 'Songti SC', 'STSong', serif;
  --font-sans: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  --font-head: var(--font-serif);

  background: var(--bg);
  font-family: var(--font-sans);
  color: var(--ink);
}

view, text, scroll-view, input, textarea, button, image, navigator {
  box-sizing: border-box;
}

/* ---------- 页面骨架 ---------- */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  background: var(--bg);
  overflow: hidden;
}
.scroll {
  flex: 1;
  min-height: 0;
}
.pad { padding: 0 32rpx; }
.tnum { font-variant-numeric: tabular-nums; }
.muted { color: var(--ink-2); }
.faint { color: var(--ink-3); }
.serif { font-family: var(--font-head); }

/* 底部安全区填充（由 JS 注入高度的辅助 class 也可用 inline） */
.safe-pad { height: env(safe-area-inset-bottom); }

/* ---------- 卡片 / 英雄底 ---------- */
.card {
  background: var(--card);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
}
.hero-dark {
  background: linear-gradient(160deg, var(--hero-3) 0%, var(--hero) 45%, var(--hero-2) 100%);
  color: var(--ink-on-dark);
  border-radius: var(--r-lg);
  position: relative;
  overflow: hidden;
}
.ring { position: absolute; border-radius: 50%; border: 3rpx solid rgba(255, 255, 255, .10); pointer-events: none; }
.ring.r1 { width: 460rpx; height: 460rpx; right: -140rpx; top: -160rpx; }
.ring.r2 { width: 300rpx; height: 300rpx; right: -60rpx; top: -60rpx; border-color: rgba(183, 154, 85, .30); }
.ring.r3 { width: 600rpx; height: 600rpx; left: -240rpx; bottom: -320rpx; border-color: rgba(255, 255, 255, .06); }

/* ---------- 状态胶囊 Pill（组件内复用其样式）---------- */
.pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}
.pill--ok { background: var(--green-bg); color: var(--green-600); }
.pill--info { background: var(--blue-bg); color: var(--blue-500); }
.pill--mute { background: #eceadf; color: #8a8f7c; }
.pill--warn { background: var(--gold-bg); color: var(--gold-2); }
.pill--ondark { background: rgba(255, 255, 255, .16); color: #fff; }
.pill .pd { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; }

/* ---------- 按钮 ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  height: 96rpx;
  padding: 0 44rpx;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  font-family: var(--font-sans);
  transition: transform .08s, filter .15s;
  line-height: 1;
}
.btn::after { border: none; }
.btn.b-active { transform: scale(.975); }
.btn--primary { background: var(--green); color: #fff; box-shadow: 0 12rpx 32rpx rgba(61, 107, 47, .28); }
.btn--blue { background: var(--blue); color: #fff; box-shadow: 0 12rpx 32rpx rgba(11, 47, 99, .28); }
.btn--ghost { background: transparent; color: var(--green); box-shadow: inset 0 0 0 3rpx var(--green); }
.btn--ghost-blue { background: transparent; color: var(--blue); box-shadow: inset 0 0 0 3rpx var(--blue); }
.btn--gold { background: var(--gold); color: #fff; }
.btn--mute { background: #e7e6db; color: #9a9e8c; box-shadow: none; }
.btn--sm { height: 60rpx; font-size: 26rpx; padding: 0 32rpx; }
.btn--block { width: 100%; }

/* ---------- 价格 ---------- */
.price { font-family: var(--font-sans); font-weight: 800; color: var(--green-600); letter-spacing: -1rpx; }
.price .cur { font-size: .62em; font-weight: 700; margin-right: 2rpx; }
.price-blue { color: var(--blue); }

/* ---------- 章节标题 ---------- */
.sec-h { display: flex; align-items: baseline; justify-content: space-between; padding: 36rpx 4rpx 20rpx; }
.sec-h .t { font-family: var(--font-head); font-size: 34rpx; font-weight: 700; color: var(--ink); letter-spacing: 1rpx; }
.sec-h .more { font-size: 24rpx; color: var(--ink-3); }

/* ---------- 列表行 / 分割线 ---------- */
.list-row { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--line-2); }
.list-row.last { border-bottom: none; }
.divider { height: 1rpx; background: var(--line); }

/* ---------- chip ---------- */
.chip {
  display: inline-flex; align-items: center; gap: 10rpx; height: 68rpx; padding: 0 28rpx;
  border-radius: var(--r-pill); font-size: 26rpx; font-weight: 500;
  background: #fff; color: var(--ink-2); box-shadow: inset 0 0 0 2rpx var(--line);
}
.chip.on { background: var(--green-bg); color: var(--green-600); box-shadow: inset 0 0 0 3rpx var(--green); }
.chip.on.blue { background: var(--blue-bg); color: var(--blue-500); box-shadow: inset 0 0 0 3rpx var(--blue-500); }

/* ---------- 分段 / 泳道 ---------- */
.segs { display: flex; gap: 16rpx; white-space: nowrap; padding: 8rpx 0; }
.seg {
  flex: 0 0 auto; height: 64rpx; padding: 0 28rpx; border-radius: var(--r-pill);
  font-size: 26rpx; font-weight: 600; display: inline-flex; align-items: center; gap: 12rpx;
  background: #fff; color: var(--ink-2); box-shadow: inset 0 0 0 2rpx var(--line);
}
.seg.on { background: var(--ink); color: #fff; box-shadow: none; }
.seg .cnt { font-size: 22rpx; opacity: .7; }
.seg.on .cnt { opacity: .85; }

/* ---------- 浮动栏 / 弹层 ---------- */
.floatbar { position: absolute; left: 24rpx; right: 24rpx; z-index: 120; }
.sheet-mask { position: absolute; inset: 0; background: rgba(15, 20, 12, .42); z-index: 150; animation: fadeIn .2s ease; }
.sheet {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 160; background: var(--card);
  border-radius: 48rpx 48rpx 0 0; box-shadow: 0 -20rpx 80rpx rgba(0, 0, 0, .18);
  animation: sheetUp .28s cubic-bezier(.2, .8, .2, 1); max-height: 80%; display: flex; flex-direction: column;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheetUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

/* ---------- 进入动画 ---------- */
.fade-up { animation: fadeUp .32s ease both; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes scanline { 0% { top: 8%; } 50% { top: 90%; } 100% { top: 8%; } }

/* 文本省略 */
.ellipsis-1 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis-2 {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}

/* 隐藏滚动条 */
::-webkit-scrollbar { width: 0; height: 0; display: none; }
