.state-wrap { background: var(--bg); }

.ticket { border-radius: 0 0 56rpx 56rpx; padding-left: 44rpx; padding-right: 44rpx; padding-bottom: 60rpx; color: #fff; }
.ticket-inner { position: relative; z-index: 2; text-align: center; }
/* 字间距会在末字后留空，左侧补同等内边距让大字视觉居中（D40） */
.ticket-lbl { font-size: var(--fs-xs); letter-spacing: 10rpx; padding-left: 10rpx; color: var(--gold); margin-top: 12rpx; }
.ticket-code { font-size: 136rpx; font-weight: 900; letter-spacing: 12rpx; padding-left: 12rpx; line-height: 1.05; margin: 12rpx 0; }
.ticket-rsv {
  display: flex; align-items: center; justify-content: center; gap: 12rpx; margin: -4rpx 0 12rpx;
  font-size: var(--fs-md); color: var(--ink-on-dark); font-weight: 600;
}
.qr-white { background: #fff; border-radius: 36rpx; padding: 32rpx; display: inline-block; }
.ticket-pill { margin-top: 24rpx; }
.ticket-hint { font-size: var(--fs-sm); color: var(--ink-on-dark-2); margin-top: 20rpx; }
.ticket-copy {
  margin-top: 28rpx; display: inline-flex; align-items: center; gap: 12rpx; height: 88rpx; padding: 0 36rpx;
  background: rgba(255, 255, 255, .16); color: #fff; border-radius: var(--r-pill); font-size: var(--fs-md);
}

.sec-card { padding: 4rpx 36rpx; margin-top: 24rpx; }
.list-h { padding-bottom: 4rpx; }
.list-h-sub { font-size: var(--fs-sm); color: var(--ink-3); }
.od-item { display: flex; align-items: flex-start; gap: 24rpx; padding: 24rpx 0; border-bottom: 2rpx solid var(--line-2); }
.od-item.last { border-bottom: none; }
.od-item-info { flex: 1; min-width: 0; }
.od-item-name { font-size: var(--fs-md); color: var(--ink); font-weight: 500; }
.od-item-unit { display: flex; align-items: baseline; gap: 8rpx; margin-top: 8rpx; }
.od-item-qty { font-size: var(--fs-sm); color: var(--ink-3); }
.od-prefs { margin-top: 12rpx; display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.pref-chip { font-size: var(--fs-xs); color: var(--gold-2); background: var(--gold-bg); padding: 4rpx 16rpx; border-radius: 12rpx; }
.pref-note { font-size: var(--fs-xs); color: var(--ink-2); }
/* 小字标签与大号金额按文字底线对齐（D38） */
.pay-row { display: flex; justify-content: flex-end; align-items: baseline; gap: 16rpx; padding: 24rpx 0; border-top: 2rpx solid var(--line); }
.pay-lbl { font-size: var(--fs-sm); color: var(--ink-3); }

/* 信息行：标签浅、内容深；内容折行时标签顶部对齐（U37、D39） */
.info-row { display: flex; align-items: flex-start; gap: 32rpx; padding: 28rpx 0; border-bottom: 2rpx solid var(--line-2); }
.info-row.last { border-bottom: none; }
.ir-label { flex: 0 0 auto; font-size: var(--fs-sm); color: var(--ink-3); line-height: 40rpx; }
.ir-val { flex: 1; min-width: 0; font-size: var(--fs-md); color: var(--ink); line-height: 40rpx; text-align: right; word-break: break-all; }

/* 取消预约 / 提醒 */
.action-card { padding: 32rpx 36rpx; margin-top: 24rpx; }
.cancel-top { display: flex; align-items: flex-start; gap: 20rpx; }
.cancel-text { flex: 1; }
.action-title { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
.cancel-desc { font-size: var(--fs-sm); color: var(--ink-3); margin-top: 8rpx; line-height: 1.6; }
.cancel-desc.warn { color: var(--gold-2); }
.action-btn { margin-top: 28rpx; height: 88rpx; }
.cancel-btn { background: #fff; color: var(--red); box-shadow: inset 0 0 0 4rpx rgba(196, 67, 47, .32); }

/* 取消确认弹层 */
.cancel-sheet { padding: 44rpx 40rpx 0; }
.cs-center { text-align: center; }
.cs-ring { width: 116rpx; height: 116rpx; border-radius: 50%; background: var(--gold-bg); margin: 0 auto; display: flex; align-items: center; justify-content: center; }
.cs-title { font-size: var(--fs-lg); font-weight: 700; color: var(--ink); margin-top: 28rpx; }
.cs-sub { font-size: var(--fs-sm); color: var(--ink-2); margin-top: 12rpx; line-height: 1.6; }
.cs-actions { display: flex; gap: 24rpx; margin-top: 40rpx; }
.cs-btn { flex: 1; }
.cs-confirm { flex: 1.3; background: var(--red); color: #fff; }
