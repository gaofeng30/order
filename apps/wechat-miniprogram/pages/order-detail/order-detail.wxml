<view class="page">
  <navbar tone="dark" overlay back title="{{navTitle}}" solid="{{navSolid || detailState !== 'ready'}}" />

  <view wx:if="{{detailState !== 'ready'}}" class="scroll state-wrap" style="padding-top:{{navTotal}}px">
    <state wx:if="{{detailState === 'loading'}}" kind="loading" text="正在加载订单" />
    <state wx:elif="{{detailState === 'not_found'}}" kind="empty" text="没有找到这个订单" action="查看我的订单" bind:action="goOrders" />
    <state wx:else kind="error" text="网络不太好，订单没加载出来" bind:action="load" />
  </view>

  <scroll-view wx:else class="scroll" scroll-y enhanced show-scrollbar="{{false}}" bindscroll="onNavScroll">
    <!-- 深色大票 -->
    <view class="hero-dark ticket" style="padding-top:{{navTotal}}px">
      <view class="ring r1"></view>
      <view class="ring r3"></view>
      <view class="ticket-inner">
        <view class="ticket-lbl">取餐号</view>
        <view class="ticket-code serif">{{o.code}}</view>
        <view class="ticket-rsv"><icon name="calendarClock" size="15" color="#b79a55" /><text>{{pickupText}} 取餐</text></view>
        <!-- 取餐二维码只在订单进入 待取餐 后展示（生效 spec §5.8） -->
        <view wx:if="{{showQr}}" class="qr-white"><qrcode value="{{qrToken}}" size="300" dark="#0b2f63" /></view>
        <view class="ticket-pill"><pill s="{{o.status}}" ondark /></view>
        <view class="ticket-hint">{{showQr ? '出示二维码或报取餐号，到窗口即可取餐' : '餐品备好后，这里会显示取餐二维码'}}</view>
        <view class="ticket-copy" bindtap="copy" hover-class="tap-dim" hover-stay-time="80"><icon name="copy" size="16" color="#ffffff" /><text>复制取餐号</text></view>
      </view>
    </view>

    <view class="pad">
      <view class="card sec-card">
        <view class="sec-h list-h"><text class="t">商品明细</text><text class="list-h-sub">订单号 {{o.no}}</text></view>
        <view wx:for="{{rows}}" wx:key="key" class="od-item {{index === rows.length - 1 ? 'last' : ''}}">
          <view class="od-item-info">
            <view class="od-item-name">{{item.name}}</view>
            <view class="od-item-unit"><money cents="{{item.p}}" size="28" /><text class="od-item-qty">× {{item.q}}</text></view>
            <view wx:if="{{item.flavors.length || item.note}}" class="od-prefs">
              <text wx:for="{{item.flavors}}" wx:for-item="f" wx:key="*this" class="pref-chip">{{f}}</text>
              <text wx:if="{{item.note}}" class="pref-note">“{{item.note}}”</text>
            </view>
          </view>
          <money cents="{{item.sub}}" size="28" />
        </view>
        <view class="pay-row"><text class="pay-lbl">实付</text><money cents="{{o.total}}" size="44" /></view>
      </view>

      <view class="card sec-card">
        <view class="sec-h list-h"><text class="t">取餐信息</text></view>
        <view class="info-row"><text class="ir-label">取餐地点</text><text class="ir-val">{{o.pickupPoint}}</text></view>
        <view class="info-row"><text class="ir-label">取餐时间</text><text class="ir-val">{{pickupText}}</text></view>
        <view class="info-row {{!flavorsStr && !o.orderNote ? 'last' : ''}}"><text class="ir-label">联系人</text><text class="ir-val">{{o.contactName}} · {{o.maskedPhone}}</text></view>
        <view wx:if="{{flavorsStr}}" class="info-row {{!o.orderNote ? 'last' : ''}}"><text class="ir-label">口味偏好</text><text class="ir-val">{{flavorsStr}}</text></view>
        <view wx:if="{{o.orderNote}}" class="info-row last"><text class="ir-label">备注</text><text class="ir-val">{{o.orderNote}}</text></view>
      </view>

      <!-- 取消预约 -->
      <view wx:if="{{o.status === '已预约'}}" class="card action-card">
        <view class="cancel-top">
          <icon name="{{canCancel ? 'calendar' : 'warn'}}" size="18" color="{{canCancel ? '#3d6b2f' : '#b79a55'}}" />
          <view class="cancel-text">
            <view class="action-title">取消预约</view>
            <view class="cancel-desc {{canCancel ? '' : 'warn'}}">{{canCancel ? '当前可取消，款项将原路退回' : '当前状态不允许自助取消'}}</view>
          </view>
        </view>
        <view wx:if="{{canCancel}}" class="btn btn--block action-btn cancel-btn" bindtap="openCancel" hover-class="b-active" hover-stay-time="80">取消预约</view>
        <view wx:else class="btn btn--block action-btn is-disabled">不可取消</view>
      </view>

      <view wx:if="{{canSubscribeReady}}" class="card action-card">
        <view class="action-title">待取餐提醒</view>
        <view class="btn btn--ghost btn--block action-btn {{readySubscribing || readySubscribed ? 'is-disabled' : ''}}" bindtap="subscribeReady"
              hover-class="{{readySubscribing || readySubscribed ? 'none' : 'b-active'}}" hover-stay-time="80">{{readySubscribed ? '已开启提醒' : readySubscribing ? '正在开启…' : '订阅提醒'}}</view>
      </view>

      <view style="height:{{safeBottom + 30}}px"></view>
    </view>
  </scroll-view>

  <!-- 取消确认弹层：失败时保留，可直接重试 -->
  <view wx:if="{{cancelSheet}}" class="sheet-mask" bindtap="closeCancel"></view>
  <view wx:if="{{cancelSheet}}" class="sheet cancel-sheet" style="padding-bottom:{{safeBottom + 28}}px">
    <view class="cs-center">
      <view class="cs-ring"><icon name="warn" size="30" color="#b79a55" /></view>
      <view class="cs-title serif">确认取消预约？</view>
      <view class="cs-sub">取餐号 {{o.code}} · {{pickupText}} 取餐</view>
      <view class="cs-sub">取消后款项将原路退回</view>
    </view>
    <view class="cs-actions">
      <view class="btn btn--ghost cs-btn {{canceling ? 'is-disabled' : ''}}" bindtap="closeCancel" hover-class="{{canceling ? 'none' : 'b-active'}}" hover-stay-time="80">再想想</view>
      <view class="btn cs-btn cs-confirm {{canceling ? 'is-disabled' : ''}}" bindtap="doCancel" hover-class="{{canceling ? 'none' : 'b-active'}}" hover-stay-time="80">{{canceling ? '正在取消…' : '确认取消'}}</view>
    </view>
  </view>

  <toast id="toast" />
</view>
