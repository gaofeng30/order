<view class="page">
  <navbar tone="dark" overlay title="个人中心" />

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 身份卡 -->
    <view class="hero-dark id-card" style="padding-top:{{navTotal}}px">
      <view class="ring r1"></view>
      <view class="ring r2"></view>
      <view class="id-inner">
        <view class="avatar serif">林</view>
        <view class="id-body">
          <view class="id-head">
            <text class="serif id-name">{{nick}}</text>
            <pill s="已授权" tone="ok" />
          </view>
          <view class="id-sub">{{phoneMask}}</view>
        </view>
      </view>
    </view>

    <view class="pad body">
      <view class="card group">
        <view class="prow" bindtap="toOrders">
          <view class="prow-ico" style="background:var(--bg2)"><icon name="receipt" size="19" color="#467a32" /></view>
          <view class="prow-main">
            <view class="prow-label">我的订单</view>
            <view class="prow-sub">{{pend > 0 ? pend + ' 单待取/预约' : '查看全部订单'}}</view>
          </view>
          <icon name="chevron" size="17" color="#8f9384" />
        </view>
        <view class="prow">
          <view class="prow-ico" style="background:var(--bg2)"><icon name="truck" size="19" color="#9a9e8c" /></view>
          <view class="prow-main"><view class="prow-label">外卖配送</view></view>
          <view class="pill pill--mute">暂未开放</view>
        </view>
        <view class="prow last" bindtap="service">
          <view class="prow-ico" style="background:var(--bg2)"><icon name="headset" size="19" color="#2a5fa6" /></view>
          <view class="prow-main">
            <view class="prow-label">联系客服</view>
            <view class="prow-sub">0596-388 1688</view>
          </view>
          <icon name="chevron" size="17" color="#8f9384" />
        </view>
      </view>

      <view class="switch-id" bindtap="reset">切换身份入口 ›</view>
      <view style="height:{{safeBottom + 30}}px"></view>
    </view>
  </scroll-view>

  <tabbar variant="user" active="profile" />
  <toast id="toast" />
</view>
