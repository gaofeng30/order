<view class="page">
  <navbar tone="dark" overlay title="个人中心" solid="{{navSolid}}" />

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}" bindscroll="onNavScroll">
    <!-- 身份卡 -->
    <view class="hero-dark id-card" style="padding-top:{{navTotal}}px">
      <view class="ring r1"></view>
      <view class="ring r2"></view>
      <view class="id-inner">
        <view class="avatar serif">
          <text wx:if="{{avatarText}}">{{avatarText}}</text>
          <icon wx:else name="user" size="30" color="#ffffff" />
        </view>
        <view class="id-body">
          <view class="id-head">
            <text class="serif id-name">{{nick}}</text>
            <pill wx:if="{{identityState === 'ready'}}" s="{{phone ? '已绑定' : '未绑定'}}" tone="{{phone ? 'ok' : 'mute'}}" />
          </view>
          <view wx:if="{{phone}}" class="id-sub">{{phone}}</view>
        </view>
      </view>
    </view>

    <view class="pad body">
      <state wx:if="{{identityState === 'error'}}" kind="error" compact text="网络不太好，账号信息没加载出来" bind:action="reloadIdentity" />
      <view class="card group">
        <view class="prow" bindtap="toOrders" hover-class="tap-dim" hover-stay-time="80">
          <view class="prow-ico"><icon name="receipt" size="19" color="#467a32" /></view>
          <view class="prow-main">
            <view class="prow-label">我的订单</view>
            <view class="prow-sub">{{pend > 0 ? pend + ' 单待取/预约' : '查看全部订单'}}</view>
          </view>
          <icon name="chevron" size="16" color="#8f9384" />
        </view>
        <!-- 交互行：卡片是普通容器，微信按钮是它绝对定位的透明点击层。
             按钮因此完全脱离布局流，原生 margin/padding/伪边框影响不到行。 -->
        <view wx:if="{{identityState === 'ready' && !phone}}" class="prow prow--tappable">
          <view class="prow-ico"><icon name="phone" size="19" color="#467a32" /></view>
          <view class="prow-main">
            <view class="prow-label">绑定主手机号</view>
            <view wx:if="{{phoneBinding}}" class="prow-sub">正在绑定…</view>
          </view>
          <icon name="chevron" size="16" color="#8f9384" />
          <button class="prow-tap" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber"
                  hover-class="prow-tap-on" hover-stay-time="80" aria-label="绑定主手机号"></button>
        </view>
        <view class="prow prow--extra">
          <view class="prow-head">
            <view class="prow-ico"><icon name="user" size="19" color="#467a32" /></view>
            <view class="prow-main"><view class="prow-label">默认取餐姓名</view><view class="prow-sub">下单自动填写，也用于员工折扣匹配</view></view>
          </view>
          <view class="extra-panel">
            <input class="extra-in input-box name-in" maxlength="64" value="{{nameInput}}" bindinput="onNameInput"
                   placeholder="填写姓名" placeholder-class="extra-ph" disabled="{{nameSaving || identityState !== 'ready'}}" cursor-spacing="100" />
            <view class="btn btn--primary btn--block extra-save {{nameSavable && !nameSaving && identityState === 'ready' ? '' : 'is-disabled'}}"
                  bindtap="saveName" hover-class="{{nameSavable && !nameSaving ? 'b-active' : 'none'}}" hover-stay-time="80">{{nameSaving ? '保存中…' : '保存姓名'}}</view>
          </view>
        </view>
        <!-- 附加手机号：默认收起 -->
        <view class="prow prow--extra {{extraOpen ? 'is-open' : ''}}">
          <view class="prow-head" bindtap="toggleExtra" hover-class="tap-dim" hover-stay-time="80">
            <view class="prow-ico"><icon name="user" size="19" color="#467a32" /></view>
            <view class="prow-main"><view class="prow-label">附加手机号</view></view>
            <view class="extra-caret"><icon name="chevron" size="16" color="#8f9384" /></view>
          </view>
          <view wx:if="{{extraOpen}}" class="extra-panel">
            <view class="extra-result">{{extraPhone || '未设置'}}</view>
            <view class="extra-fields">
              <input class="extra-in extra-in--phone input-box" type="number" maxlength="11" data-k="phone" bindinput="onExtraInput"
                     value="{{extraForm.phone}}" placeholder="{{extraPhone || '手机号'}}" placeholder-class="extra-ph"
                     disabled="{{extraSaving || identityState !== 'ready'}}" cursor-spacing="100" />
            </view>
            <view class="prow-sub">与上方已保存姓名一起匹配员工名单，主手机号或附加手机号任意一个命中即可。</view>
            <view class="btn btn--primary btn--block extra-save {{extraSavable && !extraSaving ? '' : 'is-disabled'}}" bindtap="saveExtraPhone"
                  hover-class="{{extraSavable && !extraSaving ? 'b-active' : 'none'}}" hover-stay-time="80">{{extraSaving ? '保存中…' : '保存'}}</view>
          </view>
        </view>
        <view wx:if="{{identityState === 'ready'}}" class="prow prow--tappable">
          <view class="prow-ico"><icon name="store" size="19" color="#467a32" /></view>
          <view class="prow-main">
            <view class="prow-label">商户登录</view>
            <view class="prow-sub">{{merchantLoginState === 'loading' ? '正在验证…' : merchantLoginState === 'error' ? '商户身份未验证，可重试' : '验证商户账号手机号'}}</view>
          </view>
          <icon name="chevron" size="16" color="#8f9384" />
          <button class="prow-tap" open-type="getPhoneNumber" bindgetphonenumber="onMerchantPhone"
                  hover-class="prow-tap-on" hover-stay-time="80" aria-label="商户登录"></button>
        </view>
        <view class="prow last" bindtap="callService" hover-class="tap-dim" hover-stay-time="80">
          <view class="prow-ico"><icon name="headset" size="19" color="#467a32" /></view>
          <view class="prow-main">
            <view class="prow-label">联系客服</view>
            <view class="prow-sub tnum">{{servicePhone}}</view>
          </view>
          <icon name="chevron" size="16" color="#8f9384" />
        </view>
      </view>

      <view wx:if="{{identityState === 'ready' && merchantBound}}" class="switch-id" bindtap="reset" hover-class="tap-dim" hover-stay-time="80">切换身份入口 ›</view>
      <view class="tail-space"></view>
    </view>
  </scroll-view>

  <tabbar variant="user" active="profile" />
  <toast id="toast" />
</view>
