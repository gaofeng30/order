<view class="page">
  <navbar tone="dark" overlay title="个人中心" />

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 身份卡 -->
    <view class="hero-dark id-card" style="padding-top:{{navTotal}}px">
      <view class="ring r1"></view>
      <view class="ring r2"></view>
      <view class="id-inner">
        <view class="avatar serif" bindtap="chooseProfile">{{avatarText}}</view>
        <view class="id-body">
          <view class="id-head">
            <text class="serif id-name">{{nick}}</text>
            <pill s="{{phoneMask ? '已绑定' : '未绑定'}}" tone="{{phoneMask ? 'ok' : 'mute'}}" />
          </view>
          <view class="id-sub">{{phoneMask}}</view>
        </view>
      </view>
    </view>

    <view class="pad body">
      <view class="card group">
        <view class="prow" bindtap="toOrders">
          <view class="prow-ico" style="background:var(--bg2)"><icon name="receipt" size="19" color="#467a32" /></view>
          <view class="prow-main">
            <view class="prow-label">我的订单</view>
            <view class="prow-sub">{{pend > 0 ? pend + ' 单待取/预约' : '查看全部订单'}}</view>
          </view>
          <icon name="chevron" size="17" color="#8f9384" />
        </view>
        <button wx:if="{{!phoneMask}}" class="prow" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
          <view class="prow-main"><view class="prow-label">绑定主手机号</view></view>
        </button>
        <view class="prow">
          <view class="prow-main">
            <view class="prow-label">附加手机号</view>
            <view class="prow-sub">{{extraPhoneMask || '未设置'}}</view>
            <view wx:if="{{extraState === 'unmatched'}}" class="prow-sub">手机号已保存，姓名未匹配员工名单，请核对</view>
            <view wx:elif="{{extraState === 'matched'}}" class="prow-sub">已命中员工名单</view>
            <view wx:elif="{{extraState === 'error'}}" class="prow-sub">保存结果不可用，请重试</view>
          </view>
          <input class="extra-phone" data-k="phone" bindinput="onExtraInput" placeholder="手机号" />
          <input class="extra-name" data-k="name" bindinput="onExtraInput" placeholder="姓名" />
          <view class="extra-save" bindtap="saveExtraPhone">保存</view>
        </view>
        <button wx:if="{{identityState === 'ready'}}" class="prow merchant-login" open-type="getPhoneNumber" bindgetphonenumber="onMerchantPhone">
          <view class="prow-main">
            <view class="prow-label">商户登录</view>
            <view class="prow-sub">{{merchantLoginState === 'error' ? '商户身份未核验，可重试' : '验证商户账号手机号'}}</view>
          </view>
          <icon name="chevron" size="17" color="#8f9384" />
        </button>
        <button class="prow last" open-type="contact">
          <view class="prow-ico" style="background:var(--bg2)"><icon name="headset" size="19" color="#2a5fa6" /></view>
          <view class="prow-main">
            <view class="prow-label">联系客服</view>
            <view class="prow-sub">0596-388 1688</view>
          </view>
          <icon name="chevron" size="17" color="#8f9384" />
        </button>
      </view>

      <view wx:if="{{identityState === 'ready' && merchantBound}}" class="switch-id" bindtap="reset">切换身份入口 ›</view>
      <view style="height:{{safeBottom + 30}}px"></view>
    </view>
  </scroll-view>

  <tabbar variant="user" active="profile" />
  <toast id="toast" />
</view>
