.id-card { border-radius: 0 0 52rpx 52rpx; padding-left: 40rpx; padding-right: 40rpx; padding-bottom: 52rpx; color: #fff; }
.id-inner { display: flex; align-items: center; gap: 28rpx; position: relative; z-index: 2; }
.avatar {
  width: 120rpx; height: 120rpx; border-radius: 36rpx; background: linear-gradient(135deg, var(--green-500), var(--green)); flex: 0 0 120rpx;
  display: flex; align-items: center; justify-content: center; overflow: hidden; font-size: var(--fs-xl); font-weight: 700; color: #fff;
}
.id-body { flex: 1; min-width: 0; }
.id-head { display: flex; align-items: center; gap: 16rpx; }
.id-name { font-size: var(--fs-xl); font-weight: 700; }
.id-sub { font-size: var(--fs-sm); color: var(--ink-on-dark-2); margin-top: 10rpx; }

.body { margin-top: 28rpx; }
.group { padding: 4rpx 36rpx; margin-bottom: 24rpx; }
.prow { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 0; border-bottom: 2rpx solid var(--line-2); }
.prow.last { border-bottom: none; }
.prow-ico {
  width: 76rpx; height: 76rpx; border-radius: 22rpx; flex: 0 0 76rpx; background: var(--bg2);
  display: flex; align-items: center; justify-content: center;
}
.prow-main { flex: 1; min-width: 0; }
.prow-label { font-size: var(--fs-md); color: var(--ink); font-weight: 500; }
.prow-sub { font-size: var(--fs-sm); color: var(--ink-3); margin-top: 6rpx; }

/* 点击层：不赌能把原生 button 样式压干净，只让它不在布局流里。 */
.prow--tappable { position: relative; }
.prow-tap {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  margin: 0; padding: 0; background: transparent; border-radius: 0;
}
.prow-tap::after { border: none; display: none; }
.prow-tap-on { background: rgba(24, 36, 16, .04); }

/* 附加手机号行脱离 .prow 的单行 flex，改为可折叠的块级容器。 */
.prow--extra { display: block; }
.prow-head { display: flex; align-items: center; gap: 24rpx; }
.extra-caret { display: flex; align-items: center; transition: transform .18s ease; }
.prow--extra.is-open .extra-caret { transform: rotate(90deg); }

.extra-panel { padding: 20rpx 0 4rpx; }
.extra-result { font-size: var(--fs-sm); color: var(--ink-2); margin-bottom: 16rpx; }
.extra-fields { display: flex; gap: 20rpx; }
.extra-in { min-width: 0; height: 80rpx; }
.extra-in--phone { flex: 5 1 0; }
.extra-in--name { flex: 3 1 0; }
.extra-ph { color: var(--ink-3); }
.extra-save { margin-top: 20rpx; }

.switch-id {
  display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin-top: 20rpx;
  font-size: var(--fs-sm); color: var(--green); font-weight: 600;
}
