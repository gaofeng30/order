.detail-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; color: var(--ink-3); font-size: 25rpx; }
.detail-body { padding: 24rpx 32rpx 0; position: relative; }
.detail-gallery { position: relative; }
.detail-images, .detail-single-image { width: 100%; height: 480rpx; border-radius: 22rpx; overflow: hidden; }
.detail-images image { width: 100%; height: 100%; }
.image-count { position: absolute; right: 20rpx; bottom: 18rpx; padding: 6rpx 16rpx; border-radius: 999rpx; background: rgba(0, 0, 0, .55); color: #fff; font-size: 22rpx; font-variant-numeric: tabular-nums; }
.info-card { padding: 36rpx; }
.info-name { font-size: 46rpx; font-weight: 700; color: var(--ink); }
.info-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.staff-price-label { font-size: 20rpx; color: var(--green-1); background: var(--green-bg); border-radius: 8rpx; padding: 4rpx 10rpx; }
.original-price { font-size: 24rpx; color: var(--ink-3); text-decoration: line-through; }
.info-desc { font-size: 27rpx; color: var(--ink-2); margin-top: 28rpx; line-height: 1.75; }

.spec-card { padding: 8rpx 36rpx 32rpx; margin-top: 24rpx; }
.spec-text { font-size: 27rpx; color: var(--ink); line-height: 1.7; }
.local-card { padding: 28rpx 36rpx; margin-top: 24rpx; display: flex; align-items: center; gap: 14rpx; font-size: 24rpx; color: var(--ink-2); }

.bottom-bar {
  flex: 0 0 auto; padding: 20rpx 32rpx; background: rgba(255, 255, 255, .98);
  border-top: 1rpx solid var(--line); display: flex; align-items: center; gap: 28rpx;
}
.have-qty { font-size: 23rpx; color: var(--ink-3); display: flex; flex-direction: column; line-height: 1.3; }
.have-num { font-size: 32rpx; color: var(--ink); font-weight: 700; }
.addcart-btn { flex: 1; }
