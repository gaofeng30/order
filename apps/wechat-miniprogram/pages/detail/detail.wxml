<view class="page">
  <navbar tone="light" title="商品详情" back />

  <view wx:if="{{detailState === 'loading'}}" class="detail-state">商品加载中…</view>
  <view wx:elif="{{detailState === 'not_found'}}" class="detail-state">商品不存在</view>
  <view wx:elif="{{detailState === 'error'}}" class="detail-state">
    <text>商品加载失败</text>
    <view class="btn btn--ghost-blue btn--sm" bindtap="retryProduct">重试</view>
  </view>

  <block wx:elif="{{detailState === 'ready'}}">
    <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="detail-body">
        <view class="card info-card">
          <view class="info-name serif">{{m.name}}</view>
          <view class="info-price"><money v="{{m.price_text}}" size="60" /></view>
          <view class="info-desc">{{m.description}}</view>
        </view>

        <view class="card spec-card">
          <view class="sec-h" style="padding-bottom:12rpx"><text class="t" style="font-size:30rpx">规格信息</text></view>
          <view class="spec-text">{{m.specification}}</view>
        </view>

        <view class="card local-card">
          <icon name="cart" size="16" color="#467a32" />
          <text>目录仅供浏览与本地选择</text>
        </view>
      </view>
      <view style="height:40rpx"></view>
    </scroll-view>

    <view class="bottom-bar" style="padding-bottom:{{safeBottom + 20}}px">
      <stepper wx:if="{{qty > 0}}" value="{{qty}}" bind:sub="sub" bind:add="add" />
      <view wx:else class="have-qty">尚未选择</view>
      <view class="btn btn--block btn--primary addcart-btn" bindtap="openCustomize">选择 · <money v="{{m.price_text}}" color="#ffffff" size="30" /></view>
    </view>

    <customize visible="{{czVisible}}" item="{{m}}" init="{{czInit}}" bind:close="onCzClose" bind:confirm="onCzConfirm" />
  </block>

  <toast id="toast" />
</view>
