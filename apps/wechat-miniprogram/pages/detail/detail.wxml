<view class="page">
  <navbar tone="light" title="商品详情" back />

  <view wx:if="{{detailState === 'loading'}}" class="detail-state">
    <state kind="loading" text="菜品加载中" />
  </view>
  <view wx:elif="{{detailState === 'not_found'}}" class="detail-state">
    <state kind="empty" icon="bowl" text="这道菜不存在或已下架" action="返回菜单" bind:action="backToMenu" />
  </view>
  <view wx:elif="{{detailState === 'selection_required'}}" class="detail-state">
    <state kind="empty" icon="calendarClock" text="请先在菜单选择取餐时间" action="返回菜单" bind:action="backToMenu" />
  </view>
  <view wx:elif="{{detailState === 'error'}}" class="detail-state">
    <state kind="error" text="网络不太好，菜品没加载出来" bind:action="retryProduct" />
  </view>

  <block wx:elif="{{detailState === 'ready'}}">
    <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="detail-body">
        <!-- 主图 1:1（E7）；加载失败退回首字占位（D12） -->
        <view wx:if="{{m.images.length > 1}}" class="detail-gallery">
          <swiper class="detail-images" circular="{{false}}" autoplay="{{false}}" current="{{imageIndex}}" bindchange="onImageChange">
            <swiper-item wx:for="{{m.images}}" wx:key="objectKey">
              <image
                wx:if="{{!imgFailed[index]}}"
                class="detail-img"
                src="{{item.url}}"
                mode="aspectFill"
                data-url="{{item.url}}"
                data-idx="{{index}}"
                bindtap="previewImage"
                binderror="onImageError"
              />
              <imageph wx:else item="{{phItem}}" h="{{686}}" radius="{{0}}" tag="{{false}}" />
            </swiper-item>
          </swiper>
          <view class="image-count tnum">{{imageIndex + 1}} / {{m.images.length}}</view>
        </view>
        <view wx:elif="{{m.images.length === 1}}" class="detail-gallery">
          <image
            wx:if="{{!imgFailed[0]}}"
            class="detail-img"
            src="{{m.images[0].url}}"
            mode="aspectFill"
            data-url="{{m.images[0].url}}"
            data-idx="{{0}}"
            bindtap="previewImage"
            binderror="onImageError"
          />
          <imageph wx:else item="{{phItem}}" h="{{686}}" radius="{{0}}" tag="{{false}}" />
        </view>
        <view wx:else class="detail-gallery">
          <imageph item="{{phItem}}" h="{{686}}" radius="{{0}}" tag="{{false}}" />
        </view>

        <view class="card info-card">
          <view class="info-name serif">{{m.name}}</view>
          <view class="info-price">
            <view wx:if="{{m.isStaffPrice}}" class="staff-price-label">员工价</view>
            <money v="{{m.price_text}}" size="60" staff="{{m.isStaffPrice}}" />
            <text wx:if="{{m.isStaffPrice}}" class="original-price">¥{{m.original_price_text}}</text>
          </view>
          <view wx:if="{{m.description}}" class="info-desc">{{m.description}}</view>
        </view>

        <!-- 无规格信息时不显示（U22） -->
        <view wx:if="{{m.specification}}" class="card spec-card">
          <view class="sec-h spec-h"><text class="t">规格信息</text></view>
          <view class="spec-text">{{m.specification}}</view>
        </view>

        <!-- 取餐时段（U21） -->
        <view class="card period-card">
          <icon name="calendar" size="16" color="#467a32" />
          <text class="period-lbl">取餐时段</text>
          <text class="period-val">{{periodLabel}}</text>
        </view>
      </view>
      <view class="detail-tail"></view>
    </scroll-view>

    <!-- 底栏：左价格，右「+」，加购后换成步进器；不能下单时价格下方写明原因（U20） -->
    <view class="bottom-bar" style="padding-bottom:{{safeBottom + 20}}px">
      <view class="bar-price">
        <view class="bar-price-row">
          <view wx:if="{{m.isStaffPrice}}" class="staff-price-label">员工价</view>
          <money v="{{m.price_text}}" size="36" staff="{{m.isStaffPrice}}" />
          <text wx:if="{{m.isStaffPrice}}" class="original-price">¥{{m.original_price_text}}</text>
        </view>
        <view wx:if="{{!orderable}}" class="bar-reason">{{reason}}</view>
      </view>
      <stepper wx:if="{{qty > 0}}" value="{{qty}}" bind:sub="sub" bind:add="add" />
      <view
        wx:else
        class="add-btn {{orderable ? '' : 'is-disabled'}}"
        catchtap="openCustomize"
        hover-stop-propagation="{{true}}" hover-class="tap-dim"
        hover-stay-time="80"
        aria-role="button"
        aria-label="加入购物车"
      >
        <view class="add-dot"><icon name="plus" size="14" color="{{orderable ? '#ffffff' : '#9a9e8c'}}" stroke="2.4" /></view>
      </view>
    </view>

    <customize visible="{{czVisible}}" item="{{m}}" init="{{czInit}}" flavor-options="{{flavors}}" bind:close="onCzClose" bind:confirm="onCzConfirm" />
  </block>

  <toast id="toast" />
</view>
