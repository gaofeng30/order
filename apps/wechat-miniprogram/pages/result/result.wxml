<view class="page">
  <navbar tone="light" title="{{navTitle}}" />

  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="success fade-up">
      <view class="success-ring"><icon name="{{ringIcon}}" size="{{ringSize}}" color="#ffffff" stroke="2.6" /></view>
      <view class="success-title serif">{{mainTitle}}</view>
      <view class="success-sub">{{sub}}</view>
    </view>

    <view class="hero-dark code-card">
      <view class="ring r1"></view>
      <view class="ring r2"></view>
      <view class="code-inner">
        <view class="code-lbl">{{codeLbl}}</view>
        <view class="code-big serif">{{o.code}}</view>
        <view class="code-no">订单号 {{o.no}}</view>
        <view class="code-foot">
          <icon name="{{footIcon}}" size="14" color="#9fd3ff" />
          <text>{{footText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{canSubscribeReady}}" class="card reminder-card">
      <view class="reminder-title">餐品备好时提醒你</view>
      <button class="btn btn--primary ready-reminder-btn" bindtap="requestReadySubscription"
        disabled="{{readySubscriptionState === 'requesting' || readySubscriptionState === 'accepted'}}">
        {{readySubscriptionState === 'accepted' ? '已开启取餐提醒' : readySubscriptionState === 'requesting' ? '正在开启' : '开启取餐提醒'}}
      </button>
      <view wx:if="{{readySubscriptionState === 'rejected'}}" class="reminder-hint">未开启提醒，可在订单中查看进度</view>
      <view wx:if="{{readySubscriptionState === 'error'}}" class="reminder-hint">提醒暂未开启，请重试</view>
    </view>
  </scroll-view>

  <view class="bottom-bar" style="padding-bottom:{{safeBottom + 20}}px">
    <view class="btn btn--ghost result-btn" bindtap="goHome">返回首页</view>
    <view class="btn btn--primary result-btn primary" bindtap="viewCode">{{viewBtn}}</view>
  </view>
</view>
