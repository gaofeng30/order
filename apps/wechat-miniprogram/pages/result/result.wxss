.success { text-align: center; padding: 48rpx 0 16rpx; }
.success-ring {
  width: 148rpx; height: 148rpx; border-radius: 50%; background: var(--green); margin: 0 auto;
  display: flex; align-items: center; justify-content: center; box-shadow: 0 24rpx 60rpx rgba(61, 107, 47, .35);
}
.success-title { font-size: 46rpx; font-weight: 700; color: var(--ink); margin-top: 32rpx; }
.success-sub { font-size: 26rpx; color: var(--ink-2); margin-top: 14rpx; }

.code-card { padding: 44rpx; color: #fff; margin-top: 28rpx; }
.code-inner { position: relative; z-index: 2; text-align: center; }
.code-lbl { font-size: 22rpx; letter-spacing: 8rpx; color: var(--gold); }
.code-big { font-size: 128rpx; font-weight: 900; letter-spacing: 8rpx; line-height: 1.1; margin: 16rpx 0; }
.code-no { font-size: 24rpx; color: var(--ink-on-dark-2); }
.code-foot {
  margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255, 255, 255, .14);
  font-size: 25rpx; color: #9fd3ff; display: flex; align-items: center; justify-content: center; gap: 12rpx;
}

.bottom-bar { flex: 0 0 auto; padding: 20rpx 32rpx; display: flex; gap: 24rpx; }
.result-btn { flex: 1; }
.result-btn.primary { flex: 1.4; }
