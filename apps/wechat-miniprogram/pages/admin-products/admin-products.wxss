.top-area { padding-top: 4rpx; padding-bottom: 16rpx; }
.search-box {
  height: 76rpx; border-radius: 999rpx; background: #fff; box-shadow: inset 0 0 0 2rpx var(--line);
  display: flex; align-items: center; gap: 16rpx; padding: 0 28rpx;
}
.search-ph { font-size: 26rpx; color: var(--ink-3); }

.new-banner {
  margin-top: 20rpx; height: 104rpx; border-radius: 28rpx; position: relative; overflow: hidden;
  background: linear-gradient(135deg, #123f7e, #0b2f63); display: flex; align-items: center; gap: 24rpx; padding: 0 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(11, 47, 99, .22);
}
.nb-ring { position: absolute; right: -36rpx; top: -36rpx; width: 160rpx; height: 160rpx; border-radius: 50%; border: 3rpx solid rgba(255, 255, 255, .12); }
.nb-ico { width: 68rpx; height: 68rpx; border-radius: 20rpx; background: rgba(255, 255, 255, .16); display: flex; align-items: center; justify-content: center; flex: 0 0 68rpx; }
.nb-body { flex: 1; position: relative; z-index: 2; }
.nb-title { font-size: 30rpx; font-weight: 600; color: #fff; letter-spacing: 1rpx; }
.nb-sub { font-size: 22rpx; color: rgba(255, 255, 255, .7); margin-top: 4rpx; }

.cat-nav { padding: 0 24rpx 16rpx; border-bottom: 1rpx solid var(--line); }

.prod { padding: 24rpx; margin-top: 24rpx; display: flex; gap: 24rpx; }
.prod.off { opacity: .66; }
.prod-pic { position: relative; }
.prod-mask {
  position: absolute; inset: 0; background: rgba(40, 44, 30, .5); border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center; color: #fff; font-size: 24rpx; font-weight: 600;
}
.prod-info { flex: 1; min-width: 0; }
.prod-head { display: flex; align-items: center; gap: 14rpx; }
.prod-name { font-size: 29rpx; font-weight: 600; color: var(--ink); }
.prod-meta { display: flex; align-items: center; gap: 24rpx; margin-top: 14rpx; font-size: 24rpx; color: var(--ink-3); }
.prod-imgs { font-size: 21rpx; color: var(--blue-500); background: var(--blue-bg); padding: 2rpx 12rpx; border-radius: 10rpx; }
.prod-actions { display: flex; align-items: center; gap: 28rpx; margin-top: 20rpx; }
.pa-soldout { font-size: 25rpx; color: var(--gold-2); font-weight: 600; }
.pa-soldout.green { color: var(--green-600); }
.pa-edit { font-size: 25rpx; color: var(--ink-2); }
.pa-shelf { margin-left: auto; display: flex; align-items: center; gap: 14rpx; }
.pa-shelf-lbl { font-size: 23rpx; color: var(--ink-3); }

/* 软开关 (蓝) */
.toggle { width: 88rpx; height: 52rpx; border-radius: 999rpx; background: #d8d8cd; position: relative; transition: .18s; }
.toggle.on { background: var(--blue-500); }
.toggle-knob { position: absolute; top: 6rpx; left: 6rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: #fff; transition: .18s; box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .25); }
.toggle.on .toggle-knob { left: 42rpx; }
