<view class="page">
  <navbar tone="light" title="菜品管理" />

  <view class="pad top-area">
    <view class="day-line">{{title}}</view>
    <view class="search-box">
      <icon name="search" size="16" color="#8f9384" />
      <input
        class="search-in"
        placeholder="搜索菜品名称"
        placeholder-class="search-ph"
        value="{{search}}"
        bindinput="onSearch"
        confirm-type="search"
      />
      <view
        wx:if="{{search}}"
        class="search-clear"
        bindtap="clearSearch"
        hover-class="tap-dim"
        hover-stay-time="80"
        aria-role="button"
        aria-label="清空搜索"
      ><icon name="close" size="20" color="#8f9384" /></view>
    </view>
  </view>

  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <state wx:if="{{listState === 'loading'}}" kind="loading" text="正在读取今天的菜品" />
    <state wx:elif="{{listState === 'error'}}" kind="error" text="网络不太好，菜品没加载出来" bind:action="retry" />
    <state wx:elif="{{listState === 'empty'}}" kind="empty" icon="box" text="今天没有可设置的菜品" />
    <state wx:elif="{{listState === 'nomatch'}}" kind="empty" icon="search" text="没有找到「{{search}}」" action="清空搜索" bind:action="clearSearch" />

    <block wx:else>
      <!-- 按分类分组，顺序同用户端菜单（A23） -->
      <view wx:for="{{groups}}" wx:for-item="group" wx:key="id">
        <view class="group-h">{{group.name}} · {{group.items.length}}</view>
        <view class="card group-card">
          <view
            wx:for="{{group.items}}"
            wx:key="id"
            class="prod {{index === group.items.length - 1 ? 'last' : ''}}"
          >
            <view class="prod-pic">
              <imageph item="{{item}}" h="112" w="112" radius="20" tag="{{false}}" lazy="{{true}}" />
              <view wx:if="{{item.soldOut}}" class="prod-mask">售罄</view>
            </view>
            <view class="prod-info">
              <view class="prod-name ellipsis-2">{{item.name}}</view>
              <view class="prod-price"><money v="{{item.price}}" size="28" /></view>
            </view>
            <!-- 售罄开关：开 = 绿色可售，关 = 红色售罄（A22） -->
            <view
              class="sw {{item.saving ? 'is-saving' : ''}}"
              data-id="{{item.id}}"
              catchtap="toggle"
              hover-stop-propagation="{{true}}" hover-class="{{item.saving ? 'none' : 'tap-dim'}}"
              hover-stay-time="80"
              aria-role="switch"
              aria-checked="{{!item.soldOut}}"
              aria-disabled="{{item.saving}}"
              aria-label="{{item.name}}，{{item.soldOut ? '售罄' : '可售'}}"
            >
              <text class="sw-text {{item.soldOut ? 'off' : 'on'}}">{{item.soldOut ? '售罄' : '可售'}}</text>
              <view class="toggle {{item.soldOut ? 'off' : 'on'}}"><view class="toggle-knob"></view></view>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view class="tail-space"></view>
  </scroll-view>

  <tabbar variant="admin" active="admin-products" />
  <toast id="toast" />
</view>
