/* 取餐方式 */
.mode-card { padding: 28rpx 32rpx 32rpx; color: #fff; margin-top: 8rpx; }


.mode-reserve { position: relative; z-index: 2; margin-top: 26rpx; }
.rsv-label { font-size: 24rpx; color: var(--ink-on-dark-2); margin-bottom: 16rpx; }
.rsv-warn { display: flex; align-items: center; gap: 12rpx; font-size: 23rpx; color: #9fd3ff; margin-top: 22rpx; }

/* 取餐窗口 */
.sec-card { padding: 4rpx 36rpx; margin-top: 24rpx; }
.win-h { padding-bottom: 4rpx; }
.win-pill { margin-left: auto; }
.win-row { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; }
.win-ico {
  width: 76rpx; height: 76rpx; border-radius: 22rpx; flex: 0 0 76rpx; background: var(--green-bg);
  display: flex; align-items: center; justify-content: center;
}
.win-info { flex: 1; min-width: 0; }
.win-name { font-size: 29rpx; color: var(--ink); font-weight: 600; }
.win-sub { font-size: 24rpx; color: var(--ink-3); margin-top: 6rpx; }

/* 商品明细 */
.ci-item { display: flex; align-items: flex-start; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--line-2); }
.ci-info { flex: 1; min-width: 0; }
.ci-top { display: flex; align-items: center; gap: 16rpx; }
.ci-name { font-size: 28rpx; color: var(--ink); font-weight: 500; }
.ci-edit { margin-left: auto; flex: 0 0 auto; font-size: 24rpx; color: var(--blue-500); display: flex; align-items: center; gap: 6rpx; }
.ci-unit { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx; font-size: 23rpx; color: var(--ink-3); margin-top: 4rpx; }
.staff-price-label { font-size: 19rpx; color: var(--green-1); background: var(--green-bg); border-radius: 8rpx; padding: 3rpx 8rpx; }
.original-price { font-size: 21rpx; color: var(--ink-3); text-decoration: line-through; }
.ci-prefs { margin-top: 12rpx; display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.pref-chip { font-size: 21rpx; color: var(--gold-2); background: var(--gold-bg); padding: 4rpx 16rpx; border-radius: 12rpx; }
.pref-note { font-size: 22rpx; color: var(--ink-2); }
.ci-empty { margin-top: 12rpx; font-size: 23rpx; color: var(--ink-3); }

/* 联系信息 */
.field { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid var(--line-2); }
.field.last { border-bottom: none; }
.field-lbl { font-size: 27rpx; color: var(--ink-2); width: 120rpx; }
.field-in { flex: 1; font-size: 28rpx; color: var(--ink); }
.ph { color: var(--ink-3); }

/* 应付 + 支付 */
.bottom-bar {
  flex: 0 0 auto; padding: 20rpx 32rpx; background: rgba(255, 255, 255, .98);
  border-top: 1rpx solid var(--line); display: flex; align-items: center; gap: 28rpx;
}
.pay-amount { flex: 1; }
.pay-lbl { font-size: 24rpx; color: var(--ink-3); display: block; margin-bottom: 2rpx; }
.pay-btn { min-width: 300rpx; }

/* ---------- 金额明细 ---------- */
.amount-card { padding-bottom: 10rpx; }
.pm-row { display: flex; align-items: center; gap: 14rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--line-2); }
.pm-row:last-child { border-bottom: none; }
.pm-k { font-size: 26rpx; color: var(--ink-2); }
.pm-v { margin-left: auto; font-size: 27rpx; color: var(--ink); font-weight: 600; }
.rsv-picked {
  display: flex; align-items: center; gap: 14rpx; margin-top: 14rpx;
  padding: 22rpx 24rpx; border-radius: 16rpx; background: rgba(255, 255, 255, .1);
}
.rsv-picked-t { flex: 1; font-size: 30rpx; color: #fff; font-weight: 600; letter-spacing: 1rpx; }
.rsv-picked-edit { font-size: 24rpx; color: #9fd3ff; }
