<view class="page">
  <navbar tone="light" title="确认订单" back />

  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 取餐方式 -->
    <view class="hero-dark mode-card">
      <view class="ring r2"></view>
      <view class="mode-reserve">
        <view class="rsv-label">取餐时间</view>
        <view class="rsv-picked" bindtap="editPickup">
          <icon name="calendarClock" size="16" color="#9fd3ff" />
          <text class="rsv-picked-t">{{pickup.label}}</text>
          <text class="rsv-picked-edit">修改</text>
        </view>
        <view wx:if="{{!pickup}}" class="rsv-warn"><icon name="warn" size="13" color="#f0c674" /><text>请返回菜单选择取餐时间</text></view>
        <view wx:else class="rsv-warn"><icon name="warn" size="13" color="#9fd3ff" /><text>支付前由服务端重新核验餐段与可售状态</text></view>
      </view>
    </view>

    <!-- 取餐窗口 -->
    <view class="card sec-card">
      <view class="sec-h win-h"><text class="t" style="font-size:30rpx">取餐窗口</text><view class="pill pill--info win-pill">到店自提</view></view>
      <view class="win-row">
        <view class="win-ico"><icon name="store" size="19" color="#467a32" /></view>
        <view class="win-info">
          <view class="win-name">{{quote ? quote.pickup.point : '以服务端报价为准'}}</view>
          <view class="win-sub">{{quote ? quote.store.address : ''}}</view>
        </view>
      </view>
    </view>

    <!-- 商品明细 -->
    <view class="card sec-card">
      <view class="sec-h" style="padding-bottom:4rpx"><text class="t" style="font-size:30rpx">商品明细</text><text class="faint" style="font-size:23rpx">共 {{count}} 件 · 口味/备注按菜品填写</text></view>
      <view class="snapshot-notice faint" style="padding:18rpx 0;line-height:1.6;border-bottom:1rpx solid #ececdf">购物车只保存选择；价格、员工身份、售罄与截单均以服务端 Quote 为准。</view>
      <view wx:for="{{items}}" wx:for-item="ci" wx:key="item.id" class="ci-item">
        <view class="ci-info">
          <view class="ci-top">
            <text class="ci-name">{{ci.item.name}}</text>
            <view class="ci-edit" data-id="{{ci.item.id}}" catchtap="editItem"><icon name="edit" size="12" color="#2a5fa6" />口味/备注</view>
          </view>
          <view class="ci-unit">
            <text wx:if="{{ci.item.isStaffPrice}}" class="staff-price-label">员工价</text>
            <text>¥{{ci.item.price_text}} × {{ci.q}}</text>
            <text wx:if="{{ci.item.isStaffPrice}}" class="original-price">原价 ¥{{ci.item.original_price_text}}</text>
          </view>
          <view wx:if="{{ci.flavors.length || ci.note}}" class="ci-prefs">
            <text wx:for="{{ci.flavors}}" wx:for-item="f" wx:key="*this" class="pref-chip">{{f}}</text>
            <text wx:if="{{ci.note}}" class="pref-note">“{{ci.note}}”</text>
          </view>
          <view wx:else class="ci-empty">未填写 · 点右上添加</view>
        </view>
        <money v="{{ci.line_total_text}}" size="30" />
      </view>
    </view>

    <view class="card sec-card amount-card">
      <view class="pm-row">
        <text class="pm-k">商品小计</text>
        <text class="pm-v tnum">¥{{subtotal_text}}</text>
      </view>
      <view wx:if="{{quote && quote.discount_cents > 0}}" class="pm-row">
        <text class="pm-k">员工折扣</text><text class="pm-v tnum">-¥{{quote.discount_cents}}</text>
      </view>
    </view>

    <!-- 联系信息 -->
    <view class="card sec-card">
      <view class="sec-h" style="padding-bottom:4rpx"><text class="t" style="font-size:30rpx">联系信息</text></view>
      <view class="field">
        <text class="field-lbl">联系人</text>
        <input class="field-in" placeholder="请填写取餐人姓名" placeholder-class="ph" data-k="contact" value="{{form.contact}}" bindinput="onInput" />
      </view>
      <view class="field last">
        <text class="field-lbl">手机号</text>
        <text class="field-in">{{maskedPhone || '未绑定'}}</text>
      </view>
      <button wx:if="{{phoneState !== 'bound'}}" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">绑定微信手机号</button>
      <view class="field"><text class="field-lbl">附加手机号</text><input class="field-in" type="number" data-k="extraPhone" value="{{form.extraPhone}}" bindinput="onInput" /><view bindtap="saveExtraPhone">保存</view></view>
      <view class="field last"><text class="field-lbl">整单备注</text><input class="field-in" data-k="orderNote" value="{{form.orderNote}}" bindinput="onInput" /></view>
    </view>
    <view style="height:24rpx"></view>
  </scroll-view>

  <!-- 应付 + 支付 -->
  <view class="bottom-bar" style="padding-bottom:{{safeBottom + 20}}px">
    <view class="pay-amount">
      <text class="pay-lbl">{{payLabel}}</text>
      <money v="{{payable_text}}" size="48" />
    </view>
    <view class="btn btn--primary pay-btn" bindtap="pay">{{payBtn}}</view>
  </view>

  <!-- 口味/备注 编辑弹层 -->
  <toast id="toast" />
  <customize
    visible="{{czVisible}}"
    item="{{czItem}}"
    init="{{czInit}}"
    flavor-options="{{flavors}}"
    confirm-label="保存"
    bind:close="onCzClose"
    bind:confirm="onCzConfirm"
  />
</view>
