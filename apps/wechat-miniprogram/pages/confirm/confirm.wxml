<view class="page">
  <navbar tone="light" title="确认本单" back />

  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 取餐时间 -->
    <view class="hero-dark mode-card">
      <view class="ring r2"></view>
      <view class="mode-reserve">
        <view class="rsv-label">{{pickup.periodLabel}} · 取餐时间</view>
        <view class="rsv-picked" bindtap="editPickup" hover-class="{{editingLocked ? 'none' : 'tap-dim'}}" hover-stay-time="80">
          <icon name="calendarClock" size="16" color="#b79a55" />
          <text class="rsv-picked-t">{{pickup ? pickup.label : '请先选择用餐时段'}}</text>
          <text wx:if="{{!editingLocked && pickup}}" class="rsv-picked-edit">{{pickup.timeConfirmed ? '修改' : '选择'}}</text>
        </view>
        <view wx:if="{{!pickup || pickupState === 'empty'}}" class="rsv-warn" bindtap="editMenu"><icon name="warn" size="13" color="#b79a55" /><text>该餐段不可选，点此返回菜单选择</text></view>
      </view>
    </view>

    <!-- 取餐窗口 -->
    <view class="card sec-card">
      <view class="sec-h win-h"><text class="t">取餐窗口</text><view class="pill pill--info">到店自提</view></view>
      <view class="win-row">
        <view class="win-ico"><icon name="store" size="19" color="#467a32" /></view>
        <view class="win-info">
          <view class="win-name">{{quote ? quote.pickup.point : storePoint || '到店自提'}}</view>
          <view wx:if="{{quote ? quote.store.address : storeAddress}}" class="win-sub">{{quote ? quote.store.address : storeAddress}}</view>
        </view>
      </view>
    </view>

    <!-- 商品明细 -->
    <view class="card sec-card">
      <view class="sec-h list-h"><text class="t">商品明细</text><text class="list-h-sub">共 {{count}} 件</text></view>
      <view wx:for="{{items}}" wx:for-item="ci" wx:key="id" class="ci-item {{index === items.length - 1 ? 'last' : ''}} {{ci.unavailableLabel ? 'is-off' : ''}}">
        <view class="ci-thumb"><imageph item="{{ci.item}}" h="96" w="96" radius="16" tag="{{false}}" /></view>
        <view class="ci-info">
          <view class="ci-top">
            <text class="ci-name">{{ci.item.name}}</text>
            <view wx:if="{{!editingLocked && !ci.unavailableLabel}}" class="ci-edit" data-id="{{ci.id}}" catchtap="editItem" hover-stop-propagation="{{true}}" hover-class="tap-dim" hover-stay-time="80"><icon name="edit" size="14" color="#3d6b2f" />口味/备注</view>
            <view wx:if="{{!editingLocked && ci.unavailableLabel}}" class="ci-edit" data-id="{{ci.id}}" catchtap="removeItem" hover-stop-propagation="{{true}}" hover-class="tap-dim" hover-stay-time="80">移除</view>
          </view>
          <view class="ci-unit">
            <view wx:if="{{ci.item.isStaffPrice}}" class="staff-price-label">员工价</view>
            <money v="{{ci.item.price_text}}" size="28" staff="{{ci.item.isStaffPrice}}" />
            <text wx:if="{{ci.item.isStaffPrice}}" class="original-price">¥{{ci.item.original_price_text}}</text>
            <text class="ci-qty">× {{ci.q}}</text>
          </view>
          <view wx:if="{{ci.flavors.length || ci.note}}" class="ci-prefs">
            <text wx:for="{{ci.flavors}}" wx:for-item="f" wx:key="*this" class="pref-chip">{{f}}</text>
            <text wx:if="{{ci.note}}" class="pref-note">“{{ci.note}}”</text>
          </view>
          <view wx:else class="ci-empty">未填写口味/备注</view>
        </view>
        <text wx:if="{{ci.unavailableLabel}}" class="ci-off-label">{{ci.unavailableLabel}}</text>
        <money wx:else v="{{ci.line_total_text}}" size="28" />
      </view>
    </view>

    <view class="card sec-card amount-card">
      <view class="pm-row">
        <text class="pm-k">{{quote ? '商品原价' : '商品预估'}}</text>
        <text class="pm-v tnum">¥{{subtotal_text}}</text>
      </view>
      <view wx:if="{{quote && quote.discount_cents > 0}}" class="pm-row">
        <text class="pm-k">员工折扣</text><text class="pm-v tnum">-¥{{discount_text}}</text>
      </view>
    </view>

    <view wx:if="{{quoteError || cartEmpty}}" class="card quote-error">
      <text>{{cartEmpty ? '购物车已清空，请返回菜单选择菜品' : quoteError}}</text>
      <view wx:if="{{selectionUnavailable || cartEmpty}}" class="btn btn--ghost btn--sm quote-error-btn" bindtap="editMenu" hover-class="b-active" hover-stay-time="80">返回菜单重新选择</view>
    </view>

    <!-- 联系信息 -->
    <view class="card sec-card">
      <view class="sec-h list-h"><text class="t">联系信息</text></view>
      <view class="field">
        <text class="field-lbl">联系人</text>
        <input class="field-in input-box {{editingLocked ? 'is-locked' : ''}}" disabled="{{editingLocked}}" maxlength="64"
               confirm-type="next" cursor-spacing="100" placeholder="请填写取餐人姓名" placeholder-class="ph"
               data-k="contact" value="{{form.contact}}" bindinput="onInput" bindconfirm="focusNote" />
      </view>
      <view class="field">
        <text class="field-lbl">手机号</text>
        <text class="field-val">{{phoneState === 'loading' ? '加载中' : phoneState === 'binding' ? '绑定中' : phoneState === 'unavailable' || phoneState === 'unauthenticated' ? '暂时没读到' : phone || '未绑定'}}</text>
        <!-- 读取失败时给重试，不诱导已绑定的用户重复授权 -->
        <view wx:if="{{!editingLocked && (phoneState === 'unavailable' || phoneState === 'unauthenticated')}}"
              class="capsule" bindtap="refreshPhone" hover-class="b-active" hover-stay-time="80" aria-role="button">重试</view>
        <button wx:if="{{!editingLocked && phoneState === 'unbound'}}"
                class="capsule" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber"
                hover-class="b-active" hover-stay-time="80">微信授权</button>
      </view>
      <view wx:if="{{extraPhone}}" class="field">
        <text class="field-lbl">附加手机号</text>
        <text class="field-val">{{extraPhone}}</text>
      </view>
      <view class="field last">
        <text class="field-lbl">整单备注</text>
        <input class="field-in input-box {{editingLocked ? 'is-locked' : ''}}" disabled="{{editingLocked}}" confirm-type="done"
               cursor-spacing="100" focus="{{noteFocus}}" placeholder="选填" placeholder-class="ph"
               data-k="orderNote" value="{{form.orderNote}}" bindinput="onInput" bindblur="onNoteBlur" />
      </view>
    </view>
    <view class="scroll-end"></view>
  </scroll-view>

  <!-- 应付 + 支付 -->
  <view class="bottom-bar" style="padding-bottom:{{safeBottom + 20}}px">
    <view wx:if="{{payNote}}" class="pay-note">{{payNote}}</view>
    <view class="bar-row">
      <view class="pay-amount">
        <view class="pay-lbl-row">
          <text class="pay-lbl">{{payLabel}}</text>
          <text class="pay-hint">以支付时价格为准</text>
        </view>
        <money v="{{payable_text}}" size="44" />
      </view>
      <view class="btn btn--primary pay-btn {{payDisabled ? 'is-disabled' : ''}}" bindtap="pay"
            hover-class="{{payDisabled ? 'none' : 'b-active'}}" hover-stay-time="80">{{cartEmpty ? '请先选择菜品' : !editingLocked && (!pickup.timeConfirmed || pickupState !== 'ready') ? '请选择取餐时间' : payBtn}}</view>
    </view>
  </view>

  <!-- 口味/备注 编辑弹层 -->
  <toast id="toast" />
  <view wx:if="{{pickerVisible}}">
    <view class="sheet-mask" catchtap="closePicker"></view>
    <view class="sheet time-sheet">
      <view class="time-head">
        <text class="serif">选择取餐时间</text>
        <view class="sheet-close" catchtap="closePicker" aria-role="button" aria-label="关闭"><icon name="close" size="20" color="#8f9384" /></view>
      </view>
      <view wx:if="{{pickup}}" class="time-context">{{pickup.periodLabel}}</view>
      <state wx:if="{{pickupState === 'loading'}}" kind="loading" text="正在加载可选时间" />
      <state wx:elif="{{pickupState === 'error'}}" kind="error" text="时间暂时没加载出来" bind:action="loadPickupTimes" />
      <state wx:elif="{{pickupState === 'empty'}}" kind="empty" text="该餐段已不可选" action="返回菜单选择" bind:action="editMenu" />
      <scroll-view wx:else scroll-y class="time-body">
        <view class="time-options">
          <view wx:for="{{pickupTimes}}" wx:key="*this"
            class="time-option tnum {{pickup.timeConfirmed && pickup.time === item ? 'on' : ''}}"
            data-time="{{item}}" catchtap="pickPickupTime" aria-role="button"
            hover-class="tap-dim" hover-stay-time="80">{{item}}</view>
        </view>
      </scroll-view>
      <view style="height:{{safeBottom}}px"></view>
    </view>
  </view>
  <customize
    visible="{{czVisible}}"
    item="{{czItem}}"
    init="{{czInit}}"
    flavor-options="{{flavors}}"
    confirm-label="保存"
    bind:close="onCzClose"
    bind:confirm="onCzConfirm"
  />
</view>
