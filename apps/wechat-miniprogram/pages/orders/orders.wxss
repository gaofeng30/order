/* 分段容器不再加左右留白，两端留白由 .segs 负责（D36） */
.filter { padding: 0 0 8rpx; border-bottom: 2rpx solid var(--line); }
/* 分段视觉 64rpx，上下内边距让点击区域达到 88rpx（G6） */
.filter .segs { padding-top: 12rpx; padding-bottom: 12rpx; }
.filter .seg { position: relative; }
.filter .seg::before { content: ''; position: absolute; left: 0; right: 0; top: -12rpx; bottom: -12rpx; }

.order-card { padding: 32rpx; margin-top: 24rpx; }
.oc-top { display: flex; align-items: center; gap: 16rpx; }
.oc-no { flex: 1; min-width: 0; font-size: var(--fs-sm); color: var(--ink-3); }
/* 状态胶囊靠右（D25） */
.oc-pill { margin-left: auto; flex: 0 0 auto; display: flex; }
.oc-mid { display: flex; align-items: center; gap: 24rpx; margin-top: 24rpx; }
.oc-code {
  width: 104rpx; height: 104rpx; border-radius: 26rpx; background: var(--hero); flex: 0 0 104rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff;
}
.oc-code-val { font-size: var(--fs-xl); font-weight: 800; line-height: 1; }
.oc-body { flex: 1; min-width: 0; }
/* 图标对齐首行而非垂直居中：取餐点是客户可配值，任何一行都可能因为
   配置变长而折行，居中会让图标与两行都不对齐。 */
.oc-line {
  font-size: var(--fs-sm); color: var(--ink-3);
  display: flex; align-items: flex-start; gap: 10rpx; line-height: 1.45;
}
.oc-line + .oc-line { margin-top: 10rpx; }
.oc-line icon { margin-top: 4rpx; flex: 0 0 auto; }
.oc-line text { flex: 1; min-width: 0; }
.oc-foot { display: flex; align-items: center; margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx solid var(--line-2); }
/* 小字标签与金额按文字底线对齐（D38） */
.oc-total { margin-left: auto; display: flex; align-items: baseline; gap: 12rpx; }
.oc-total-lbl { font-size: var(--fs-sm); color: var(--ink-3); }
.oc-cancel {
  margin-left: 24rpx; flex: 0 0 auto; white-space: nowrap;
  background: #fff; color: var(--red); box-shadow: inset 0 0 0 4rpx rgba(196, 67, 47, .32);
}

.more { display: flex; justify-content: center; padding: 36rpx 0 8rpx; }
