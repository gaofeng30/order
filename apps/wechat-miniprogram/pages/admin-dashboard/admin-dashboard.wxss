.dash-hero { border-radius: 0 0 48rpx 48rpx; padding-left: 36rpx; padding-right: 36rpx; padding-bottom: 44rpx; color: #fff; }
.dash-store { display: flex; align-items: center; gap: 22rpx; position: relative; z-index: 2; }
.dash-emblem { width: 68rpx; height: 68rpx; background: #fff; border-radius: 18rpx; padding: 4rpx; }
.dash-store-info { flex: 1; }
.dash-store-name { font-size: 34rpx; font-weight: 700; }
.dash-store-hour { font-size: 22rpx; color: var(--ink-on-dark-2); margin-top: 4rpx; }
.biz-switch { display: flex; gap: 16rpx; margin-top: 28rpx; position: relative; z-index: 2; background: rgba(0, 0, 0, .18); padding: 8rpx; border-radius: 24rpx; }
.biz-seg { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 18rpx; font-size: 26rpx; font-weight: 600; }

.todos { display: flex; gap: 20rpx; margin-top: 28rpx; }
.todo { flex: 1; padding: 26rpx 24rpx; position: relative; }
.todo-dot { position: absolute; top: 20rpx; right: 20rpx; width: 14rpx; height: 14rpx; border-radius: 50%; }
.todo-n { font-size: 52rpx; font-weight: 800; color: var(--ink); line-height: 1; }
.todo-lbl { font-size: 22rpx; color: var(--ink-2); margin-top: 12rpx; }

.kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.kpi { padding: 28rpx 30rpx; }
.kpi-top { display: flex; align-items: center; justify-content: space-between; }
.kpi-k { font-size: 24rpx; color: var(--ink-3); }
.kpi-v { font-size: 48rpx; font-weight: 800; color: var(--ink); margin-top: 12rpx; }

.live { padding: 28rpx; margin-bottom: 20rpx; display: flex; align-items: center; gap: 24rpx; }
.live-code { text-align: center; flex: 0 0 92rpx; }
.live-code-val { font-size: 40rpx; font-weight: 800; color: var(--blue); }
.live-time { font-size: 20rpx; color: var(--ink-3); }
.live-body { flex: 1; min-width: 0; }
.live-head { display: flex; align-items: center; gap: 12rpx; }
.live-meta { font-size: 23rpx; color: var(--ink-3); }
.live-summary { font-size: 23rpx; color: var(--ink); margin-top: 10rpx; }
.adv-btn { height: 64rpx; }

.rank { padding: 12rpx 32rpx 20rpx; }
.rank-row { display: flex; align-items: center; gap: 24rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--line-2); }
.rank-row.last { border-bottom: none; }
.rank-no { font-size: 30rpx; font-weight: 800; color: var(--ink-3); width: 36rpx; }
.rank-no.top { color: var(--gold-2); }
.rank-name { font-size: 27rpx; color: var(--ink); width: 156rpx; }
.rank-bar { flex: 1; height: 14rpx; background: var(--bg2); border-radius: 8rpx; overflow: hidden; }
.rank-fill { height: 100%; background: linear-gradient(90deg, #5b8f3f, #3d6b2f); border-radius: 8rpx; }
.rank-sold { font-size: 25rpx; color: var(--ink-2); width: 72rpx; text-align: right; }
