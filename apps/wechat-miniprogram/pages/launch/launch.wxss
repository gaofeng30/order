.launch {
  background: linear-gradient(160deg, var(--hero-3) 0%, var(--hero) 45%, var(--hero-2) 100%);
  color: #fff;
  padding-left: 44rpx;
  padding-right: 44rpx;
}

.launch-layer {
  /* 位于全部页面内容之上（D42） */
  position: fixed; z-index: 60; transform: translate(-50%, -50%);
  animation: launch-layer-in .18s ease-out;
}
.launch-layer image { width: 100%; height: 100%; display: block; }
@keyframes launch-layer-in { from { opacity: 0; } to { opacity: 1; } }

.brand { display: flex; align-items: center; gap: 22rpx; margin-top: 16rpx; position: relative; z-index: 2; }
.brand-logo {
  width: 92rpx; height: 92rpx; border-radius: 28rpx; overflow: hidden;
  display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, .3);
}
.brand-emblem { width: 100%; height: 100%; display: block; }
.brand-name { font-size: var(--fs-xl); font-weight: 700; letter-spacing: 4rpx; }
.brand-sub { font-size: var(--fs-xs); letter-spacing: 8rpx; color: rgba(255, 255, 255, .5); margin-top: 6rpx; }

.hero-mid { flex: 1; display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 2; }
.welcome { font-size: var(--fs-sm); letter-spacing: 12rpx; color: var(--gold); font-weight: 600; }
/* 主视觉大标题 84rpx 为品牌展示例外（G2） */
.big-title { font-size: 84rpx; font-weight: 700; line-height: 1.18; margin-top: 28rpx; letter-spacing: 2rpx; }
.lead { font-size: var(--fs-md); color: rgba(255, 255, 255, .7); margin-top: 32rpx; line-height: 1.7; max-width: 520rpx; }

.cards { display: flex; flex-direction: column; gap: 28rpx; position: relative; z-index: 2; }
.id-card {
  border-radius: 44rpx; padding: 40rpx; display: flex; align-items: center; gap: 32rpx;
  background: rgba(255, 255, 255, .06); box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, .22);
}
.id-card.primary {
  background: linear-gradient(135deg, var(--green-500), var(--green));
  box-shadow: 0 28rpx 68rpx rgba(61, 107, 47, .40);
}
.id-ico {
  width: 108rpx; height: 108rpx; border-radius: 32rpx; flex: 0 0 108rpx;
  display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, .18);
}
.id-ico.ghost { background: rgba(255, 255, 255, .08); }
.id-body { flex: 1; min-width: 0; }
.id-name { font-size: var(--fs-xl); font-weight: 700; color: #fff; letter-spacing: 2rpx; }
.id-go {
  width: 68rpx; height: 68rpx; border-radius: 50%; flex: 0 0 68rpx;
  display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, .12);
}
.id-go.primary { background: #fff; }
.ver { text-align: center; font-size: var(--fs-xs); color: rgba(255, 255, 255, .4); margin-top: 8rpx; }

/* 商户端入口是微信的 <button>（open-type="getPhoneNumber"）。
   它只当透明外壳，不承载布局 —— <button> 自带 margin-left/right: auto，
   在 flex 列容器里会覆盖 align-self: stretch，把卡片收缩居中并让文字逐字
   折行；再叠加它默认的内边距与字号，在同一个盒子上跟这些默认值竞争必输。
   卡片布局因此回到内部的 .id-card，与用户端卡片共用同一份规则。 */
.id-plain {
  display: block; width: 100%; margin: 0; padding: 0; background: transparent;
  line-height: normal; text-align: left; font-size: inherit; color: inherit;
  border-radius: 44rpx; overflow: visible;
}
.id-plain::after { border: none; }

.id-hint {
  margin-top: 20rpx; padding: 24rpx; border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.12); color: rgba(255, 255, 255, 0.86);
  font-size: var(--fs-sm); line-height: 1.6;
}

.pc-login-entry {
  width: 100%; margin: 0; padding: 24rpx; border-radius: 20rpx;
  background: rgba(255, 255, 255, .10); color: #fff; font-size: var(--fs-md); line-height: 1.5;
}
.pc-login-entry::after { border: none; }
