<view class="page">
  <navbar tone="light" title="绥安食品 · 菜单" />

  <view class="store-row">
    <icon name="pin" size="13" color="#467a32" />
    <text>{{store.name}} · 到店自提</text>
  </view>

  <!-- 取餐时间条：进入菜单即有默认值，点击展开选择弹层 -->
  <view class="pickup-bar" bindtap="openPicker">
    <icon name="calendarClock" size="15" color="#467a32" />
    <text class="pickup-txt">{{pickup.label}} 取餐</text>
    <icon name="chevron" size="14" color="#8f9384" />
  </view>

  <view class="pad search-wrap">
    <view class="search-box">
      <icon name="search" size="16" color="#8f9384" />
      <input class="search-in" placeholder="搜索商品" value="{{search}}" bindinput="onSearch" />
    </view>
  </view>

  <view wx:if="{{listState === 'loading'}}" class="catalog-state">目录加载中…</view>
  <view wx:elif="{{listState === 'empty'}}" class="catalog-state">
    <text>当前目录为空</text>
    <view class="btn btn--ghost-blue btn--sm" bindtap="retryCatalog">再次加载</view>
  </view>
  <view wx:elif="{{listState === 'error'}}" class="catalog-state">
    <text>目录加载失败</text>
    <view class="btn btn--ghost-blue btn--sm" bindtap="retryCatalog">重试</view>
  </view>

  <block wx:elif="{{listState === 'ready'}}">
    <view class="cat-nav">
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
        <view class="segs">
          <view
            wx:for="{{cats}}"
            wx:key="id"
            class="seg {{active === item.id ? 'on' : ''}}"
            data-id="{{item.id}}"
            data-idx="{{index}}"
            bindtap="jump"
          >{{item.name}}</view>
        </view>
      </scroll-view>
    </view>

    <scroll-view
      id="menuScroll"
      class="scroll pad menu-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{intoView}}"
      scroll-with-animation
      bindscroll="onScroll"
    >
      <view wx:for="{{groups}}" wx:for-item="g" wx:key="id">
        <view id="sec-{{index}}" class="sec-anchor" data-id="{{g.id}}"></view>
        <view class="sec-h"><text class="t" style="font-size:30rpx">{{g.name}}</text></view>
        <view wx:if="{{g.products.length === 0}}" class="group-empty">该分类暂无商品</view>
        <view wx:for="{{g.products}}" wx:for-item="m" wx:key="id" class="dish-row">
          <image wx:if="{{m.cover}}" class="dish-cover" src="{{m.cover.url}}" mode="aspectFill" data-id="{{m.id}}" bindtap="goDetail" />
          <view wx:else class="dish-cover dish-cover--empty" data-id="{{m.id}}" bindtap="goDetail">暂无图片</view>
          <view class="dish-info">
            <view data-id="{{m.id}}" bindtap="goDetail">
              <view class="dish-name">{{m.name}}<text wx:if="{{!m.orderable}}"> · {{m.availabilityLabel}}</text></view>
              <view class="dish-desc ellipsis-2">{{m.description}}</view>
              <view class="dish-spec">{{m.specification}}</view>
            </view>
            <view class="dish-foot">
              <view class="dish-prices">
                <view wx:if="{{m.isStaffPrice}}" class="staff-price-label">员工价</view>
                <money v="{{m.price_text}}" size="36" />
                <text wx:if="{{m.isStaffPrice}}" class="original-price">¥{{m.original_price_text}}</text>
              </view>
              <view class="dish-action">
                <stepper
                  wx:if="{{qtyMap[m.id] > 0}}"
                  value="{{qtyMap[m.id]}}"
                  data-id="{{m.id}}"
                  bind:sub="sub"
                  bind:add="add"
                />
                <view wx:else class="btn {{m.orderable ? 'btn--primary' : 'btn--mute'}} btn--sm act-btn" data-id="{{m.id}}" catchtap="openCustomize">{{m.orderable ? '选择' : m.availabilityLabel}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="menu-end">—— 服务端目录 · 购物车待核价 ——</view>
      <view style="height:{{safeBottom + 200}}px"></view>
    </scroll-view>
  </block>

  <view class="floatbar" style="bottom:{{safeBottom + 116}}px">
    <view class="cartbar">
      <view class="cart-ico-wrap" bindtap="openSheet">
        <view class="cart-ico {{count ? 'on' : ''}}"><icon name="cart" size="23" color="{{count ? '#ffffff' : '#aaaaaa'}}" /></view>
        <view wx:if="{{count > 0}}" class="cart-badge">{{count}}</view>
      </view>
      <view class="cart-mid">
        <money wx:if="{{count > 0}}" v="{{total}}" size="42" />
        <text wx:else class="cart-empty">购物车是空的</text>
        <view class="cart-hint">{{count > 0 ? '商品快照已保存 · 到店自提' : '从目录选择商品'}}</view>
      </view>
      <view class="btn {{count ? 'btn--primary' : 'btn--mute'}} cart-go" bindtap="goConfirm">去结算</view>
    </view>
  </view>

  <view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet"></view>
  <view wx:if="{{sheet}}" class="sheet">
    <view class="sheet-head">
      <text class="serif sheet-title">已选 {{count}} 件</text>
      <view class="sheet-clear" bindtap="clear"><icon name="close" size="13" color="#8f9384" /><text>清空</text></view>
    </view>
    <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{cartItems}}" wx:for-item="ci" wx:key="item.id" class="list-row sheet-row">
        <view class="sheet-item-info">
          <view class="sheet-item-name">{{ci.item.name}}</view>
          <view class="sheet-item-prices">
            <text wx:if="{{ci.item.isStaffPrice}}" class="staff-price-label">员工价</text>
            <money v="{{ci.item.price_text}}" size="28" />
            <text wx:if="{{ci.item.isStaffPrice}}" class="original-price">¥{{ci.item.original_price_text}}</text>
          </view>
          <view wx:if="{{ci.flavors.length || ci.note}}" class="sheet-item-prefs" data-id="{{ci.item.id}}" catchtap="editItem">
            <text wx:for="{{ci.flavors}}" wx:for-item="f" wx:key="*this" class="pref-chip">{{f}}</text>
            <text wx:if="{{ci.note}}" class="pref-note">“{{ci.note}}”</text>
            <icon name="edit" size="11" color="#8f9384" />
          </view>
          <view wx:else class="sheet-item-add" data-id="{{ci.item.id}}" catchtap="editItem"><icon name="edit" size="11" color="#2a5fa6" />加口味/备注</view>
        </view>
        <stepper value="{{ci.q}}" data-id="{{ci.item.id}}" bind:sub="sub" bind:add="add" />
      </view>
    </scroll-view>
    <view class="sheet-foot" style="padding-bottom:{{safeBottom + 20}}px">
      <view class="sheet-total"><text class="sheet-total-lbl">合计 </text><money v="{{total}}" size="44" /></view>
      <view class="btn btn--primary" bindtap="goConfirm">去结算</view>
    </view>
  </view>

  <!-- 取餐时间选择：日期两段 + 按餐段分组的时间点，已截餐段整组折叠 -->
  <view wx:if="{{pickerVisible}}">
    <view class="sheet-mask" catchtap="closePicker"></view>
    <view class="sheet pk-sheet">
      <view class="pk-head">
        <text class="serif pk-title">选择取餐时间</text>
        <text class="pk-rule">备好后会推送提醒，凭提醒随时来取</text>
        <view class="pk-close" catchtap="closePicker"><icon name="close" size="19" color="#8f9384" /></view>
      </view>
      <view class="pk-dates">
        <view
          wx:for="{{pickerDates}}"
          wx:key="date"
          class="pk-date {{pickerDate === item.date ? 'on' : ''}} {{!item.available ? 'off' : ''}}"
          data-date="{{item.date}}"
          catchtap="pickPickerDate"
        >{{item.label}}<text wx:if="{{!item.available}}" class="pk-date-sub">已截单</text></view>
      </view>
      <scroll-view scroll-y class="pk-body">
        <block wx:for="{{pickerGroups}}" wx:key="key">
          <view class="pk-grp">
            <text class="pk-grp-name">{{item.name}}</text>
            <text wx:if="{{item.cutOff}}" class="pk-grp-cut">{{item.cutoffLabel}}</text>
          </view>
          <view wx:if="{{!item.cutOff}}" class="pk-times">
            <view
              wx:for="{{item.times}}"
              wx:for-item="t"
              wx:key="*this"
              class="pk-time tnum {{pickup.time === t && pickup.date === pickerDate ? 'on' : ''}}"
              data-date="{{item.date}}"
              data-period="{{item.key}}"
              data-t="{{t}}"
              catchtap="pickPickerTime"
            >{{t}}</view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <tabbar variant="user" active="menu" />
  <toast id="toast" />
  <customize visible="{{czVisible}}" item="{{czItem}}" init="{{czInit}}" flavor-options="{{flavors}}" confirm-label="{{czLabel}}" bind:close="onCzClose" bind:confirm="onCzConfirm" />
</view>
