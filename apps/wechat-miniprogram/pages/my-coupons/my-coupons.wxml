<view class="page">
  <navbar tone="dark" overlay title="我的优惠券" back />

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 会员身份 -->
    <view class="hero-dark mc-hero" style="padding-top:{{navTotal}}px">
      <view class="ring r1"></view>
      <view class="ring r2"></view>
      <block wx:if="{{isMember}}">
        <view class="mc-top">
          <view class="mc-av serif">{{initial}}</view>
          <view class="mc-body">
            <view class="mc-head">
              <text class="serif mc-name">{{member.name}}</text>
              <view class="pill pill--ondark">{{level.name}}</view>
            </view>
            <view class="mc-sub tnum">{{phoneMask}}</view>
          </view>
        </view>
        <view class="mc-benefit">
          <view class="mb-item">
            <text class="mb-v serif">{{levelLabel}}</text>
            <text class="mb-k">下单常驻折扣</text>
          </view>
          <view class="mb-line"></view>
          <view class="mb-item">
            <text class="mb-v serif tnum">{{usableCount}}</text>
            <text class="mb-k">当前可用券</text>
          </view>
        </view>
        <view class="mc-note">等级折扣先生效，再叠加一张优惠券；一单只能使用一张券。</view>
      </block>
      <block wx:else>
        <view class="mc-top">
          <view class="mc-av serif">客</view>
          <view class="mc-body">
            <view class="mc-head"><text class="serif mc-name">访客</text></view>
            <view class="mc-sub">未加入会员名单，按原价结算</view>
          </view>
        </view>
        <view class="mc-note">会员资格由商户在后台名单中登记，登记后用微信绑定的手机号即可自动识别。</view>
      </block>
    </view>

    <block wx:if="{{isMember}}">
      <view class="pad">
        <view class="cat-nav">
          <view class="segs">
            <view wx:for="{{tabs}}" wx:key="id" class="seg {{tab === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="switchTab">
              {{item.name}}<text class="cnt">{{item.count}}</text>
            </view>
          </view>
        </view>

        <view wx:for="{{list}}" wx:key="id" class="cp-wrap">
          <coupon-card
            face="{{item.face}}" cond="{{item.cond}}" name="{{item.name}}"
            scope="{{item.scope}}" period="{{item.period}}"
            badge="{{item.badge}}" badge-tone="{{item.badgeTone}}"
            reason="{{item.reason}}" dim="{{item.dim}}"
          />
        </view>

        <view wx:if="{{!list.length}}" class="empty">
          <icon name="ticket" size="30" color="#c9cbbe" />
          <view class="empty-t">{{tab === 'usable' ? '暂无可用优惠券' : '这里还没有记录'}}</view>
          <view class="empty-s">优惠券由商户按会员等级发放，无需领取</view>
        </view>
      </view>
    </block>

    <view style="height:{{safeBottom + 40}}px"></view>
  </scroll-view>

  <toast id="toast" />
</view>
