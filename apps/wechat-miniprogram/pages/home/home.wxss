.home-hero { border-radius: 0 0 52rpx 52rpx; padding: 0 36rpx 48rpx; color: #fff; }
/* 开屏图高于导航栏（50）、低于弹层（150）（D42） */
.launch-layer {
  position: fixed; z-index: 60; transform: translate(-50%, -50%);
  animation: home-launch-layer-in .18s ease-out;
}
.launch-layer image { width: 100%; height: 100%; display: block; }
@keyframes home-launch-layer-in { from { opacity: 0; } to { opacity: 1; } }
.hero-inner { position: relative; z-index: 2; padding-top: 8rpx; }
.greet { font-size: var(--fs-sm); color: rgba(255, 255, 255, .7); }

.hero-brand { display: flex; align-items: center; gap: 22rpx; margin-top: 12rpx; }
.hero-logo {
  flex: 0 0 92rpx; width: 92rpx; height: 92rpx; border-radius: 28rpx; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, .3);
}
.hero-emblem { width: 100%; height: 100%; display: block; }

/* margin-top 移到 .hero-brand，否则徽标与名字基线错位。 */
.store-name { font-size: var(--fs-xl); font-weight: 700; letter-spacing: 2rpx; }
/* 长地址省略，营业状态不被挤压（D37） */
.store-meta { display: flex; align-items: center; gap: 10rpx; margin-top: 18rpx; font-size: var(--fs-sm); color: var(--ink-on-dark-2); }
.store-meta .addr { flex: 0 1 auto; min-width: 0; }
.store-meta .biz { flex: 0 0 auto; white-space: nowrap; }
.hero-search {
  margin-top: 32rpx; height: 88rpx; border-radius: var(--r-pill); background: rgba(255, 255, 255, .14);
  display: flex; align-items: center; gap: 18rpx; padding: 0 32rpx; box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, .16);
}
.hero-search-ph { font-size: var(--fs-md); color: rgba(255, 255, 255, .7); }

/* 原本是 -88rpx，把首个元素推进深蓝 hero；那个位置一直是「服务功能」标题，
   深字压深底近乎隐形。标题删除后改为正向留白，hero 的 52rpx 圆角完整可见。 */
.body { padding: 0 32rpx; margin-top: 24rpx; position: relative; z-index: 3; }

/* 服务宫格 */
.grid { padding: 36rpx 16rpx; display: flex; flex-wrap: wrap; }
.grid-item { width: 33.33%; display: flex; flex-direction: column; align-items: center; gap: 14rpx; padding: 18rpx 0; }
.grid-ico {
  width: 96rpx; height: 96rpx; border-radius: 30rpx; background: var(--bg2);
  display: flex; align-items: center; justify-content: center; position: relative;
}
.grid-cn { font-size: var(--fs-md); color: var(--ink); font-weight: 500; }

/* 进行中订单提示条（§5.1） */
.ob {
  display: flex; align-items: center; gap: 14rpx; min-height: 88rpx;
  padding: 20rpx 26rpx; margin-bottom: 20rpx; border-radius: 18rpx;
  background: var(--card); box-shadow: inset 0 0 0 2rpx var(--line);
}
.ob-txt { flex: 1; min-width: 0; font-size: var(--fs-md); color: var(--ink); }
.ob--ready { background: var(--green-600); box-shadow: none; }
.ob--ready .ob-txt { color: #fff; font-weight: 600; }
/* 「开启提醒」白底绿字小胶囊（U4）；视觉 56rpx，点击区域 88rpx */
.ob-capsule {
  flex: 0 0 auto; position: relative; height: 56rpx; padding: 0 24rpx; border-radius: var(--r-pill);
  display: flex; align-items: center; background: #fff; color: var(--green); font-size: var(--fs-sm); font-weight: 600;
}
.ob-capsule::before { content: ''; position: absolute; left: 0; right: 0; top: -16rpx; bottom: -16rpx; }
.ob-capsule.is-busy { opacity: .6; }

/* 门店公告 */
.notice {
  display: flex; align-items: flex-start; gap: 12rpx;
  padding: 20rpx 26rpx; margin-bottom: 20rpx; border-radius: 18rpx;
  background: var(--gold-bg);
}
.notice-txt { flex: 1; font-size: var(--fs-sm); line-height: 1.6; color: var(--ink-2); }

/* 营业状态：营业中金色点缀，其余灰色 */
.biz--open { color: var(--gold); }
.biz--closed { color: rgba(255, 255, 255, .55); }
