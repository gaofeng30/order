.home-hero { border-radius: 0 0 52rpx 52rpx; padding: 0 36rpx 128rpx; color: #fff; }
.hero-inner { position: relative; z-index: 2; padding-top: 8rpx; }
.greet { font-size: 25rpx; color: rgba(255, 255, 255, .7); }
.store-name { font-size: 50rpx; font-weight: 700; margin-top: 12rpx; letter-spacing: 2rpx; }
.store-meta { display: flex; align-items: center; gap: 10rpx; margin-top: 18rpx; font-size: 24rpx; color: var(--ink-on-dark-2); }
.store-meta .cut { color: #9fd3ff; }
.search {
  margin-top: 32rpx; height: 84rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .14);
  display: flex; align-items: center; gap: 18rpx; padding: 0 32rpx; box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, .16);
}
.search-ph { font-size: 27rpx; color: rgba(255, 255, 255, .7); }

.body { padding: 0 32rpx; margin-top: -88rpx; position: relative; z-index: 3; }

/* 服务宫格 */
.grid { padding: 36rpx 16rpx; display: flex; flex-wrap: wrap; }
.grid-item { width: 33.33%; display: flex; flex-direction: column; align-items: center; gap: 14rpx; padding: 18rpx 0; }
.grid-item.off { opacity: .42; }
.grid-ico {
  width: 96rpx; height: 96rpx; border-radius: 30rpx; background: var(--bg2);
  display: flex; align-items: center; justify-content: center; position: relative;
}
.grid-ico.off { background: #edece3; }
.grid-tag {
  position: absolute; top: -12rpx; right: -20rpx; font-size: 17rpx; background: #cfcebf; color: #fff;
  padding: 2rpx 10rpx; border-radius: 12rpx;
}
.grid-cn { font-size: 25rpx; color: var(--ink); font-weight: 500; }
