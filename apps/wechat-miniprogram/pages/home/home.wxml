<view class="page">
  <view
    wx:if="{{launchLayer}}"
    class="launch-layer"
    style="left:{{launchLayer.leftPercent}}%;top:{{launchLayer.topPercent}}%;width:{{launchLayer.widthPercent}}vw;height:{{launchLayer.heightVw}}vw"
    catchtap="dismissLaunchLayer"
  >
    <image src="{{launchLayer.image.url}}" mode="scaleToFill" />
  </view>
  <navbar tone="dark" overlay>
    <view slot="right"><icon name="bell" size="20" color="#ffffff" /></view>
  </navbar>

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 英雄头 -->
    <view class="hero-dark home-hero" style="padding-top:{{navTotal}}px">
      <view class="ring r1"></view>
      <view class="ring r2"></view>
      <view class="hero-inner">
        <view class="greet">你好，欢迎光临</view>
        <view class="store-name serif">{{storeName}}</view>
        <view class="store-meta">
          <icon name="pin" size="13" color="#b79a55" />
          <text class="addr">{{storeAddress}}</text>
          <text class="biz biz--{{bizStatus === '营业中' ? 'open' : 'closed'}}">　·　{{bizStatus}}</text>
        </view>
        <view class="search" bindtap="toMenu">
          <icon name="search" size="17" color="rgba(255,255,255,0.8)" />
          <text class="search-ph">进入菜单查看当日商品目录</text>
        </view>
      </view>
    </view>

    <view class="body">
      <!-- 进行中订单提示条（§5.1）。也是 §5.10 订阅被拒时的兜底 -->
      <view wx:if="{{ongoing}}" class="ob {{ongoing.ready ? 'ob--ready' : ''}}" bindtap="tapOngoing">
        <icon name="{{ongoing.ready ? 'ticket' : 'calendarClock'}}" size="17" color="{{ongoing.ready ? '#ffffff' : '#467a32'}}" />
        <text class="ob-txt">{{ongoing.text}}</text>
        <icon name="arrowRight" size="15" color="{{ongoing.ready ? 'rgba(255,255,255,0.9)' : '#8f9384'}}" />
      </view>

      <!-- 门店公告，内容来自营业设置（§5.1、§6.9） -->
      <view wx:if="{{notice}}" class="notice">
        <icon name="bell" size="15" color="#b79a55" />
        <text class="notice-txt">{{notice}}</text>
      </view>

      <!-- 服务宫格 -->
      <view class="sec-h"><text class="t">服务功能</text></view>
      <view class="card grid">
        <view wx:for="{{grid}}" wx:key="k" class="grid-item" data-k="{{item.k}}" bindtap="gridTap">
          <view class="grid-ico"><icon name="{{item.icon}}" size="24" color="#467a32" /></view>
          <text class="grid-cn">{{item.cn}}</text>
        </view>
      </view>

      <view style="height:{{safeBottom + 24}}px"></view>
    </view>
  </scroll-view>

  <tabbar variant="user" active="home" />
  <toast id="toast" />
</view>
