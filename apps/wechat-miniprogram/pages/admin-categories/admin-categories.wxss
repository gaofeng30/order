.cat-note { font-size: 24rpx; color: var(--ink-3); padding: 12rpx 4rpx 24rpx; }
.cat-list { padding: 4rpx 32rpx; }
.cat-row { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--line-2); }
.cat-row.last { border-bottom: none; }
.cat-sort {
  width: 60rpx; height: 60rpx; border-radius: 16rpx; background: var(--bg2);
  display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 28rpx; color: var(--blue);
}
.cat-main { flex: 1; }
.cat-name { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.cat-count { font-size: 23rpx; color: var(--ink-3); margin-top: 4rpx; }

.toggle { width: 88rpx; height: 52rpx; border-radius: 999rpx; background: #d8d8cd; position: relative; transition: .18s; }
.toggle.on { background: var(--blue-500); }
.toggle-knob { position: absolute; top: 6rpx; left: 6rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: #fff; transition: .18s; box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .25); }
.toggle.on .toggle-knob { left: 42rpx; }

/* 新增分类 虚线按钮 */
.add-cat-btn {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  margin-top: 28rpx; height: 104rpx; border-radius: var(--r-card);
  border: 2rpx dashed var(--blue-500); background: rgba(42, 95, 166, .03);
  color: var(--blue-500); font-size: 28rpx; font-weight: 600;
}
.add-cat-btn:active { background: rgba(42, 95, 166, .08); }

/* 新增分类 居中弹层 */
.modal-mask { position: absolute; inset: 0; background: rgba(15, 20, 12, .42); z-index: 150; animation: fadeIn .2s ease; }
.modal-card {
  position: absolute; left: 64rpx; right: 64rpx; top: 50%; transform: translateY(-50%);
  z-index: 160; background: var(--card); border-radius: 40rpx;
  padding: 48rpx 44rpx 40rpx; box-shadow: var(--sh-pop); animation: modalPop .26s ease both;
}
@keyframes modalPop {
  from { opacity: 0; transform: translateY(-50%) scale(.96); }
  to { opacity: 1; transform: translateY(-50%) scale(1); }
}
.modal-title { font-size: 38rpx; font-weight: 700; color: var(--ink); }
.modal-sub { font-size: 25rpx; color: var(--ink-3); margin-top: 12rpx; }
.modal-input {
  margin-top: 32rpx; height: 96rpx; padding: 0 28rpx; border-radius: 20rpx;
  background: var(--bg2); font-size: 28rpx; color: var(--ink);
}
.modal-input-ph { color: var(--ink-3); }
.modal-actions { display: flex; gap: 24rpx; margin-top: 40rpx; }
.modal-btn { flex: 1; height: 92rpx; border-radius: 24rpx; }
.modal-cancel { background: var(--bg2); color: var(--ink-2); }
.modal-ok { background: var(--blue); color: #fff; box-shadow: 0 12rpx 32rpx rgba(11, 47, 99, .28); }
