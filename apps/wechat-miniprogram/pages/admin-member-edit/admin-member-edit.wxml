<view class="page">
  <navbar tone="light" title="{{isEdit ? '编辑会员' : '新增会员'}}" back />

  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 编辑态：只读档案 -->
    <view wx:if="{{isEdit}}" class="hero-dark arc">
      <view class="ring r2"></view>
      <view class="arc-top">
        <view class="arc-av serif">{{initial}}</view>
        <view class="arc-body">
          <view class="serif arc-name">{{f.name || '未填写姓名'}}</view>
          <view class="arc-sub tnum">加入于 {{m.joinAt}}</view>
        </view>
        <view class="pill {{m.bound ? 'pill--ondark' : 'pill--ondark'}}">{{m.bound ? '已绑定微信' : '未绑定'}}</view>
      </view>
      <view class="arc-stats">
        <view class="arc-st">
          <text class="as-v tnum">¥{{m.spend}}</text>
          <text class="as-k">累计消费</text>
        </view>
        <view class="arc-line"></view>
        <view class="arc-st">
          <text class="as-v tnum">{{m.orders}}</text>
          <text class="as-k">累计单量</text>
        </view>
        <view class="arc-line"></view>
        <view class="arc-st">
          <text class="as-v tnum">{{levelLabel}}</text>
          <text class="as-k">当前折扣</text>
        </view>
      </view>
      <view class="arc-note">累计数据由系统统计，等级不自动升降，需在下方手动指定。</view>
    </view>

    <view class="card form">
      <view class="erow">
        <text class="erow-lbl">手机号</text>
        <input class="erow-in tnum" type="number" maxlength="11" placeholder="11 位手机号" placeholder-class="ph" value="{{f.phone}}" data-k="phone" bindinput="onInput" />
        <text class="erow-tag">唯一识别</text>
      </view>
      <view wx:if="{{isEdit && m.bound}}" class="erow-hint">
        <icon name="warn" size="13" color="#a4873f" />
        <text>该手机号已被微信绑定，修改后原用户将失去会员权益。</text>
      </view>
      <view class="erow">
        <text class="erow-lbl">姓名</text>
        <input class="erow-in" placeholder="必填" placeholder-class="ph" value="{{f.name}}" data-k="name" bindinput="onInput" />
      </view>
      <view class="erow cat-row">
        <text class="erow-lbl">会员等级</text>
        <view class="cat-chips">
          <view wx:for="{{levels}}" wx:key="id" class="chip {{f.levelId === item.id ? 'on blue' : ''}}" data-id="{{item.id}}" bindtap="pickLevel">
            {{item.name}}<text class="chip-dis">{{item.label}}</text>
          </view>
        </view>
      </view>
      <view class="erow">
        <text class="erow-lbl">单位</text>
        <input class="erow-in" placeholder="选填" placeholder-class="ph" value="{{f.org}}" data-k="org" bindinput="onInput" />
      </view>
      <view class="erow">
        <text class="erow-lbl">部门</text>
        <input class="erow-in" placeholder="选填" placeholder-class="ph" value="{{f.dept}}" data-k="dept" bindinput="onInput" />
      </view>
      <view class="erow">
        <text class="erow-lbl">工号</text>
        <input class="erow-in" placeholder="选填" placeholder-class="ph" value="{{f.jobNo}}" data-k="jobNo" bindinput="onInput" />
      </view>
      <view class="erow">
        <text class="erow-lbl">备注</text>
        <input class="erow-in" placeholder="内部备注，用户不可见" placeholder-class="ph" value="{{f.remark}}" data-k="remark" bindinput="onInput" />
      </view>
      <view class="erow last">
        <text class="erow-lbl">启用权益</text>
        <text class="sw-sub">{{f.enabled ? '正常享受等级折扣与优惠券' : '保留记录，暂停全部权益'}}</text>
        <view class="toggle {{f.enabled ? 'on' : ''}}" bindtap="toggleEnabled">
          <view class="toggle-knob"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{isEdit}}" class="del-row" bindtap="askDelete">从名单中移除</view>

    <view style="height:24rpx"></view>
  </scroll-view>

  <view class="bottom-bar" style="padding-bottom:{{safeBottom + 20}}px">
    <view class="btn btn--ghost-blue edit-cancel" bindtap="cancel">取消</view>
    <view class="btn btn--blue edit-save" bindtap="save">保存</view>
  </view>

  <toast id="toast" />
</view>
