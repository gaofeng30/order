/* ---------- 只读档案 ---------- */
.arc { padding: 32rpx 34rpx 28rpx; margin-top: 20rpx; }
.arc-top { display: flex; align-items: center; gap: 22rpx; position: relative; z-index: 2; }
.arc-av {
  flex: 0 0 84rpx; width: 84rpx; height: 84rpx; border-radius: 50%;
  background: rgba(255, 255, 255, .16); color: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 600;
}
.arc-body { flex: 1; min-width: 0; }
.arc-name { font-size: 34rpx; font-weight: 700; letter-spacing: 1rpx; }
.arc-sub { font-size: 22rpx; color: var(--ink-on-dark-2); margin-top: 8rpx; }

.arc-stats { display: flex; align-items: center; margin-top: 28rpx; position: relative; z-index: 2; }
.arc-st { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.as-v { font-size: 32rpx; font-weight: 800; color: #fff; letter-spacing: -1rpx; }
.as-k { font-size: 21rpx; color: var(--ink-on-dark-2); }
.arc-line { width: 1rpx; height: 40rpx; background: rgba(255, 255, 255, .16); }
.arc-note { font-size: 21rpx; color: var(--ink-on-dark-2); margin-top: 24rpx; line-height: 1.6; position: relative; z-index: 2; }

/* ---------- 表单 ---------- */
.form { padding: 4rpx 36rpx; margin-top: 32rpx; }
.erow { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid var(--line-2); }
.erow.last { border-bottom: none; }
.erow-lbl { font-size: 27rpx; color: var(--ink-2); width: 156rpx; flex: 0 0 156rpx; }
.erow-in { flex: 1; font-size: 29rpx; color: var(--ink); }
.ph { color: var(--ink-3); }
.erow-tag { font-size: 21rpx; color: var(--blue-500); background: var(--blue-bg); padding: 6rpx 16rpx; border-radius: 12rpx; }
.erow-hint {
  display: flex; align-items: flex-start; gap: 10rpx; padding: 0 0 22rpx;
  font-size: 22rpx; color: var(--gold-2); line-height: 1.5; margin-top: -14rpx;
}

.cat-row { align-items: flex-start; }
.cat-chips { display: flex; gap: 16rpx; flex-wrap: wrap; flex: 1; }
.cat-chips .chip { height: 62rpx; }
.chip-dis { font-size: 20rpx; opacity: .7; margin-left: 8rpx; }

.sw-sub { flex: 1; font-size: 23rpx; color: var(--ink-3); }
.toggle { width: 88rpx; height: 52rpx; border-radius: 999rpx; background: #d8d8cd; position: relative; transition: .18s; flex: 0 0 88rpx; }
.toggle.on { background: var(--blue-500); }
.toggle-knob { position: absolute; top: 6rpx; left: 6rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: #fff; transition: .18s; box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .25); }
.toggle.on .toggle-knob { left: 42rpx; }

.del-row {
  margin-top: 32rpx; height: 92rpx; border-radius: var(--r-card); background: var(--card);
  box-shadow: var(--sh-soft); display: flex; align-items: center; justify-content: center;
  font-size: 27rpx; color: #b4483c; font-weight: 600;
}

.bottom-bar { flex: 0 0 auto; padding: 20rpx 32rpx; border-top: 1rpx solid var(--line); display: flex; gap: 24rpx; }
.edit-cancel { flex: 1; }
.edit-save { flex: 1.6; }
