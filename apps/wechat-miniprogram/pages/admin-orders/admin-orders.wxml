<view class="page">
  <navbar tone="light" title="订单管理">
    <view slot="right" class="nav-more" bindtap="reset">切换身份</view>
  </navbar>

  <!-- 营业状态：现场临时休息需要手机可操作 -->
  <view class="pad biz-row">
    <view
      wx:for="{{biz}}"
      wx:key="*this"
      class="biz-seg {{storeStatus === item ? 'on' : ''}}"
      data-b="{{item}}"
      bindtap="setBiz"
    >{{item}}</view>
  </view>

  <!-- 搜索：取餐号 / 订单号 / 手机号，跨泳道（§6.6） -->
  <view class="pad search-wrap">
    <view class="search-box">
      <icon name="search" size="16" color="#8f9384" />
      <input
        class="search-in"
        placeholder="搜索 取餐号 / 订单号 / 手机号"
        placeholder-class="search-ph"
        value="{{kw}}"
        bindinput="onKw"
        confirm-type="search"
      />
    </view>
  </view>

  <!-- 跨营业日取餐号：报出事实与替代定位方式，而不是给一个空列表 -->
  <view wx:if="{{hint}}" class="pad code-hint">{{hint}}</view>

  <!-- 泳道 -->
  <view class="lane-nav">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
      <view class="segs">
        <view
          wx:for="{{lanes}}"
          wx:key="*this"
          class="seg {{lane === item ? 'on' : ''}}"
          data-l="{{item}}"
          bindtap="switchLane"
        >{{item}}<text wx:if="{{counts[item] > 0}}" class="cnt">{{counts[item]}}</text></view>
      </view>
    </scroll-view>
  </view>

  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{list.length === 0}}" class="empty">
      <icon name="layers" size="46" color="#d8d8cd" stroke="1.5" />
      <view class="empty-txt">「{{lane}}」暂无订单</view>
    </view>

    <view wx:for="{{list}}" wx:key="id" class="card aorder" data-id="{{item.id}}" bindtap="cardTap">
      <view class="aorder-body">
        <view class="aorder-head">
          <text class="serif aorder-code">{{item.code}}</text>
          <pill s="{{item.status}}" dot />
          <money v="{{item.total}}" blue size="34" />
        </view>
        <view class="aorder-meta">
          <text>{{item.contact}}</text><text>·</text><text>{{item.count}} 件</text><text>·</text><text>{{item.time}} 下单</text>
        </view>
        <view wx:if="{{item.showBand}}" class="aorder-band">
          <icon name="flame" size="13" color="#a4873f" /><text>{{item.band}}</text>
        </view>
        <view class="aorder-summary ellipsis-1">{{item.summary}}</view>
        <view class="aorder-foot">
          <view
            wx:if="{{item.meta.isView}}"
            class="btn btn--ghost-blue btn--sm adv-btn"
            data-id="{{item.id}}"
            catchtap="viewOrder"
          >{{item.meta.label}}</view>
          <view
            wx:else
            class="btn {{item.meta.cls}} btn--sm adv-btn"
            data-id="{{item.id}}"
            catchtap="advance"
          ><icon wx:if="{{item.meta.scan}}" name="scan" size="15" color="#ffffff" />{{item.meta.label}}</view>
        </view>
      </view>
    </view>
    <view style="height:{{safeBottom + 60}}px"></view>
  </scroll-view>

  <tabbar variant="admin" active="admin-orders" />
  <toast id="toast" />
</view>
