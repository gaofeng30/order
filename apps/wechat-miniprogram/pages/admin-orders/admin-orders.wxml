<view class="page">
  <navbar tone="light" title="订单管理" />

  <!-- 营业状态：一行紧凑分段，现场临时休息需要手机可操作（A4） -->
  <view class="pad biz-wrap">
    <view class="biz {{statusSaving ? 'is-saving' : ''}}" aria-role="radiogroup" aria-label="营业状态">
      <view
        wx:for="{{biz}}"
        wx:key="code"
        class="biz-seg {{storeStatus === item.code ? 'on' : ''}}"
        data-b="{{item.code}}"
        bindtap="onBiz"
        hover-class="{{statusSaving ? 'none' : 'tap-dim'}}"
        hover-stay-time="80"
        aria-role="radio"
        aria-checked="{{storeStatus === item.code}}"
        aria-disabled="{{statusSaving}}"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 搜索：取餐号 / 订单号 / 手机号，跨泳道（§6.6） -->
  <view class="pad search-wrap">
    <view class="search-box">
      <icon name="search" size="16" color="#8f9384" />
      <input
        class="search-in"
        placeholder="搜索 取餐号 / 订单号 / 手机号"
        placeholder-class="search-ph"
        value="{{kw}}"
        bindinput="onKw"
        confirm-type="search"
      />
      <view
        wx:if="{{kw}}"
        class="search-clear"
        bindtap="clearKw"
        hover-class="tap-dim"
        hover-stay-time="80"
        aria-role="button"
        aria-label="清空搜索"
      ><icon name="close" size="20" color="#8f9384" /></view>
    </view>
  </view>

  <!-- 泳道 -->
  <view class="lane-nav">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
      <view class="segs">
        <view
          wx:for="{{lanes}}"
          wx:key="*this"
          class="seg {{!kw && lane === item ? 'on' : ''}}"
          data-l="{{item}}"
          bindtap="switchLane"
          hover-class="tap-dim"
          hover-stay-time="80"
          aria-role="tab"
          aria-selected="{{!kw && lane === item}}"
        >{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <scroll-view
    class="scroll pad"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-default-style="black"
    refresher-background="#f4f3ec"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <state wx:if="{{listState === 'loading'}}" kind="loading" text="正在读取订单" />
    <state wx:elif="{{listState === 'error'}}" kind="error" text="网络不太好，订单没加载出来" bind:action="retry" />
    <state wx:elif="{{listState === 'empty'}}" kind="empty" icon="layers" text="{{kw ? '没有匹配的订单' : '「' + lane + '」暂无订单'}}" />

    <block wx:else>
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="card aorder"
        data-id="{{item.id}}"
        bindtap="openOrder"
        hover-class="tap-dim"
        hover-stay-time="80"
      >
        <view class="aorder-head">
          <text class="serif aorder-code">{{item.code}}</text>
          <pill s="{{item.status}}" dot />
          <view class="aorder-price"><money cents="{{item.total}}" size="36" /></view>
        </view>
        <view class="aorder-meta">
          <text>{{item.pickupLabel}} 取餐</text>
          <text wx:if="{{item.placedLabel}}">·</text>
          <text wx:if="{{item.placedLabel}}">{{item.placedLabel}} 下单</text>
        </view>
        <view class="aorder-foot">
          <view
            class="btn btn--sm {{item.canReady ? 'btn--primary' : 'btn--ghost'}}"
            data-id="{{item.id}}"
            catchtap="openOrder"
            hover-stop-propagation="{{true}}" hover-class="b-active"
            hover-stay-time="80"
          >{{item.actionLabel}}</view>
        </view>
      </view>
    </block>
    <view class="tail-space"></view>
  </scroll-view>

  <tabbar variant="admin" active="admin-orders" />
  <toast id="toast" />
</view>
