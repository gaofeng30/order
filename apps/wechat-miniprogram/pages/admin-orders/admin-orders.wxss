/* ---------- 营业状态：一行紧凑分段（A4），选中为绿（A7） ---------- */
.biz-wrap { padding-top: 4rpx; padding-bottom: 16rpx; }
.biz {
  display: flex; padding: 6rpx; border-radius: var(--r-pill);
  background: #fff; box-shadow: inset 0 0 0 2rpx var(--line);
}
.biz-seg {
  position: relative; flex: 1; height: 64rpx; border-radius: var(--r-pill);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2);
}
/* 视觉 64rpx，点击区域 88rpx（G6） */
.biz-seg::before { content: ''; position: absolute; left: 0; right: 0; top: -12rpx; bottom: -12rpx; }
.biz-seg.on { background: var(--green); color: #fff; }
.biz.is-saving .biz-seg { opacity: .5; }

.search-wrap { padding-top: 4rpx; padding-bottom: 16rpx; }

/* 泳道：.segs 自带两端留白，外层不加左右 padding（D36） */
.lane-nav { padding-bottom: 12rpx; border-bottom: 2rpx solid var(--line); }
.lane-nav .seg { position: relative; }
.lane-nav .seg::before { content: ''; position: absolute; left: 0; right: 0; top: -12rpx; bottom: -12rpx; }

/* ---------- 订单卡 ---------- */
.aorder { padding: 28rpx; margin-top: 24rpx; }
.aorder-head { display: flex; align-items: center; gap: 18rpx; }
.aorder-code { font-size: var(--fs-xl); font-weight: 800; color: var(--ink); line-height: 1; letter-spacing: 2rpx; }
/* 金额靠右（D25） */
.aorder-price { margin-left: auto; }
.aorder-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; font-size: var(--fs-sm); color: var(--ink-3); }
.aorder-foot { display: flex; justify-content: flex-end; margin-top: 20rpx; }
