<view class="page verify-page">
  <navbar tone="dark" title="扫码核销" />

  <view class="verify-body pad">
    <!-- 中间：大号扫码按钮（A14） -->
    <view class="verify-center">
      <view class="scan-ico"><icon name="scan" size="40" color="#8fd06a" stroke="1.8" /></view>
      <view class="serif scan-title">扫描顾客的取餐二维码</view>
      <view class="scan-desc">扫码后自动核销，无需再次确认</view>
      <view
        class="btn btn--primary scan-btn {{scanning || redeeming ? 'is-disabled' : ''}}"
        bindtap="scan"
        hover-class="{{scanning || redeeming ? 'none' : 'b-active'}}"
        hover-stay-time="80"
        aria-role="button"
        aria-disabled="{{scanning || redeeming}}"
      >
        <icon name="scan" size="20" color="{{scanning || redeeming ? '#9a9e8c' : '#ffffff'}}" />
        <text>{{redeeming ? '核销中…' : scanning ? '正在扫码…' : '扫码核销'}}</text>
      </view>
    </view>

    <!-- 下方：手输取餐号（A18） -->
    <view class="manual">
      <view class="manual-title">无法扫码？手动输入取餐号</view>
      <view class="manual-row">
        <input
          class="manual-in {{redeeming ? 'is-locked' : ''}}"
          type="number"
          maxlength="4"
          placeholder="4 位取餐号"
          placeholder-class="manual-ph"
          value="{{code}}"
          disabled="{{redeeming}}"
          bindinput="onCode"
          confirm-type="done"
          bindconfirm="manual"
        />
        <view
          class="btn btn--primary manual-btn {{code.length === 4 && !redeeming && !scanning ? '' : 'is-disabled'}}"
          bindtap="manual"
          hover-class="{{code.length === 4 && !redeeming && !scanning ? 'b-active' : 'none'}}"
          hover-stay-time="80"
          aria-role="button"
          aria-disabled="{{code.length !== 4 || redeeming || scanning}}"
        >{{redeeming ? '核销中…' : '核销'}}</view>
      </view>
    </view>
  </view>

  <!-- scan/code 调用服务端原子核销；成功响应本身就是最终结果，不再二次确认。 -->
  <view wx:if="{{result}}" class="sheet-mask" bindtap="done"></view>
  <view wx:if="{{result}}" class="sheet vr-sheet" style="padding-bottom:{{safeBottom + 28}}px" aria-role="dialog">
    <view class="vr-head">
      <view class="vr-ico"><icon name="check" size="28" color="#467a32" stroke="2.4" /></view>
      <view class="serif vr-title">已核销</view>
      <view class="vr-lbl">取餐号</view>
      <view class="serif vr-code">{{result.code}}</view>
      <view wx:if="{{result.contactName}}" class="vr-name">{{result.contactName}}</view>
    </view>
    <!-- 菜品多时只滚动这一块，按钮始终可见（D29） -->
    <scroll-view class="vr-items" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{result.rows}}" wx:key="key" class="vr-item {{index === result.rows.length - 1 ? 'last' : ''}}">
        <view class="vr-item-info">
          <view class="vr-item-name">{{item.name}}</view>
          <view class="vr-item-unit"><money cents="{{item.p}}" size="28" /><text class="vr-item-q">× {{item.q}}</text></view>
        </view>
        <money cents="{{item.sub}}" size="28" />
      </view>
    </scroll-view>
    <view class="vr-actions">
      <view class="btn btn--ghost vr-done" bindtap="done" hover-class="b-active" hover-stay-time="80">完成</view>
      <view class="btn btn--primary vr-next" bindtap="continueScan" hover-class="b-active" hover-stay-time="80">继续扫码</view>
    </view>
  </view>

  <tabbar variant="admin" active="admin-verify" />
  <toast id="toast" />
</view>
