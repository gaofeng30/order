/* 保持原有深色核销页（窗口环境下更醒目） */
.verify-page { background: #0a0f1a; }
.verify-body { flex: 1; min-height: 0; display: flex; flex-direction: column; }

/* 中间：大号「扫码核销」（A14） */
.verify-center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.scan-ico {
  width: 160rpx; height: 160rpx; border-radius: 48rpx; background: rgba(255, 255, 255, .06);
  display: flex; align-items: center; justify-content: center;
}
.scan-title { margin-top: 36rpx; font-size: var(--fs-lg); font-weight: 700; color: #fff; }
.scan-desc { margin-top: 12rpx; font-size: var(--fs-sm); color: rgba(255, 255, 255, .55); }
.scan-btn { margin-top: 48rpx; width: 440rpx; height: 104rpx; font-size: var(--fs-lg); }

/* 下方：手输取餐号（A18）；有 tabbar，尾部只留常规间距（D30） */
.manual { padding: 28rpx 32rpx; margin-bottom: 32rpx; border-radius: var(--r-card); background: rgba(255, 255, 255, .05); }
.manual-title { font-size: var(--fs-sm); color: rgba(255, 255, 255, .55); margin-bottom: 20rpx; }
.manual-row { display: flex; gap: 20rpx; }
.manual-in {
  flex: 1; min-width: 0; height: 96rpx; padding: 0 28rpx; border-radius: var(--r-sm);
  background: rgba(255, 255, 255, .06); box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, .18);
  color: #fff; font-size: var(--fs-lg); letter-spacing: 8rpx;
}
.manual-in.is-locked { color: rgba(255, 255, 255, .4); }
.manual-ph { font-size: var(--fs-md); letter-spacing: 0; color: rgba(255, 255, 255, .4); }
.manual-btn { flex: 0 0 192rpx; }

/* 成功弹层（A16、D29） */
.vr-sheet { padding: 44rpx 40rpx 0; }
.vr-head { flex: 0 0 auto; text-align: center; }
.vr-ico {
  width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--green-bg); margin: 0 auto;
  display: flex; align-items: center; justify-content: center;
}
.vr-title { margin-top: 20rpx; font-size: var(--fs-xl); font-weight: 700; color: var(--ink); }
.vr-lbl { margin-top: 20rpx; font-size: var(--fs-xs); letter-spacing: 8rpx; color: var(--ink-3); }
.vr-code { font-size: 96rpx; font-weight: 900; line-height: 1.1; letter-spacing: 6rpx; text-indent: 6rpx; color: var(--ink); }
.vr-name { margin-top: 8rpx; font-size: var(--fs-md); color: var(--ink-2); }

.vr-items { flex: 0 1 auto; max-height: 40vh; margin-top: 24rpx; padding: 0 28rpx; border-radius: var(--r-sm); background: var(--bg); }
.vr-item { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 2rpx solid var(--line-2); }
.vr-item.last { border-bottom: none; }
.vr-item-info { flex: 1; min-width: 0; }
.vr-item-name { font-size: var(--fs-md); color: var(--ink); word-break: break-all; }
.vr-item-unit { display: flex; align-items: baseline; gap: 8rpx; margin-top: 6rpx; }
.vr-item-q { font-size: var(--fs-sm); color: var(--ink-3); }

.vr-actions { flex: 0 0 auto; display: flex; gap: 24rpx; margin-top: 32rpx; }
.vr-done { flex: 1; }
.vr-next { flex: 1.6; }
