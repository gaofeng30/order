/* ---------- 操作说明 ---------- */
.gd { padding: 32rpx 36rpx 30rpx; margin-top: 20rpx; }
.gd-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.gd-title { font-size: 31rpx; font-weight: 700; letter-spacing: 1rpx; }
.gd-step { display: flex; align-items: flex-start; gap: 16rpx; padding: 8rpx 0; position: relative; z-index: 2; }
.gs-no {
  flex: 0 0 36rpx; width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(255, 255, 255, .16); color: #fff; font-size: 21rpx;
  display: flex; align-items: center; justify-content: center; margin-top: 4rpx;
}
.gs-txt { flex: 1; font-size: 24rpx; line-height: 1.65; color: var(--ink-on-dark-2); }
.gs-hl { color: #e0c67f; font-weight: 600; }
.gd-warn {
  display: flex; align-items: flex-start; gap: 10rpx; margin-top: 20rpx; padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .12);
  font-size: 22rpx; color: #e0c67f; line-height: 1.55; position: relative; z-index: 2;
}

/* ---------- 模板 ---------- */
.tpl { padding: 4rpx 32rpx 30rpx; margin-top: 26rpx; }
.tpl-copy { font-size: 24rpx; color: var(--blue-500); font-weight: 600; }
.tpl-cols { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tc {
  display: inline-flex; align-items: center; gap: 10rpx; padding: 10rpx 20rpx;
  background: var(--card-2); border-radius: var(--r-pill); box-shadow: inset 0 0 0 2rpx var(--line-2);
}
.tc-k { font-size: 25rpx; color: var(--ink); font-weight: 600; }
.tc-r { font-size: 20rpx; color: var(--ink-3); }
.tc-r.req { color: var(--green-600); }
.tpl-eg {
  font-size: 22rpx; color: var(--ink-3); margin-top: 22rpx; padding: 18rpx 20rpx;
  background: var(--bg2); border-radius: var(--r-sm); line-height: 1.6; word-break: break-all;
}
.tpl-lv { margin-top: 24rpx; }
.tl-lbl { font-size: 23rpx; color: var(--ink-2); }
.tl-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.tl-chip { font-size: 22rpx; color: var(--gold-2); background: var(--gold-bg); padding: 6rpx 18rpx; border-radius: var(--r-pill); }

/* ---------- 结果汇总 ---------- */
.sum { padding: 26rpx 32rpx 28rpx; margin-top: 20rpx; }
.sum-file { display: flex; align-items: center; gap: 12rpx; padding-bottom: 22rpx; border-bottom: 1rpx solid var(--line-2); }
.sf-name { flex: 1; font-size: 25rpx; color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sf-re { font-size: 24rpx; color: var(--blue-500); font-weight: 600; }
.sum-row { display: flex; align-items: center; padding: 26rpx 0 4rpx; }
.sc { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.sc-v { font-size: 44rpx; font-weight: 800; color: var(--ink-3); letter-spacing: -1rpx; }
.sc-v.ok { color: var(--green-600); }
.sc-v.info { color: var(--blue-500); }
.sc-v.bad { color: #b4483c; }
.sc-k { font-size: 22rpx; color: var(--ink-3); }
.sc-line { width: 1rpx; height: 48rpx; background: var(--line); }
.sum-note { font-size: 22rpx; color: var(--ink-3); line-height: 1.6; margin-top: 22rpx; }

/* ---------- 异常明细 ---------- */
.err { padding: 4rpx 32rpx 26rpx; margin-top: 24rpx; }
.err-head { display: flex; align-items: center; gap: 12rpx; padding: 28rpx 0 20rpx; }
.err-title { flex: 1; font-size: 28rpx; font-weight: 600; color: #b4483c; }
.err-more { font-size: 24rpx; color: var(--ink-3); }
.err-row { display: flex; gap: 18rpx; padding: 18rpx 0; border-top: 1rpx solid var(--line-2); }
.er-line { flex: 0 0 auto; font-size: 22rpx; color: var(--ink-3); margin-top: 2rpx; }
.er-body { flex: 1; min-width: 0; }
.er-raw { display: block; font-size: 23rpx; color: var(--ink-2); word-break: break-all; line-height: 1.5; }
.er-why { display: block; font-size: 22rpx; color: #b4483c; margin-top: 6rpx; }
.err-note { font-size: 22rpx; color: var(--ink-3); line-height: 1.6; margin-top: 18rpx; }

/* ---------- 待导入明细 ---------- */
.row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; margin-bottom: 18rpx; }
.row-tag { flex: 0 0 auto; }
.row-main { flex: 1; min-width: 0; }
.row-head { display: flex; align-items: baseline; gap: 16rpx; }
.row-name { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.row-phone { font-size: 23rpx; color: var(--ink-2); }
.row-sub { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.bottom-bar { flex: 0 0 auto; padding: 20rpx 32rpx; border-top: 1rpx solid var(--line); display: flex; gap: 24rpx; }
.im-cancel { flex: 1; }
.im-ok { flex: 1.8; }
