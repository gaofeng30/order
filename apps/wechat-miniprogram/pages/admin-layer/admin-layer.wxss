/* ---------- 预览画布 ---------- */
.preview-wrap { display: flex; justify-content: center; margin-top: 20rpx; }
.preview-box {
  position: relative; overflow: hidden; border-radius: 32rpx;
  background: #0b2f63; box-shadow: var(--sh-pop);
}
/* mock 按真实屏幕尺寸搭建再整体缩小，rpx 样式与真机完全一致 */
.mock {
  position: absolute; left: 0; top: 0; transform-origin: 0 0;
  display: flex; flex-direction: column; overflow: hidden; color: #fff;
}
.mock-dark { background: linear-gradient(160deg, #103a78 0%, #0b2f63 45%, #082651 100%); }

/* ----- 业务选择页 mock（样式取自 brand.wxss）----- */
.m-logo-mid { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; z-index: 2; }
.m-logo-card {
  width: 320rpx; height: 320rpx; border-radius: 88rpx; background: #fff;
  display: flex; align-items: center; justify-content: center; box-shadow: 0 36rpx 92rpx rgba(0, 0, 0, .34);
}
.m-logo-emblem { width: 250rpx; height: 250rpx; }
.m-opts { display: flex; flex-direction: column; gap: 28rpx; position: relative; z-index: 2; }
.m-opt { display: flex; align-items: center; gap: 32rpx; padding: 36rpx; border-radius: 40rpx; }
.m-opt.ready { background: linear-gradient(135deg, #5b8f3f, #3d6b2f); box-shadow: 0 28rpx 64rpx rgba(61, 107, 47, .34); }
.m-opt.off { background: rgba(255, 255, 255, .045); box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, .10); opacity: .66; }
.m-opt-ico {
  width: 100rpx; height: 100rpx; border-radius: 30rpx; flex: 0 0 100rpx;
  display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, .18);
}
.m-opt.off .m-opt-ico { background: rgba(255, 255, 255, .06); }
.m-opt-body { flex: 1; min-width: 0; }
.m-opt-name { font-size: 40rpx; font-weight: 700; letter-spacing: 2rpx; color: #fff; }
.m-opt.off .m-opt-name { color: rgba(255, 255, 255, .6); }
.m-opt-desc { font-size: 24rpx; color: rgba(255, 255, 255, .72); margin-top: 10rpx; }
.m-opt.off .m-opt-desc { color: rgba(255, 255, 255, .4); }
.m-opt-go {
  width: 68rpx; height: 68rpx; border-radius: 50%; flex: 0 0 68rpx;
  display: flex; align-items: center; justify-content: center; background: #fff;
}
.m-ver { text-align: center; font-size: 22rpx; color: rgba(255, 255, 255, .4); margin-top: 16rpx; }

/* ----- 身份选择页 mock（样式取自 launch.wxss）----- */
.m-brand { display: flex; align-items: center; gap: 22rpx; margin-top: 84rpx; position: relative; z-index: 2; }
.m-brand-logo {
  width: 92rpx; height: 92rpx; border-radius: 28rpx; background: #fff;
  display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, .3);
}
.m-brand-emblem { width: 72rpx; height: 72rpx; }
.m-brand-name { font-size: 36rpx; font-weight: 700; letter-spacing: 4rpx; }
.m-brand-sub { font-size: 19rpx; letter-spacing: 8rpx; color: rgba(255, 255, 255, .5); margin-top: 6rpx; }
.m-hero { flex: 1; display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 2; }
.m-welcome { font-size: 24rpx; letter-spacing: 12rpx; color: var(--gold); font-weight: 600; }
.m-big { font-size: 84rpx; font-weight: 700; line-height: 1.18; margin-top: 28rpx; letter-spacing: 2rpx; }
.m-lead { font-size: 28rpx; color: rgba(255, 255, 255, .7); margin-top: 32rpx; line-height: 1.7; max-width: 520rpx; }
.m-cards { display: flex; flex-direction: column; gap: 28rpx; position: relative; z-index: 2; }
.m-id {
  border-radius: 44rpx; padding: 40rpx; display: flex; align-items: center; gap: 32rpx;
  background: rgba(255, 255, 255, .06); box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, .22);
}
.m-id.primary { background: linear-gradient(135deg, #5b8f3f, #3d6b2f); box-shadow: 0 28rpx 68rpx rgba(61, 107, 47, .40); }
.m-id-ico {
  width: 108rpx; height: 108rpx; border-radius: 32rpx; flex: 0 0 108rpx;
  display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, .18);
}
.m-id-ico.ghost { background: rgba(255, 255, 255, .08); }
.m-id-body { flex: 1; min-width: 0; }
.m-id-name { font-size: 42rpx; font-weight: 700; color: #fff; letter-spacing: 2rpx; }
.m-id-desc { font-size: 25rpx; color: rgba(255, 255, 255, .72); margin-top: 10rpx; line-height: 1.5; }
.m-id-go {
  width: 68rpx; height: 68rpx; border-radius: 50%; flex: 0 0 68rpx;
  display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, .12);
}
.m-id-go.primary { background: #fff; }

/* ---------- 拖拽层 ---------- */
.area { position: absolute; left: 0; top: 0; z-index: 5; }
.mv { border: 2rpx dashed rgba(255, 255, 255, .55); border-radius: 8rpx; }
.mv-img { width: 100%; height: 100%; }

/* ---------- 未上传引导 ---------- */
.empty-hint {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 6;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx;
}
.empty-ico {
  width: 96rpx; height: 96rpx; border-radius: 50%; background: rgba(255, 255, 255, .16);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, .3);
  display: flex; align-items: center; justify-content: center;
}
.empty-t { font-size: 24rpx; color: rgba(255, 255, 255, .8); letter-spacing: 2rpx; }

/* ---------- 控制面板 ---------- */
.ctrl { margin-top: 28rpx; padding: 12rpx 36rpx 32rpx; }
.ctrl-row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--line-2); }
.ctrl-lbl { font-size: 27rpx; color: var(--ink-2); flex: 0 0 156rpx; }
.ctrl-slider { flex: 1; margin: 0; }
.ctrl-val { flex: 0 0 70rpx; text-align: right; font-size: 26rpx; color: var(--ink); font-weight: 600; }
.ctrl-flex { flex: 1; }
.ctrl-btns { display: flex; gap: 20rpx; padding-top: 28rpx; }
.ctrl-tip { font-size: 22rpx; color: var(--ink-3); margin-top: 24rpx; line-height: 1.6; }

/* ---------- 底部操作栏（同 admin-settings / admin-product-edit 模式）---------- */
.bottom-bar {
  flex: 0 0 auto; display: flex; gap: 20rpx;
  padding: 20rpx 32rpx; border-top: 1rpx solid var(--line); background: var(--bg);
}
.bar-cancel { flex: 0 0 200rpx; }
.bar-save { flex: 1; }
