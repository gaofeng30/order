<view class="page">
  <navbar tone="dark" overlay back title="订单详情" />

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="hero-dark detail-hero" style="padding-top:{{navTotal}}px">
      <view class="ring r1"></view>
      <view class="dh-row">
        <view>
          <view class="dh-lbl">取餐号</view>
          <view class="serif dh-code">{{o.code}}</view>
        </view>
        <view class="dh-pill"><pill s="{{o.status}}" ondark /></view>
      </view>
      <view class="dh-no">订单号 {{o.no}} · {{paidTime}} 下单</view>
    </view>

    <view class="pad">
      <!-- 口味高亮 -->
      <view wx:if="{{flavorShow}}" class="flavor-card">
        <icon name="flame" size="20" color="#a4873f" />
        <view>
          <view class="flavor-lbl">口味要求 · 制作请注意</view>
          <view class="serif flavor-val">{{flavorText}}</view>
        </view>
      </view>

      <view class="card sec-card">
        <view class="sec-h" style="padding-bottom:4rpx"><text class="t" style="font-size:30rpx">菜品明细</text></view>
        <view wx:for="{{rows}}" wx:key="name" class="order-item">
          <view class="order-item-info">
            <view class="order-item-name">{{item.name}}</view>
            <view class="order-item-unit"><money cents="{{item.p}}" size="24" /> × {{item.q}}</view>
          </view>
          <money cents="{{item.sub}}" size="30" />
        </view>
        <view class="pay-row"><text class="pay-lbl">实付</text><money cents="{{o.total}}" blue size="42" /></view>
      </view>

      <view class="card sec-card">
        <view class="sec-h" style="padding-bottom:4rpx"><text class="t" style="font-size:30rpx">用户与履约</text></view>
        <view class="info-row"><text class="ir-label">联系人</text><text class="ir-val">{{o.contactName}}</text></view>
        <view class="info-row"><text class="ir-label">手机号</text><text class="ir-val">{{o.maskedPhone}}</text></view>
        <view wx:if="{{o.orderNote}}" class="info-row"><text class="ir-label">备注</text><text class="ir-val">{{o.orderNote}}</text></view>
        <view class="info-row last"><text class="ir-label">取餐地点</text><text class="ir-val">{{o.pickupPoint}}</text></view>
      </view>
      <view style="height:24rpx"></view>
    </view>
  </scroll-view>

  <view class="bottom-bar" style="padding-bottom:{{safeBottom + 20}}px">
    <view class="btn btn--ghost-blue btn--sm foot-icon" bindtap="print"><icon name="printer" size="17" color="#0b2f63" />打印</view>
    <view class="btn btn--ghost-blue btn--sm foot-icon" bindtap="call"><icon name="phone" size="16" color="#0b2f63" /></view>
    <view wx:if="{{meta.isView}}" class="btn btn--mute foot-main">{{o.status}}</view>
    <view wx:else class="btn btn--primary foot-main" bindtap="advance">{{meta.label}}</view>
  </view>

  <toast id="toast" />
</view>
