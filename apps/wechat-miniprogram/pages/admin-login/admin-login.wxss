.login-card { margin: 32rpx 0; padding: 40rpx 32rpx; }
.login-icon {
  width: 104rpx; height: 104rpx; margin: 0 auto; border-radius: 32rpx;
  background: var(--green-bg); display: flex; align-items: center; justify-content: center;
}
.login-title { margin: 28rpx 0 20rpx; font-size: 38rpx; font-weight: 700; text-align: center; color: var(--ink); }
.login-tip { margin-bottom: 28rpx; font-size: 27rpx; line-height: 1.7; color: var(--ink-2); }
.login-message {
  margin-bottom: 28rpx; padding: 20rpx 24rpx; border-radius: 20rpx;
  background: var(--bg); color: var(--ink-2); font-size: 26rpx; line-height: 1.7;
}
.login-message.success { color: var(--green); background: var(--green-bg); }
.secondary { margin-top: 24rpx; }
