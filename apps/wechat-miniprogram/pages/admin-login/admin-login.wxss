.login-card { margin: 32rpx 0; padding: 48rpx 40rpx; text-align: center; }
.login-icon {
  width: 104rpx; height: 104rpx; margin: 0 auto; border-radius: 32rpx;
  background: var(--green-bg); display: flex; align-items: center; justify-content: center;
}
.login-title { margin: 28rpx 0 20rpx; font-size: var(--fs-xl); font-weight: 700; color: var(--ink); }
.login-tip { margin-bottom: 28rpx; font-size: var(--fs-sm); line-height: 1.7; color: var(--ink-2); text-align: center; }
.login-message {
  margin-bottom: 28rpx; padding: 20rpx 24rpx; border-radius: 20rpx; text-align: center;
  background: var(--bg); color: var(--ink-2); font-size: var(--fs-sm); line-height: 1.7;
}
.login-message.success { color: var(--green); background: var(--green-bg); }

/* 按钮固定宽 440rpx 居中（A25） */
.login-actions { display: flex; flex-direction: column; align-items: center; gap: 24rpx; }
button.btn.login-btn:not([size=mini]) { width: 440rpx; }
