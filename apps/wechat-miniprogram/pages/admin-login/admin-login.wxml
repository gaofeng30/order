<view class="page">
  <navbar tone="light" title="登录电脑后台" back />
  <scroll-view class="scroll pad" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="card login-card">
      <view class="login-icon"><icon name="store" size="32" color="#3d6b2f" /></view>
      <view class="login-title serif">确认电脑登录</view>
      <view class="login-tip">在电脑打开管理台，用这里的扫码按钮扫描登录二维码。登录码有效期为两分钟。</view>
      <view wx:if="{{message}}" class="login-message {{stage === 'approved' ? 'success' : ''}}">{{message}}</view>
      <view wx:if="{{ownerState === 'loading'}}" class="login-tip">正在加载主账号身份…</view>
      <button wx:if="{{ownerState === 'error'}}" class="btn btn--primary btn--block" disabled="{{busy}}" bindtap="loadOwner">重新加载身份</button>
      <block wx:if="{{ownerState === 'ready'}}">
        <button wx:if="{{stage !== 'confirm' && stage !== 'approved'}}" class="btn btn--primary btn--block" disabled="{{busy}}" loading="{{busy}}" bindtap="scan">扫描电脑登录码</button>
        <button wx:if="{{stage === 'confirm'}}" class="btn btn--primary btn--block" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" disabled="{{busy}}" loading="{{busy}}">确认登录电脑后台</button>
        <button wx:if="{{stage === 'confirm' || stage === 'approved'}}" class="btn btn--ghost btn--block secondary" disabled="{{busy}}" bindtap="scan">重新扫描登录码</button>
      </block>
      <button class="btn btn--ghost btn--block secondary" disabled="{{busy}}" bindtap="back">返回小程序</button>
    </view>
  </scroll-view>
</view>
